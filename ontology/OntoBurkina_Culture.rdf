    <rdf:Description>
        <rdfs:comment xml:lang="fr">Ethnie(?e) ^ aPourLangueMaternelle(?e, ?l) -&gt; parle(?e, ?l)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
