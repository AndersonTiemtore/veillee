    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">Localite(?l) ^ estSitueeDans(?l, ?p) ^ Province(?p) ^ estSitueeDans(?p, ?r) ^ Region(?r) -&gt; estDansRegion(?l, ?r)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <swrl:head rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">Plat(?p) ^ aPourIngredient(?p, ?i) ^ Viande(?i) -&gt; PlatAvecViande(?p)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <swrl:head rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">Plat(?p) ^ aPourRecette(?p, ?r) ^ Recette(?r) ^ dureeRecette(?r, ?d) ^ swrlb:greaterThan(?d, 120) -&gt; PlatElabore(?p)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        <swrl:head rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">Plat(?p) ^ estAssocieA(?p, ?e) ^ Ethnie(?e) ^ habite(?e, ?l) ^ Localite(?l) -&gt; estOriginaireDe(?p, ?l)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
