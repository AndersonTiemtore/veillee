        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Occasion"/>
        <rdfs:comment xml:lang="fr">Occasions ou un plat est traditionnellement consomme.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Occasions ou un plat est traditionnellement consomme. Cardinalite : 0..*. Portee egalement par BoissonTraditionnelle, afin qu&apos;une boisson traditionnelle puisse etre documentee independamment d&apos;un plat particulier.</rdfs:comment>
        <rdfs:label xml:lang="fr">consommeLorsDe</rdfs:label>
    </owl:ObjectProperty>
    


