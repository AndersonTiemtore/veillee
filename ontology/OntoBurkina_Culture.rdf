    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">Langue(?l) ^ estParleePar(?l, ?e) ^ habite(?e, ?t) -&gt; estParleeDans(?l, ?t)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
