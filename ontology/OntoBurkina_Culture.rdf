    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_pilonnage_du_fufu -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_pilonnage_du_fufu">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Manioc cuit pilonné énergiquement au mortier 15 à 20 minutes en tournant la masse de manière circulaire jusqu&apos;à obtenir une pâte lisse, élastique et brillante</descriptionTechnique>
        <nomTechnique xml:lang="fr">Pilonnage du fufu</nomTechnique>
        <rdfs:label xml:lang="fr">Pilonnage du fufu</rdfs:label>
    </owl:NamedIndividual>
    


