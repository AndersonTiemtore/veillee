<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ibam-ujkz.bf/ontologies/culture#"
     xml:base="http://www.ibam-ujkz.bf/ontologies/culture"
     xmlns:bf="http://www.ibam-ujkz.bf/ontologies/culture#"
     xmlns:geo="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#">
        <rdfs:comment xml:lang="fr">Sous-ensemble de l&apos;ontologie unifiee OntoBurkina restreint au lot Culture : Cuisines du Burkina Faso, Langues et ethnies du Burkina Faso, Instruments de musique traditionnels, Tourisme du Burkina Faso. Les quatre themes partagent les classes pivots Localite et Ethnie/Langue.</rdfs:comment>
        <rdfs:label xml:lang="fr">OntoBurkina — Culture (Cuisines, Langues et ethnies, Instruments de musique, Tourisme)</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://www.w3.org/2003/11/swrl#argument1 -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#argument1"/>
    


    <!-- http://www.w3.org/2003/11/swrl#argument2 -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#argument2"/>
    


    <!-- http://www.w3.org/2003/11/swrl#arguments -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#arguments"/>
    


    <!-- http://www.w3.org/2003/11/swrl#body -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#body"/>
    


    <!-- http://www.w3.org/2003/11/swrl#builtin -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#builtin"/>
    


    <!-- http://www.w3.org/2003/11/swrl#classPredicate -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#classPredicate"/>
    


    <!-- http://www.w3.org/2003/11/swrl#head -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#head"/>
    


    <!-- http://www.w3.org/2003/11/swrl#propertyPredicate -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/11/swrl#propertyPredicate"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourCuisine -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourCuisine">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estCuisineDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Cuisine"/>
        <rdfs:comment xml:lang="fr">Relie une ethnie a sa tradition culinaire.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourCuisine</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourIngredient -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourIngredient">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estIngredientDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Ingredients utilises pour la preparation d&apos;un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourIngredient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourIngredientLocal -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourIngredientLocal">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Ingredient(s) du plat qui sont cultives dans la localite d&apos;origine du plat (propriete deduite par regle SWRL).</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourIngredientLocal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourInstrumentAssocie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourInstrumentAssocie">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estAssocieARegion"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Region"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Instrument"/>
        <rdfs:comment xml:lang="fr">Instrument(s) associe(s) a cette region.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourInstrumentAssocie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourLangueMaternelle -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourLangueMaternelle">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estLangueMaternelleDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Langue"/>
        <rdfs:comment xml:lang="fr">Langue(s) maternelle(s) d&apos;une ethnie.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourLangueMaternelle</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourLocaliteDansRegion -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourLocaliteDansRegion">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estDansRegion"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Region"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:comment xml:lang="fr">Localite(s) rattachee(s) a cette region par propagation depuis leur province (regle SWRL R-N3).</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourLocaliteDansRegion</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourMatiereDeBase -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourMatiereDeBase">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estMatiereDeBaseDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#MatiereDeBase"/>
        <rdfs:comment xml:lang="fr">Ingredient principal d&apos;un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourMatiereDeBase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourMedia -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourMedia">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estMediaDe"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Instrument"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#MatiereDeBase"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Sauce"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Ustensile"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Media"/>
        <rdfs:comment xml:lang="fr">Photos ou videos illustrant un element.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourMedia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourParentePlaisanterie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourParentePlaisanterie">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#aPourParentePlaisanterie"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:comment xml:lang="fr">Parente a plaisanterie entre deux ethnies (ex. Mosse-Bissa).</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourParentePlaisanterie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourPeriodeFavorable -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourPeriodeFavorable">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estPeriodeFavorableDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Periode"/>
        <rdfs:comment xml:lang="fr">Periode recommandee pour visiter.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourPeriodeFavorable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourPlatOriginaire -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourPlatOriginaire">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estOriginaireDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Plat(s) originaire(s) de cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourPlatOriginaire</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourPlatTraditionnel -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourPlatTraditionnel">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estAssocieA"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="fr">Plat(s) traditionnel(s) de cette ethnie.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourPlatTraditionnel</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourRecette -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourRecette">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estRecetteDe"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <rdfs:comment xml:lang="fr">Recette de preparation d&apos;un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourRecette</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourSauce -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourSauce">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#accompagnePlat"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Sauce"/>
        <rdfs:comment xml:lang="fr">Sauce(s) qui accompagnent un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourSauce</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourSousGroupe -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourSousGroupe">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#appartientAEthnie"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SousGroupeEthnique"/>
        <rdfs:comment xml:lang="fr">Sous-groupes d&apos;une ethnie.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourSousGroupe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourStatut -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourStatut">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#statutDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Langue"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#StatutLinguistique"/>
        <rdfs:comment xml:lang="fr">Statut(s) reconnus a une langue.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourStatut</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourTotem -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourTotem">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#totemDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Patronyme"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Totem"/>
        <rdfs:comment xml:lang="fr">Totem ou interdit associe a un patronyme.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourTotem</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourUniteFille -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourUniteFille">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#aPourUniteParente"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:comment xml:lang="fr">Unite(s) fille(s) directe(s).</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourUniteFille</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourUniteParente -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourUniteParente">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:comment xml:lang="fr">Lien d&apos;une unite vers son unite parente.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourUniteParente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#aPourVariete -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#aPourVariete">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estVarieteDe"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Langue"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#VarieteDialectale"/>
        <rdfs:comment xml:lang="fr">Varietes regionales d&apos;une langue.</rdfs:comment>
        <rdfs:label xml:lang="fr">aPourVariete</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#abriteEthnie -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#abriteEthnie">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#habite"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#AireGeographique"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:comment xml:lang="fr">Ethnies principalement presentes dans cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">abriteEthnie</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#accompagne -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#accompagne">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estAccompagneParBoisson"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Boisson traditionnelle accompagnant des plats.</rdfs:comment>
        <rdfs:label xml:lang="fr">accompagne</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#accompagnePlat -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#accompagnePlat">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Sauce"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Plat(s) accompagne(s) par cette sauce.</rdfs:comment>
        <rdfs:label xml:lang="fr">accompagnePlat</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#accueilleLangue -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#accueilleLangue">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estParleeDans"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#AireGeographique"/>
                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Langue"/>
        <rdfs:comment xml:lang="fr">Langue(s) en usage sur ce territoire.</rdfs:comment>
        <rdfs:label xml:lang="fr">accueilleLangue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#accueilleSite -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#accueilleSite">
        <owl:inverseOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#estSitueDans"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique"/>
        <rdfs:comment xml:lang="fr">Site(s) touristique(s) situe(s) dans cette localite.</rdfs:comment>
        <rdfs:label xml:lang="fr">accueilleSite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#activiteDisponible -->

    <owl:ObjectProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#activiteDisponible">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
