        <utiliseLorsDe rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#occ_ceremonies_de_chasseurs_donso"/>
        <descriptionInstrument xml:lang="fr">Luth traditionnel à cordes pincées, au corps en bois ou en calebasse recouvert d&apos;une peau tendue ; joué par les griots (&quot;djéli n&apos;goni&quot;) lors des célébrations, la légende attribue son invention à un chasseur sénoufo.</descriptionInstrument>
        <materiauxFabrication xml:lang="fr">Bois, calebasse, peau de chèvre ou de vache, cordes (traditionnellement en fibres végétales, aujourd&apos;hui souvent nylon ou métal)</materiauxFabrication>
        <nomInstrument xml:lang="fr">N&apos;goni</nomInstrument>
        <techniqueDeJeu xml:lang="fr">Cordes pincées avec les doigts</techniqueDeJeu>
        <dcterms:source>Wikipédia, La Maison du Ngoni</dcterms:source>
        <rdfs:label xml:lang="fr">N&apos;goni</rdfs:label>
        <skos:altLabel xml:lang="fr">Koni</skos:altLabel>
        <skos:altLabel xml:lang="fr">N&apos;goni</skos:altLabel>
        <skos:altLabel xml:lang="fr">Nkoni</skos:altLabel>
    </owl:NamedIndividual>
    


