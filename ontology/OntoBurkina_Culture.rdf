    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_de_la_farine_de_mil_a_la_poele_seche -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_de_la_farine_de_mil_a_la_poele_seche">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Torréfaction de la farine de mil à la poêle sèche</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_du_cumin -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_du_cumin">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
