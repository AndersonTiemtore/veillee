        <descriptionTechnique xml:lang="fr">Piler collectivement des arachides ou céréales dans de grands mortiers en chantant, technique rituelle des cérémonies d&apos;initiation.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Pilonnage collectif au mortier</nomTechnique>
        <rdfs:label xml:lang="fr">Pilonnage collectif au mortier</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_pilonnage_de_l_igname_au_mortier -->

