    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_farce_par_incisions_gigot_farci -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_farce_par_incisions_gigot_farci">
