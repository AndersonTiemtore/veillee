        <rdfs:label xml:lang="fr">Fermentation courte de la semoule (6h)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_de_la_pate_6_a_10_heures -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_de_la_pate_6_a_10_heures">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Fermentation de la pâte 6 à 10 heures</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_de_pate -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_de_pate">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Laisser reposer une pâte (farine de maïs, mil) pendant plusieurs heures ou jours pour qu&apos;elle fermente avant cuisson</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation de pâte</nomTechnique>
        <rdfs:label xml:lang="fr">Fermentation de pâte</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_de_pate_cerealiere -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_de_pate_cerealiere">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Pâte de mil ou sorgho laissée fermenter plusieurs heures à température ambiante pour développer de l&apos;acidité, utilisée pour zom-koom, ben-saalga, dôlo.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation de pâte céréalière</nomTechnique>
        <rdfs:label xml:lang="fr">Fermentation de pâte céréalière</rdfs:label>
    </owl:NamedIndividual>
    


