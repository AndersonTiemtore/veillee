        <rdfs:label xml:lang="fr">tamisage pour granulation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_d_extraction_du_lait_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_d_extraction_du_lait_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Ouvrir, râper puis presser la chair de noix de coco fraîche avec de l&apos;eau chaude pour extraire la crème puis le lait de coco.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique d&apos;Extraction du Lait de Coco</nomTechnique>
        <rdfs:label xml:lang="fr">Technique d&apos;Extraction du Lait de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_de_cuisson_du_riz_parfait -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_de_cuisson_du_riz_parfait">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Laver le riz, respecter le ratio eau-riz, cuire à couvert sans jamais soulever le couvercle puis laisser reposer 10 minutes.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique de Cuisson du Riz Parfait</nomTechnique>
        <rdfs:label xml:lang="fr">Technique de Cuisson du Riz Parfait</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_de_fumage_des_viandes_et_poissons -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_de_fumage_des_viandes_et_poissons">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Fumer viandes et poissons salés sur un feu de bois dur avec des feuilles vertes pour créer une fumée aromatique et conserver les aliments sans réfrigération.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique de Fumage des Viandes et Poissons</nomTechnique>
        <rdfs:label xml:lang="fr">Technique de Fumage des Viandes et Poissons</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_de_la_friture_parfaite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_de_la_friture_parfaite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Maîtriser la température de l&apos;huile sans thermomètre (test de farine, de bois, de pâte) pour une friture ni grasse ni brûlée.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique de la Friture Parfaite</nomTechnique>
        <rdfs:label xml:lang="fr">Technique de la Friture Parfaite</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_du_braisage_des_viandes_et_legumes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_du_braisage_des_viandes_et_legumes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Saisir à feu vif puis cuire longuement à couvert à feu doux dans un liquide aromatique pour attendrir les viandes dures.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique du Braisage des Viandes et Légumes</nomTechnique>
        <rdfs:label xml:lang="fr">Technique du Braisage des Viandes et Légumes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_du_pilonnage_au_mortier -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_du_pilonnage_au_mortier">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Piler céréales, arachides et aromates au mortier et pilon en bois dur ou granit ; geste fondamental et quotidien de la cuisine burkinabée.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique du Pilonnage au Mortier</nomTechnique>
        <rdfs:label xml:lang="fr">Technique du Pilonnage au Mortier</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_du_to_parfait_pate_de_cereale -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_du_to_parfait_pate_de_cereale">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Délayer la farine de mil ou de maïs dans l&apos;eau puis cuire en remuant sans arrêt pour obtenir une pâte lisse, homogène et sans grumeaux.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Technique du Tô Parfait (Pâte de Céréale)</nomTechnique>
        <rdfs:label xml:lang="fr">Technique du Tô Parfait (Pâte de Céréale)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_risotto_nacrage_ajout_progressif_du_bouillon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_technique_risotto_nacrage_ajout_progressif_du_bouillon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">technique risotto (nacrage, ajout progressif du bouillon)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_techniques_de_presentation_et_service_traditionnel -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_techniques_de_presentation_et_service_traditionnel">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Codes sociaux du service burkinabé : plat commun posé sur natte ou table basse, ordre de service (aînés et invités en premier), consommation à la main droite uniquement, hospitalité envers l&apos;invité surprise.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Techniques de Présentation et Service Traditionnel</nomTechnique>
        <rdfs:label xml:lang="fr">Techniques de Présentation et Service Traditionnel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_temperage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_temperage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">tempérage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_test_de_purete_de_la_farine_papier_noir -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_test_de_purete_de_la_farine_papier_noir">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Vérification de la blancheur de la farine de mil en déposant une pincée sur du papier noir pour juger sa pureté avant un usage cérémoniel (tô blanc Mossi)</descriptionTechnique>
        <nomTechnique xml:lang="fr">Test de pureté de la farine (papier noir)</nomTechnique>
        <rdfs:label xml:lang="fr">Test de pureté de la farine (papier noir)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Grillage à sec des grains (mil, arachides, sésame) pour développer la saveur et faciliter le broyage</descriptionTechnique>
        <nomTechnique xml:lang="fr">Torréfaction</nomTechnique>
        <rdfs:label xml:lang="fr">Torréfaction</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_a_sec -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_a_sec">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Grillage de graines (sésame, arachide) ou de farine dans une poêle sèche sans matière grasse pour développer les arômes.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Torréfaction à sec</nomTechnique>
        <rdfs:label xml:lang="fr">Torréfaction à sec</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_arachides">
