        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment xml:lang="fr">Duree moyenne de preparation (minutes).</rdfs:comment>
        <rdfs:label xml:lang="fr">tempsPreparationPlat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#textureSauce -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#textureSauce">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Sauce"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="fr">Consistance : liquide, epaisse, visqueuse.</rdfs:comment>
        <rdfs:label xml:lang="fr">textureSauce</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#typeActeur -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#typeActeur">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#ActeurTourisme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Nature de l&apos;acteur (guide independant, office de tourisme, agence, association).</rdfs:comment>
        <rdfs:label xml:lang="fr">typeActeur</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#typeBoisson -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#typeBoisson">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle"/>
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <rdfs:comment xml:lang="fr">Type : fermentee, non fermentee, chaude, froide.</rdfs:comment>
        <rdfs:label xml:lang="fr">typeBoisson</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#typeEvenementOccasion -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#typeEvenementOccasion">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Occasion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Categorie : familiale, religieuse, culturelle, royale ou quotidienne.</rdfs:comment>
        <rdfs:label xml:lang="fr">typeEvenementOccasion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#typeFaune -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#typeFaune">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#ReserveDeFaune"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Description sommaire de la faune caracteristique de la reserve.</rdfs:comment>
        <rdfs:label xml:lang="fr">typeFaune</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#typeInfrastructure -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#typeInfrastructure">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Infrastructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Categorie de l&apos;infrastructure (hebergement, restauration, transport, agence).</rdfs:comment>
        <rdfs:label xml:lang="fr">typeInfrastructure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#typeReligion -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#typeReligion">
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteReligieux"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Culte ou tradition religieuse associee au site.</rdfs:comment>
        <rdfs:label xml:lang="fr">typeReligion</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#urlMedia -->

    <owl:DatatypeProperty rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#urlMedia">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Media"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="fr">Adresse (URL) du fichier photo ou video.</rdfs:comment>
        <rdfs:label xml:lang="fr">urlMedia</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ActeurTourisme -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ActeurTourisme">
        <rdfs:comment xml:lang="fr">Professionnel du secteur (guide, office de tourisme).</rdfs:comment>
        <rdfs:label xml:lang="fr">ActeurTourisme</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Activite -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Activite">
        <rdfs:comment xml:lang="fr">Activite pouvant etre pratiquee sur un site.</rdfs:comment>
        <rdfs:label xml:lang="fr">Activite</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ActiviteCulturelle -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ActiviteCulturelle">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Activite"/>
        <rdfs:comment xml:lang="fr">Visite guidee, festival, ceremonie coutumiere.</rdfs:comment>
        <rdfs:label xml:lang="fr">ActiviteCulturelle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ActiviteNature -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ActiviteNature">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Activite"/>
        <rdfs:comment xml:lang="fr">Safari, randonnee, baignade, observation de la faune.</rdfs:comment>
        <rdfs:label xml:lang="fr">ActiviteNature</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#AireGeographique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#AireGeographique">
        <rdfs:comment xml:lang="fr">Emprise geographique reelle d&apos;une communaute, d&apos;une langue ou d&apos;un phenomene, distincte des limites administratives. Synonyme : Zone d&apos;implantation.</rdfs:comment>
        <rdfs:label xml:lang="fr">AireGeographique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#BoissonTraditionnelle">
        <rdfs:comment xml:lang="fr">Boisson preparee selon les traditions culinaires burkinabe (dolo, zoom-koom, bissap).</rdfs:comment>
        <rdfs:label xml:lang="fr">BoissonTraditionnelle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Cereale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Cereale">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Aliment cultive servant de base a de nombreux plats (mil, mais, sorgho, riz).</rdfs:comment>
        <rdfs:label xml:lang="fr">Cereale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Commune -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Commune">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:comment xml:lang="fr">Collectivite territoriale rattachee a une province ; urbaine ou rurale. Synonymes : Circonscription territoriale, Municipalite.</rdfs:comment>
        <rdfs:label xml:lang="fr">Commune</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#CommuneRurale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#CommuneRurale">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Commune"/>
        <rdfs:comment xml:lang="fr">Regroupe des villages. Synonyme : Municipalite rurale.</rdfs:comment>
        <rdfs:label xml:lang="fr">CommuneRurale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#CommuneUrbaine -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#CommuneUrbaine">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Commune"/>
        <rdfs:comment xml:lang="fr">Agglomeration d&apos;au moins 10 000 habitants (par exemple Ouagadougou, Bobo-Dioulasso). Synonyme : Municipalite urbaine.</rdfs:comment>
        <rdfs:label xml:lang="fr">CommuneUrbaine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Cuisine -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Cuisine">
        <rdfs:comment xml:lang="fr">Tradition culinaire propre a une ethnie, regroupant les plats, boissons et techniques qui la caracterisent (ex. cuisine mossi, cuisine bissa).</rdfs:comment>
        <rdfs:label xml:lang="fr">Cuisine</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Epice -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Epice">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Produit utilise pour relever le gout d&apos;un plat (soumbala, piment).</rdfs:comment>
        <rdfs:label xml:lang="fr">Epice</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Ethnie -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie">
        <rdfs:comment xml:lang="fr">Groupe de personnes qui partagent une culture, une langue et des traditions (culinaires, musicales...). Synonymes : Groupe ethnique, Peuple, Communaute.</rdfs:comment>
        <rdfs:label xml:lang="fr">Ethnie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#FamilleInstrumentale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#FamilleInstrumentale">
        <rdfs:comment xml:lang="fr">Categorie d&apos;instrument selon la maniere dont le son est produit : idiophone, membranophone, cordophone ou aerophone.</rdfs:comment>
        <rdfs:label xml:lang="fr">FamilleInstrumentale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#FamilleLinguistique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#FamilleLinguistique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:comment xml:lang="fr">Rang racine (ex. Niger-Congo).</rdfs:comment>
        <rdfs:label xml:lang="fr">FamilleLinguistique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#GroupeLinguistique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#GroupeLinguistique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:comment xml:lang="fr">Rang sous la famille (ex. Gur, Mande).</rdfs:comment>
        <rdfs:label xml:lang="fr">GroupeLinguistique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Infrastructure -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Infrastructure">
        <rdfs:comment xml:lang="fr">Hebergement, restauration, transport, agence.</rdfs:comment>
        <rdfs:label xml:lang="fr">Infrastructure</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Ingredient -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient">
        <rdfs:comment xml:lang="fr">Element utilise dans la preparation d&apos;un plat ou d&apos;une boisson.</rdfs:comment>
        <rdfs:label xml:lang="fr">Ingredient</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Instrument -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Instrument">
        <rdfs:comment xml:lang="fr">Objet utilise pour produire des sons musicaux (balafon, djembe, bendre) ; concept central de ce theme.</rdfs:comment>
        <rdfs:label xml:lang="fr">Instrument</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Langue -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Langue">
        <rdfs:comment xml:lang="fr">Langue parlee au Burkina Faso, terminale dans l&apos;arbre de classification linguistique.</rdfs:comment>
        <rdfs:label xml:lang="fr">Langue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#LangueNationale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#LangueNationale">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Langue"/>
        <rdfs:comment xml:lang="fr">Langue reconnue comme langue nationale (inclut les langues officielles).</rdfs:comment>
        <rdfs:label xml:lang="fr">LangueNationale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#LangueOfficielle -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#LangueOfficielle">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Langue"/>
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#LangueNationale"/>
        <rdfs:comment xml:lang="fr">Langue ayant le statut officiel (francais, moore, dioula, fulfulde).</rdfs:comment>
        <rdfs:label xml:lang="fr">LangueOfficielle</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Legume -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Legume">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Produit vegetal utilise dans les plats ou les sauces.</rdfs:comment>
        <rdfs:label xml:lang="fr">Legume</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Localite -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Localite">
        <rdfs:comment xml:lang="fr">Classe racine de toute subdivision du territoire, avec ses caracteristiques communes (nom, code, superficie, coordonnees). Lieu ou un plat, un instrument, une langue ou un site touristique est situe, prepare, parle ou joue.</rdfs:comment>
        <rdfs:label xml:lang="fr">Localite</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#MatiereDeBase -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#MatiereDeBase">
        <rdfs:comment xml:lang="fr">Ingredient principal utilise pour preparer un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">MatiereDeBase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Media -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Media">
        <rdfs:comment xml:lang="fr">Representation visuelle ou audiovisuelle illustrant un element de l&apos;ontologie.</rdfs:comment>
        <rdfs:label xml:lang="fr">Media</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Musee -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Musee">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueCulturel"/>
        <rdfs:comment xml:lang="fr">Musees et espaces d&apos;exposition.</rdfs:comment>
        <rdfs:label xml:lang="fr">Musee</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Occasion -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Occasion">
        <rdfs:comment xml:lang="fr">Moment ou circonstance ou l&apos;on consomme un plat ou l&apos;on joue un instrument (mariage, funerailles, ceremonie, fete, vie quotidienne).</rdfs:comment>
        <rdfs:label xml:lang="fr">Occasion</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ParcNational -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ParcNational">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueNaturel"/>
        <rdfs:comment xml:lang="fr">Parcs nationaux classes (Arly, W).</rdfs:comment>
        <rdfs:label xml:lang="fr">ParcNational</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Patronyme -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Patronyme">
        <rdfs:comment xml:lang="fr">Nom de famille rattache a une ou plusieurs communautes (ex. Ouedraogo, Thiombiano, Some, Diallo).</rdfs:comment>
        <rdfs:label xml:lang="fr">Patronyme</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Pays -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Pays">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:comment xml:lang="fr">Plus haut niveau de la hierarchie territoriale ; une unique instance pour ce projet (le Burkina Faso). Synonymes : Etat, Nation.</rdfs:comment>
        <rdfs:label xml:lang="fr">Pays</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Periode -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Periode">
        <rdfs:comment xml:lang="fr">Intervalle temporel.</rdfs:comment>
        <rdfs:label xml:lang="fr">Periode</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Photo -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Photo">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Media"/>
        <rdfs:comment xml:lang="fr">Image fixe.</rdfs:comment>
        <rdfs:label xml:lang="fr">Photo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Plat -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Plat">
        <rdfs:comment xml:lang="fr">Preparation culinaire realisee a partir d&apos;un ou de plusieurs ingredients et destinee a etre consommee. Synonymes : Mets, Repas, Riibo (moore).</rdfs:comment>
        <rdfs:label xml:lang="fr">Plat</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#PlatAvecViande -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#PlatAvecViande">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Plat contenant au moins un ingredient de la sous-classe Viande.</rdfs:comment>
        <rdfs:label xml:lang="fr">PlatAvecViande</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#PlatDeBase -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#PlatDeBase">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Plat consomme regulierement dans les familles burkinabe.</rdfs:comment>
        <rdfs:label xml:lang="fr">PlatDeBase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#PlatDeFete -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#PlatDeFete">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Plat prepare lors des fetes, ceremonies ou evenements importants.</rdfs:comment>
        <rdfs:label xml:lang="fr">PlatDeFete</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#PlatElabore -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#PlatElabore">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Plat dont la recette demande une preparation longue (&gt; 120 min).</rdfs:comment>
        <rdfs:label xml:lang="fr">PlatElabore</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#PlatRapide -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#PlatRapide">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
        <rdfs:comment xml:lang="fr">Plat dont le temps de preparation est court (&lt;= 30 min).</rdfs:comment>
        <rdfs:label xml:lang="fr">PlatRapide</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Poisson -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Poisson">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Chair de poisson (fraiche, sechee ou fumee) utilisee dans la preparation d&apos;un plat ou d&apos;une sauce.</rdfs:comment>
        <rdfs:label xml:lang="fr">Poisson</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ProduitLaitier -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ProduitLaitier">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Aliment issu du lait (lait frais, lait fermente, yaourt) ou du beurre de karite utilise en cuisine.</rdfs:comment>
        <rdfs:label xml:lang="fr">ProduitLaitier</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Province -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Province">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:comment xml:lang="fr">Echelon intermediaire (47 provinces) ; appartient a une region. Synonyme : Circonscription provinciale.</rdfs:comment>
        <rdfs:label xml:lang="fr">Province</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Recette -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Recette">
        <rdfs:comment xml:lang="fr">Ensemble des ingredients et des etapes necessaires pour realiser un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">Recette</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Region -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Region">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:comment xml:lang="fr">Subdivision administrative directement rattachee au Pays. Le Burkina Faso compte 17 regions. Synonyme : Circonscription regionale.</rdfs:comment>
        <rdfs:label xml:lang="fr">Region</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ReserveDeFaune -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ReserveDeFaune">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueNaturel"/>
        <rdfs:comment xml:lang="fr">Reserves fauniques (Nazinga).</rdfs:comment>
        <rdfs:label xml:lang="fr">ReserveDeFaune</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Rythme -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Rythme">
        <rdfs:comment xml:lang="fr">Motif rythmique associe a la pratique d&apos;un instrument et a une occasion sociale (warba, djongo, kondogo).</rdfs:comment>
        <rdfs:label xml:lang="fr">Rythme</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Saison -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Saison">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Periode"/>
        <rdfs:comment xml:lang="fr">Saison touristique (seche, pluvieuse).</rdfs:comment>
        <rdfs:label xml:lang="fr">Saison</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Sauce -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Sauce">
        <rdfs:comment xml:lang="fr">Preparation qui accompagne un plat de base comme le to ou le riz (Ziindo en moore).</rdfs:comment>
        <rdfs:label xml:lang="fr">Sauce</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteArtisanal -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteArtisanal">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueCulturel"/>
        <rdfs:comment xml:lang="fr">Marches artisanaux, villages traditionnels.</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteArtisanal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteHistorique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteHistorique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueCulturel"/>
        <rdfs:comment xml:lang="fr">Ruines, mausolees, sites archeologiques.</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteHistorique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteNaturelRemarquable -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteNaturelRemarquable">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueNaturel"/>
        <rdfs:comment xml:lang="fr">Cascades, pics, domes, lacs, mares sacrees.</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteNaturelRemarquable</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteReligieux -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteReligieux">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueCulturel"/>
        <rdfs:comment xml:lang="fr">Sites de culte et ceremonies.</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteReligieux</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique">
        <rdfs:comment xml:lang="fr">Concept general regroupant tout site touristique recense.</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteTouristique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueCulturel -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueCulturel">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique"/>
        <rdfs:comment xml:lang="fr">Sites culturels, historiques, religieux, musees.</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteTouristiqueCulturel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueNaturel -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristiqueNaturel">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#SiteTouristique"/>
        <rdfs:comment xml:lang="fr">Sites naturels (parcs, reserves, cascades, lacs, pics).</rdfs:comment>
        <rdfs:label xml:lang="fr">SiteTouristiqueNaturel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Source -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Source">
        <rdfs:comment xml:lang="fr">Origine documentaire ou humaine d&apos;une information (tracabilite obligatoire de toute donnee). Synonyme : Provenance.</rdfs:comment>
        <rdfs:label xml:lang="fr">Source</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SousGroupeEthnique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SousGroupeEthnique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ethnie"/>
        <rdfs:comment xml:lang="fr">Sous-groupe eventuel d&apos;une ethnie. Synonyme : Fraction.</rdfs:comment>
        <rdfs:label xml:lang="fr">SousGroupeEthnique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SousGroupeLinguistique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SousGroupeLinguistique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:comment xml:lang="fr">Rang plus fin que le groupe (ex. Oti-Volta).</rdfs:comment>
        <rdfs:label xml:lang="fr">SousGroupeLinguistique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#SousSousGroupeLinguistique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#SousSousGroupeLinguistique">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification"/>
        <rdfs:comment xml:lang="fr">Quatrieme rang, le plus fin.</rdfs:comment>
        <rdfs:label xml:lang="fr">SousSousGroupeLinguistique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#StatutLinguistique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#StatutLinguistique">
        <rdfs:comment xml:lang="fr">Valeur de statut reconnue a une langue par les textes en vigueur.</rdfs:comment>
        <rdfs:label xml:lang="fr">StatutLinguistique</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire">
        <rdfs:comment xml:lang="fr">Ensemble des techniques utilisees pour preparer ou cuire un plat.</rdfs:comment>
        <rdfs:label xml:lang="fr">TechniqueCulinaire</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Totem -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Totem">
        <rdfs:comment xml:lang="fr">Objet, animal ou interdit alimentaire traditionnellement associe a un patronyme.</rdfs:comment>
        <rdfs:label xml:lang="fr">Totem</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Tubercule -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Tubercule">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Aliment dont la partie consommee pousse sous terre (manioc, igname).</rdfs:comment>
        <rdfs:label xml:lang="fr">Tubercule</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#UniteClassification">
        <rdfs:comment xml:lang="fr">Maillon generique de la classification genetique des langues ; chapeaute les quatre rangs nommes.</rdfs:comment>
        <rdfs:label xml:lang="fr">UniteClassification</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Ustensile -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Ustensile">
        <rdfs:comment xml:lang="fr">Objet utilise pour preparer, cuire, servir ou conserver les aliments (canari, mortier, calebasse).</rdfs:comment>
        <rdfs:label xml:lang="fr">Ustensile</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#VarieteDialectale -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#VarieteDialectale">
        <rdfs:comment xml:lang="fr">Forme regionale d&apos;une langue. Synonyme : Dialecte.</rdfs:comment>
        <rdfs:label xml:lang="fr">VarieteDialectale</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Viande -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Viande">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Ingredient"/>
        <rdfs:comment xml:lang="fr">Aliment provenant d&apos;un animal (Neemdo en moore).</rdfs:comment>
        <rdfs:label xml:lang="fr">Viande</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#Video -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Video">
        <rdfs:subClassOf rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Media"/>
        <rdfs:comment xml:lang="fr">Sequence audiovisuelle (ex. technique de preparation, rythme joue).</rdfs:comment>
        <rdfs:label xml:lang="fr">Video</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#ZoneTouristique -->

    <owl:Class rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#ZoneTouristique">
        <rdfs:comment xml:lang="fr">Regroupement fonctionnel du territoire : Centre, Est, Sahel, Ouest/Sud-Ouest.</rdfs:comment>
        <rdfs:label xml:lang="fr">ZoneTouristique</rdfs:label>
    </owl:Class>
    


