        <descriptionTechnique xml:lang="fr">Trier, tremper au moins 8 heures puis décortiquer le niébé (haricot à œil noir) au mortier avant cuisson.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Préparation du Niébé (Trempage et Décorticage)</nomTechnique>
        <rdfs:label xml:lang="fr">Préparation du Niébé (Trempage et Décorticage)</rdfs:label>
    </owl:NamedIndividual>
    


