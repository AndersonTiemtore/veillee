        <rdfs:comment xml:lang="fr">SiteTouristique(?s) ^ aPourPeriodeFavorable(?s, ?p) ^ Saison(?p) ^ estEnCours(?p, true) -&gt; estRecommandeActuellement(?s, true)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
