        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Farcissage du poisson</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_farcissage_du_poisson_entier -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_farcissage_du_poisson_entier">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Inciser profondément un poisson entier et le garnir d&apos;une farce d&apos;herbes, ail, piment et soumbala avant cuisson dans un bouillon.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Farcissage du poisson entier</nomTechnique>
        <rdfs:label xml:lang="fr">Farcissage du poisson entier</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Repos de la pâte pendant une durée (12 h à une nuit) pour développer l&apos;acidité et le goût (apparition de bulles)</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation</nomTechnique>
        <rdfs:label xml:lang="fr">fermentation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_12_h -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_12_h">
