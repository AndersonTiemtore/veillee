    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_preparation_de_l_otonpienou -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_preparation_de_l_otonpienou">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Graines de baobab cuites, filtrées, fermentées et grillées, puis séchées au soleil pour obtenir une pâte séchée ; 7 jours de travail nécessaires.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Préparation de l&apos;otonpienou</nomTechnique>
        <rdfs:label xml:lang="fr">Préparation de l&apos;otonpienou</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_preparation_de_la_chenille_du_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_preparation_de_la_chenille_du_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Les cocons ramassés en août sont plongés dans l&apos;eau bouillante additionnée de potasse pour éjecter les déchets de l&apos;organisme de la chenille, puis égouttés et séchés au soleil avant d&apos;être frits dans l&apos;huile (ou simplement séchés pour une utilisation ultérieure).</descriptionTechnique>
        <nomTechnique xml:lang="fr">Préparation de la chenille du karité</nomTechnique>
        <rdfs:label xml:lang="fr">Préparation de la chenille du karité</rdfs:label>
    </owl:NamedIndividual>
    


