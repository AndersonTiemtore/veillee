        <rdfs:label xml:lang="fr">Sucrage au miel à chaud sans bouillir</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_synthese_de_toutes_les_techniques_du_recueil_feu_de_bois -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_synthese_de_toutes_les_techniques_du_recueil_feu_de_bois">
