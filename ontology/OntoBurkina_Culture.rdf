        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Fabrication maison de la farine de niébé (séchage puis pilonnage)</rdfs:label>
    </owl:NamedIndividual>
    


