    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_du_mais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_torrefaction_du_mais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Grains de maïs remués à sec en poêle pendant 10 minutes jusqu&apos;à dorure et légère coloration noircie, puis broyés en farine gris-brun</descriptionTechnique>
        <nomTechnique xml:lang="fr">Torréfaction du maïs</nomTechnique>
        <rdfs:label xml:lang="fr">Torréfaction du maïs</rdfs:label>
    </owl:NamedIndividual>
    


