    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_extraction_du_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_extraction_du_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">L&apos;amande du fruit de karité est séchée au soleil après avoir été bouillie, grillée ou fumée, puis broyée jusqu&apos;à obtention d&apos;une pâte épaisse à laquelle on ajoute de l&apos;eau ; le tout est porté à ébullition puis filtré pour éliminer les impuretés.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Extraction du beurre de karité</nomTechnique>
        <rdfs:label xml:lang="fr">Extraction du beurre de karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_extraction_du_jus_de_gingembre_par_pressage_au_tissu -->

