    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_de_la_poudre_de_lait_artisanale -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_de_la_poudre_de_lait_artisanale">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Évaporer lentement le lait frais par chauffage doux et prolongé jusqu&apos;à obtenir une poudre de lait concentrée ; technique des éleveurs peuls nomades.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication de la Poudre de Lait Artisanale</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication de la Poudre de Lait Artisanale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_de_yaourt_maison_lait_de_vache_ferment -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_de_yaourt_maison_lait_de_vache_ferment">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Fabrication de yaourt maison (lait de vache + ferment)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_de_yaourt_maison_lait_ferment_repos_13h -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_de_yaourt_maison_lait_ferment_repos_13h">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Fabrication de yaourt maison (lait + ferment, repos 13h)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_beurre_de_karite_maison -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_beurre_de_karite_maison">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Cuire, sécher, torréfier, piler, baratter et filtrer les amandes de karité pour produire le beurre de karité artisanal.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du Beurre de Karité Maison</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du Beurre de Karité Maison</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_dolo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_dolo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Long processus de germination-séchage-fermentation du mil ou du sorgho rouge, réalisé par les dolotières, nécessitant un grand savoir-faire pour obtenir un produit de qualité.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du dolo</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du dolo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_dolo_biere_de_mil_fermentee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_dolo_biere_de_mil_fermentee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Faire germer, sécher, moudre en malt puis brasser et fermenter le mil pour produire le dolo, bière artisanale burkinabée.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du Dolo (Bière de Mil Fermentée)</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du Dolo (Bière de Mil Fermentée)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_fromage_peul_wagashi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_fromage_peul_wagashi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Chauffer le lait de vache, le cailler avec du suc de feuilles de Calotropis procera (ou du citron), puis égoutter et mouler pour produire le wagashi, fromage traditionnel peul.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du Fromage Peul (Wagashi)</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du Fromage Peul (Wagashi)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_natron_sel_natif_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_natron_sel_natif_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Dissoudre, filtrer et sécher le natron brut, sel alcalin naturel utilisé pour attendrir les légumineuses et maintenir la couleur verte des légumes à la cuisson.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du Natron (Sel Natif Burkinabé)</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du Natron (Sel Natif Burkinabé)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_pain_de_manioc_fermente_chickwangue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_pain_de_manioc_fermente_chickwangue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Faire tremper et fermenter le manioc 3 à 5 jours, presser, façonner puis cuire à la vapeur dans des feuilles de bananier. Le nom local est présenté dans le livre comme &apos;Lingala&apos; (langue de RDC/Congo), ce qui interroge sur l&apos;origine réellement burkinabée de cette technique.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du Pain de Manioc Fermenté (Chickwangue)</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du Pain de Manioc Fermenté (Chickwangue)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_soumbala_fermentation_complete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_du_soumbala_fermentation_complete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Cuire longuement, décortiquer, fermenter 3 jours puis sécher les graines de néré pour produire le soumbala, condiment fermenté de base de la cuisine burkinabée.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fabrication du Soumbala (Fermentation Complète)</nomTechnique>
        <rdfs:label xml:lang="fr">Fabrication du Soumbala (Fermentation Complète)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fabrication_maison_de_la_farine_de_niebe_sechage_puis_pilonnage -->

