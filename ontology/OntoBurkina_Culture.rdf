    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_tamisage_2 -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_tamisage_2">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Passage d&apos;une pâte ou d&apos;une farine au tamis pour obtenir des grumeaux de taille régulière ou séparer le son</descriptionTechnique>
        <descriptionTechnique xml:lang="fr">Séparation de la farine fine des résidus/du son à l&apos;aide d&apos;un tamis</descriptionTechnique>
        <nomTechnique xml:lang="fr">Tamisage</nomTechnique>
        <rdfs:label xml:lang="fr">Tamisage</rdfs:label>
    </owl:NamedIndividual>
    


