    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_agneau_de_fete_en_mechoui_sahelien -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_agneau_de_fete_en_mechoui_sahelien">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Agneau entier incisé et mariné toute la nuit, embroché et rôti 3 à 4 heures au-dessus d&apos;une tranchée de braises, tourné toutes les 10-15 minutes, badigeonné de beurre karité toutes les 20 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">210</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Agneau de Fête en Méchoui Sahélien</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_arachides_grillees_salees_nacre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_arachides_grillees_salees_nacre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Arachides triées puis grillées 15 à 20 minutes soit dans du sable chaud remué constamment, soit à la poêle sèche, puis salées chaudes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Arachides Grillées Salées (Nâcré)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_arzan_tiig_vand_garsgo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_arzan_tiig_vand_garsgo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Couscous de farine de maïs et arachide pilée mélangé à des feuilles de moringa ramollies, cuit à la vapeur, servi avec une sauce tomate au poisson. Contact: Mme Ouedraogo/Zongo Aïssata, Groupement Sougri-Noma.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Arzan-tiig vand garsgo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_assiette_degustation_burkinabee_5_mini_plats -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_assiette_degustation_burkinabee_5_mini_plats">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cinq mini-plats (soumbala, karité, tamarin, piment, miel) préparés séparément et dressés en cercle sur une même assiette.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">90</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Assiette Dégustation Burkinabée (5 Mini-Plats)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_attieke_au_poisson_frit -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_attieke_au_poisson_frit">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Réhydrater l&apos;attiéké avec eau chaude, sel et huile de karité. Mariner et frire les poissons 10 min. Préparer une sauce tomates-oignons. Servir l&apos;attiéké avec le poisson frit et la sauce.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Attiéké au Poisson Frit</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_attieke_de_fete_au_poisson_braise_noel_et_reveillon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_attieke_de_fete_au_poisson_braise_noel_et_reveillon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Attiéké cuit à la vapeur, capitaines marinés et grillés sur braise 20 min par face, plantains frits (alloco), sauce pimentée, dressage central.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Attiéké de Fête au Poisson Braisé (Noël et Réveillon)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_aubergines_farcies_au_niebe_farce_economique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_aubergines_farcies_au_niebe_farce_economique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Aubergines coupées en deux et évidées, farce (oignon, ail, tomate, niébé, chair d&apos;aubergine, soumbala, piment) cuite 10 min, coques remplies et cuites à l&apos;étouffée 25 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Aubergines Farcies au Niébé (Farce Économique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_avocat_ananas_concombre_en_salade_avec_du_poivre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_avocat_ananas_concombre_en_salade_avec_du_poivre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Ananas, avocat et concombre coupés en dés, assaisonnés de sel, poivre et jus de citron vert, garnis de coriandre et cacahuètes concassées.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Avocat Ananas Concombre en Salade avec du Poivre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_b_uf_aux_legumes_du_dimanche -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_b_uf_aux_legumes_du_dimanche">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Dorure du bœuf, construction de la sauce (oignon, ail-gingembre, tomates, soumbala, piments), cuisson de la viande 45 min, ajout des légumes 20 min puis 10 min supplémentaires</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">75</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bœuf aux Légumes du Dimanche</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_baabenda -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_baabenda">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bouillie épaisse de riz écrasé au mortier mêlée à plusieurs feuilles (amarante, oseille, cléome), viande, arachide et piment. Contact: Mme Sawadogo Kadisso, Tél 77 73 59 38.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Baabenda</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_babenda -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_babenda">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil ou de sorgho sont lavés et épierrés puis moulus de sorte à obtenir une semoule moyenne. Les feuilles de niébé et d&apos;oseille sont triées puis lavées et essorées. Les graines d&apos;arachide sont triées puis pilées pour donner de la poudre d&apos;arachide. Les feuilles de niébé sont introduites dans de l&apos;eau bouillante et laissées à cuire complètement. Les feuilles d&apos;oseille sont ensuite ajoutées. Après la cuisson des feuilles, la semoule de sorgho est ajoutée. Après quelques minutes de cuisson, la poudre d&apos;arachide est ajoutée à la préparation. L&apos;ensemble est remué à la spatule jusqu&apos;à la cuisson finale. Consommé avec de l&apos;huile, du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Babenda</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_banakousa_to_de_manioc -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_banakousa_to_de_manioc">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de manioc délayée dans l&apos;eau bouillante en pâte homogène, battue et cuite 5 minutes. Sauce d&apos;oignons, poivrons, tomates revenus dans l&apos;huile avec poisson pilé et gombo finement découpé, mijotée 15 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Banakousa (Tô de manioc)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_banquet_de_mariage_complet_menu_6_services -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_banquet_de_mariage_complet_menu_6_services">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Menu structuré en 6 services (accueil, entrée, soupe, plat principal, pause festive, dessert), préparé par une brigade organisée en équipes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Banquet de Mariage Complet (Menu 6 Services)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bassi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bassi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Le mil est lavé, épierré et essoré avant d&apos;être séché. Les graines d&apos;arachide sont triées puis torréfiées. Le mil est finement broyé et la farine obtenue est humidifiée, calibrée au tamis de 450 µm avant d&apos;être étuvée. Après étuvage, la semoule est séchée puis mélangée aux arachides torréfiées (1 kg de mil pour 0,25 kg d&apos;arachides) ; sucre, épices et sel peuvent être ajoutés. L&apos;ensemble est broyé finement puis tamisé pour obtenir le bassi, consommé seul ou mélangé dans l&apos;eau, le lait ou le yaourt.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bassi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_batons_de_manioc_bouillis_baton_de_manioc -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_batons_de_manioc_bouillis_baton_de_manioc">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éplucher le manioc, éventuellement fermenter 24-48h. Cuire 20-25 min, piler en pâte lisse, saler, envelopper dans des feuilles de bananier, cuire à la vapeur 20 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bâtons de Manioc Bouillis (Bâton de Manioc)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_d_igname -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_d_igname">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boulettes d&apos;igname bouillie râpée mélangée à la viande hachée cuite, oignon, poivron, persil et ail, trempées dans l&apos;œuf battu et frites. Contact: Restaurant La Quiettude, Mme Alice Zoure.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets d&apos;igname</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_banane_au_miel_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_banane_au_miel_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de banane écrasée, farine, oeuf, sucre, sel et bicarbonate frite en cuillerées 3 minutes de chaque côté, puis arrosée de miel de karité chaud.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de Banane au Miel de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_banane_plantain_alloco_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_banane_plantain_alloco_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">(origine non-burkinabè signalée dans le texte) Le livre indique explicitement que ces beignets, dits « alloco », sont « appelés ainsi en Côte d&apos;Ivoire voisine et adoptés dans les cuisines burkinabées du Sud-Ouest » — nom local donné aussi en « Baoulé », ethnie de Côte d&apos;Ivoire. Plantains très mûrs tranchés en diagonale, frits 3-4 min par face jusqu&apos;à caramélisation, salés.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de Banane Plantain (Alloco Burkinabé)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_coco_sucres -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_coco_sucres">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de noix de coco râpée, farine, oeufs, sucre, sel et sésame façonnée en galettes de 6 cm et frites 4 minutes de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de Coco Sucrés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_haricots_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_haricots_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Purée de haricot/carotte/oignon en galettes frites</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">70</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de haricots burkinabè</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_haricots_niebe_koose -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_haricots_niebe_koose">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tremper et décortiquer les haricots niébé. Broyer en pâte lisse avec eau. Ajouter oignon, piments, sel, poivre, bicarbonate, battre. Frire par petites quantités 2-3 min de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de Haricots Niébé (Koosé)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_haricots_niebe_sucres -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_haricots_niebe_sucres">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Niébé trempé mixé en pâte mousseuse avec très peu d&apos;eau, fouetté 3 minutes avec sucre, sel, vanille et muscade, puis frit en cuillerées 4 minutes de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de Haricots Niébé Sucrés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_mais_sucres -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_de_mais_sucres">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparer la pâte de maïs avec sucre, sel, bicarbonate, noix de coco, œuf et eau. Frire par cuillerées 3 min puis 2 min de l&apos;autre côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets de Maïs Sucrés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_souffles_au_sesame -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_souffles_au_sesame">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte levée à la farine, levure, sucre et sésame grillé, reposée 1 heure, puis façonnée en boules et frites 4 minutes jusqu&apos;à dorure.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets Soufflés au Sésame</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_sucres_de_banane_miroir -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beignets_sucres_de_banane_miroir">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Écraser les bananes en purée. Ajouter farine, sucre, sel, bicarbonate, vanille, œuf et eau tiède. Frire par cuillerées 2 min de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beignets Sucrés de Banane (Miroir)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ben_kida -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ben_kida">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés et épierrés puis séchés, broyés et la farine obtenue tamisée (résidus éliminés). La farine fine est divisée en 1/4 et 3/4. La plus grande part (3/4) est humidifiée et roulée en grumeaux. L&apos;eau est portée à ébullition, les grumeaux sont ajoutés et cuits quelques minutes. La petite part (1/4) est délayée dans l&apos;eau pour obtenir du lait de farine, ajouté à la préparation ; le tout est mélangé et cuit quelques minutes. Consommée avec du sucre, du lait ou du yaourt.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ben-kida</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ben_saalga_bouillie_fermentee_de_rue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ben_saalga_bouillie_fermentee_de_rue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de mil fermentée 12 à 24 heures, puis cuite le lendemain en bouillie fluide sucrée, servie chaude.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ben-Saalga (Bouillie Fermentée de Rue)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_ne_taon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_ne_taon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de haricot pilées mélangées à la farine de mil en pâte potassée, façonnée en boules. Haricot cuit dans l&apos;eau avec potasse, boules disposées à la surface en fin de cuisson et cuites ensemble environ 45 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beng ne taon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_netton -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_netton">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont triées, lavées et épierrées. Elles sont trempées pendant une heure puis broyées pour donner une pâte consistante. Les feuilles de niébé sont triées, lavées puis essorées ; elles sont pilées. Les feuilles sont mélangées à la pâte, le tout est malaxé avec un peu de potasse. La pâte obtenue est modelée en grosses boules qui sont cuites à la vapeur. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beng-netton</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_netton_wesla -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_netton_wesla">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont triés, lavés et épierrés. Les feuilles de niébé sont lavées puis essorées avant d&apos;être pilées au mortier pilon. Le mil est séché et broyé finement. La farine de mil est mélangée aux feuilles de niébé pilées, le tout est malaxé en ajoutant de l&apos;eau potassée pour obtenir une pâte friable. De l&apos;eau est portée à ébullition, les graines de niébé sont ajoutées et laissées cuire quelques minutes ; une fois la cuisson complète des graines de niébé assurée, la pâte (farine de mil et feuilles pilées de niébé) est ajoutée au-dessus. La marmite est fermée et laissée à cuisson. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beng-netton wesla</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_ni_tji -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_ni_tji">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont lavées puis épierrées avant d&apos;être essorées. Le mil est lavé également et épierré. De l&apos;eau est portée à ébullition dans une marmite. A ébullition, ajouter les graines de niébé et le mil proprement lavés. Laisser cuire l&apos;ensemble dans l&apos;eau jusqu&apos;à écrasement total des graines de niébé et du mil (la variante avec sorgho est appelée Beng-ni-Kaseiga). Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beng-ni-tji</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_vaand_garsgo_ou_pigo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_beng_vaand_garsgo_ou_pigo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mélange de farine de mil, feuilles de haricot pilées, arachide et tourteau de coton, mouillé à l&apos;eau potassée et cuit à la vapeur 30 minutes. Contact: Groupement Sougri-Noma, Mme Ouedraogo/Zongo Aïssata.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Beng-vaand garsgo (ou pigo)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_benga_haricot -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_benga_haricot">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricot local bouilli à la potasse, servi avec une sauce tomate-oignon revenue à l&apos;huile. Contact: Restaurant Ri-Noodo, Mme Ouedraogo Rasmata.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Benga (haricot)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bengfalle -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bengfalle">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont lavées et épierrées puis essorées. De l&apos;eau est portée à ébullition et les graines de niébé y sont ajoutées. De la potasse est ajoutée à volonté. Laisser cuire jusqu&apos;à ce que les graines s&apos;écrasent au toucher de la main. A l&apos;aide d&apos;une spatule, malaxer les graines cuites pendant quelques minutes. Consommé avec du beurre de karité ou de l&apos;huile végétale et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bengfallé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bengyissa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bengyissa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés puis séchés. Ils sont broyés en farine fine. Les feuilles de niébé sont lavées et essorées puis pilées. La farine de mil est mélangée aux feuilles de niébé pilées. L&apos;ensemble est bien malaxé en ajoutant de l&apos;eau potassée pour obtenir une pâte ferme. La pâte est cuite à la vapeur pendant quelques minutes. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bengyissa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_biscuits_animaux_farine_de_mil_activite_boulangerie -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_biscuits_animaux_farine_de_mil_activite_boulangerie">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte sablée (farine, sucre, vanille, beurre de karité, oeuf, eau) réfrigérée 20 min, étalée et découpée en formes d&apos;animaux par les enfants, cuite en marmite couverte 15 min à feu doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Biscuits Animaux Farine de Mil (Activité Boulangerie)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bissap_festif_grand_format_boisson_de_ceremonie -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bissap_festif_grand_format_boisson_de_ceremonie">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fleurs d&apos;hibiscus et gingembre infusés 30 min dans l&apos;eau bouillante, filtrés, sucrés et parfumés à la vanille et au citron, dilués à 50 litres et réfrigérés.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bissap Festif Grand Format (Boisson de Cérémonie)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bissap_jus_de_fleurs_d_hibiscus -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bissap_jus_de_fleurs_d_hibiscus">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fleurs d&apos;hibiscus infusées 10-15 minutes dans l&apos;eau bouillante, filtrées, sucrées puis réfrigérées ; servies glacées avec menthe fraîche.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bissap (Jus de Fleurs d&apos;Hibiscus)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boisson_de_mil_grille_au_lait_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boisson_de_mil_grille_au_lait_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de mil torréfiée 8 minutes, diluée puis cuite en bouillie 5 minutes, additionnée de lait de coco, sucre, cannelle et sel, fouettée jusqu&apos;à consistance crémeuse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boisson de Mil Grillé au Lait de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boisson_pagne_jus_de_fleurs_et_feuilles_sauvages -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boisson_pagne_jus_de_fleurs_et_feuilles_sauvages">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Hibiscus infusé et moringa blanchi puis mixé et filtré séparément, les deux infusions colorées assemblées avec eau, sucre et citron.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boisson Pagne (Jus de Fleurs et Feuilles Sauvages)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boisson_tamarind_gingembre_hibiscus_3_en_1 -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boisson_tamarind_gingembre_hibiscus_3_en_1">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Hibiscus infusé, tamarin extrait et gingembre pressé séparément, puis les trois concentrés mélangés avec sucre et citron et réfrigérés une heure.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boisson Tamarind-Gingembre-Hibiscus (3 en 1)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_d_introduction_bebe_6_mois -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_d_introduction_bebe_6_mois">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine délayée dans l&apos;eau froide, cuite 8 min à feu doux en remuant, tiédie puis lait maternel ajouté hors du feu.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie d&apos;Introduction (Bébé 6 Mois)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_fonio_aux_graines_de_moringa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_fonio_aux_graines_de_moringa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Rincer le fonio dans plusieurs bains d&apos;eau pour retirer le sable, égoutter. Cuire dans 2 verres d&apos;eau sur feu moyen 10 min en remuant jusqu&apos;à gonflement complet. Ajouter le lait chaud, cuire encore 5 min. Retirer du feu, ajouter la poudre de moringa (hors du feu pour préserver la vitamine C), le miel, la vanille et la cannelle.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie de Fonio aux Graines de Moringa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_mil_sucree_du_bapteme_benediction -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_mil_sucree_du_bapteme_benediction">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de la pâte de mil délayée, cuisson longue 20 min en remuant sans arrêt, ajout du lait fermenté et du sucre en fin de cuisson</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie de Mil Sucrée du Baptême (Bénédiction)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_sorgho_au_lait_petit_dejeuner_economique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_sorgho_au_lait_petit_dejeuner_economique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine délayée dans l&apos;eau froide, cuite 12 min jusqu&apos;à bouillie lisse et épaisse, lait, sucre et vanille ajoutés hors du feu.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie de Sorgho au Lait (Petit-Déjeuner Économique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_sorgho_fermente -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_de_sorgho_fermente">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Grains de sorgho lavés puis fermentés 48 heures dans l&apos;eau, broyés en pâte, diluée et cuite en remuant jusqu&apos;à consistance de bouillie fluide, puis servie avec lait fermenté et sucre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie de Sorgho Fermenté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_enrichie_arachide_moringa_9_12_mois -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_enrichie_arachide_moringa_9_12_mois">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine délayée cuite 8 min jusqu&apos;à bouillie lisse, puis poudre d&apos;arachide, sucre et poudre de moringa ajoutés hors du feu (moringa non bouilli).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie Enrichie Arachide-Moringa (9-12 Mois)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_sucree_de_mil_au_lait_dessert -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillie_sucree_de_mil_au_lait_dessert">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de mil cuite 10 minutes en bouillie lisse, puis enrichie de sucre, vanille et lait fermenté (et lait concentré sucré en option).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillie Sucrée de Mil au Lait (Dessert)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_mouton_aux_herbes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_mouton_aux_herbes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mouton mariné aux épices, blanchi puis mijoté 1h30 avec oignons, tomates, piments; céleri et coriandre fraîche ajoutés en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillon de Mouton aux Herbes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_poulet_traditionnel_fortifiant -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_poulet_traditionnel_fortifiant">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet découpé et légèrement brûlé au feu pour retirer les plumes, doré à l&apos;huile, puis mijoté 3 heures avec oignon, ail, gingembre, céleri, carottes, soumbala, piment et sel. Premier aliment donné aux femmes après l&apos;accouchement.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">190</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillon de Poulet Traditionnel Fortifiant</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_queue_de_b_uf -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_queue_de_b_uf">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Queue de bœuf blanchie puis mijotée à feu très doux au moins 2 heures avec oignon, tomate, ail-gingembre; carottes et pommes de terre ajoutées 45 minutes avant la fin, céleri 15 minutes avant.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillon de Queue de Bœuf</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_tripes_epice -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_tripes_epice">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyer longuement les tripes au gros sel et citron. Mariner avec ail-gingembre, cumin, poivre, sel 30 min. Blanchir 10 min et jeter l&apos;eau. Cuire avec oignons, tomates, piments, cube, sel 1h30. Ajouter céleri et ciboulette 30 min avant la fin.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">130</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillon de Tripes Épicé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_viande_de_b_uf_epice -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_bouillon_de_viande_de_b_uf_epice">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande blanchie puis mijotée 1h avec oignon, tomate, soumbala, épices; légumes (carottes, pommes de terre, céleri, persil) ajoutés ensuite jusqu&apos;à cuisson complète.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bouillon de Viande de Bœuf Épicé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boule_de_mais_to_jaune_de_fete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boule_de_mais_to_jaune_de_fete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de la pâte de base, bouillie initiale 5 min, incorporation de la farine sèche en pilonnant 12 à 15 min, façonnage en boule</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">17</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boule de Maïs (Tô Jaune de Fête)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boule_de_mil_soupe_de_poisson -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boule_de_mil_soupe_de_poisson">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boule de mil cuite selon la technique du tô. Poisson frais nettoyé mijoté dans une soupe tomate-oignon-soumbala-piment, servi avec la boule de mil trempée dedans.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boule de Mil Soupe de Poisson</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boules_d_energie_arachide_miel_pour_gouter_ecole -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boules_d_energie_arachide_miel_pour_gouter_ecole">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poudre d&apos;arachide mélangée au miel, cannelle et sésame, pétrie jusqu&apos;à pâte homogène, façonnée en boules roulées dans la noix de coco ou le sésame.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boules d&apos;Énergie Arachide-Miel pour Goûter École</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_feuilles_fraiches_d_aubergine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_feuilles_fraiches_d_aubergine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les mauvaises feuilles et les tigelles, laver 3 fois avec de l&apos;eau potable. Porter l&apos;eau à ébullition et y ajouter les feuilles fraîches d&apos;aubergine. Laisser cuire 30 min. Retirer les feuilles, les rincer de nouveau à l&apos;eau potable puis égoutter. De petites boules sont faites à partir de ces feuilles bien cuites. Se consomment seules, assaisonnées avec du sel, de l&apos;huile et du piment. Teneur en matière sèche : 19,96 g/100 g de produit, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de feuilles fraîches d&apos;aubergine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_mais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_mais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Maïs grillé et moulu mélangé à farine de haricot délayée, oignons et poudre d&apos;arachide en pâte, façonné en boulettes cuites à l&apos;eau bouillante 45 minutes. Sauce de tomate, oignon et poivron revenus au beurre de karité, mijotée avec le poisson émietté 5 minutes. Les boulettes peuvent être séchées et consommées en croquettes amuse-gueule.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">70</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de maïs</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_mil_frites_koose_style_economique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_mil_frites_koose_style_economique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de mil, oignon, piment et sel mélangée avec eau tiède, cuillerées de pâte frites 4 min en retournant.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de Mil Frites (Koosé Style Économique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_pistache -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_pistache">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande de poulet pilée avec légumes râpés et poudre de pistache jusqu&apos;à pâte homogène, façonnée en petites boules, puis cuites 30 à 40 minutes dans un bouillon d&apos;oignons, tomates et poivrons revenus au beurre de karité.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de pistache</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_riz_au_poisson_pour_gouter -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_riz_au_poisson_pour_gouter">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poisson séché réhydraté 20 min et émincé, mélangé au riz chaud avec soumbala, sel et huile de karité, façonné en boulettes compactes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de Riz au Poisson pour Goûter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_viande -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_viande">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boulettes de viande hachée liées à la pâte d&apos;arachide et à la farine de mil, pochées dans un bouillon de tomate et oignon. Contact: Mme Traore Clarisse, Tél 72 24 00 24.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de viande</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_viande_epicees_grillees -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_boulettes_de_viande_epicees_grillees">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mélanger le bœuf haché avec oignon, ail, gingembre, piments, épices, œuf et farine. Façonner en boulettes, enfiler sur brochettes. Griller 3-4 min de chaque côté ou cuire à la poêle 8-10 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Boulettes de Viande Épicées Grillées</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_au_koura_koura -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_au_koura_koura">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Koura-koura écrasé avec sel et piment en poudre. Viande embrochée, arrosée d&apos;huile, saupoudrée de poudre de koura-koura salée et pimentée, grillée à la braise environ 10 minutes en retournant.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Brochettes au koura koura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_b_uf_grillees_dibi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_b_uf_grillees_dibi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mariner la viande avec ail, gingembre, épices 1h à toute une nuit. Enfiler sur brochettes, tremper les brochettes en bois. Griller sur braise 3-4 min de chaque côté. Préparer la sauce dibi (tomates, oignon, piments, soumbala, moutarde, huile) 8 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Brochettes de Bœuf Grillées (Dibi)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_fruits_tropicaux_grilles -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_fruits_tropicaux_grilles">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fruits coupés enfilés en alternance sur brochettes en bois, marinés 15 minutes au miel-citron-gingembre-cannelle, puis grillés 2 minutes de chaque face.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Brochettes de Fruits Tropicaux Grillés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_mouton_de_fete_ceremonie -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_mouton_de_fete_ceremonie">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage de la viande, marinade toute la nuit, montage cérémonieux en alternant viande et gras, grillage à la braise 15 à 18 min en tournant toutes les 3 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Brochettes de Mouton de Fête (Cérémonie)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_soja -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_de_soja">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cubes de tofu macérés dans l&apos;ail, le persil et un peu d&apos;eau salée, puis embrochés avec oignons, poivrons et tomates et grillés au charbon à feu doux. Se sert chaud avec une sauce piquante.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Brochettes de soja</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_dibi_royal_pour_grande_fete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_brochettes_dibi_royal_pour_grande_fete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viandes marinées 4h dans karité, ail, gingembre, soumbala, montées en brochettes variées et grillées 6 à 8 minutes sur braise, badigeonnées de beurre karité.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Brochettes Dibi Royal pour Grande Fête</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_buche_tropicale_mangue_coco_sans_cuisson -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_buche_tropicale_mangue_coco_sans_cuisson">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chauffer la purée de mangue avec sucre et agar-agar, laisser refroidir, incorporer délicatement la crème de coco fouettée. Imbiber les galettes de mil de jus de mangue, étaler une couche de crème mangue-coco sur chaque galette, empiler pour former un bloc, envelopper dans un film alimentaire et réfrigérer 4h. Couvrir de crème restante, saupoudrer de noix de coco grillée, décorer de tranches de mangue et de fleurs.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Bûche Tropicale Mangue-Coco Sans Cuisson</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_cake_a_la_banane_et_farine_de_mil -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_cake_a_la_banane_et_farine_de_mil">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oeufs et sucre battus, purée de banane et beurre de karité ajoutés, farines incorporées, cuit à la vapeur 45 minutes ou en marmite couverte à feu doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Cake à la Banane et Farine de Mil</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_cake_aux_dattes_et_noix_de_cajou -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_cake_aux_dattes_et_noix_de_cajou">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Hacher finement les dattes dénoyautées. Battre oeufs, sucre et beurre de karité, ajouter les dattes hachées. Incorporer farine, levure, sel et cannelle, puis les noix de cajou hachées. Verser dans un moule huilé et fariné, cuire à la vapeur 45 min ou en marmite-four couverte. Laisser refroidir 30 min avant de démouler ; se conserve 5 jours enveloppé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Cake aux Dattes et Noix de Cajou</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_capitaine_royal_au_beurre_de_karite_et_citron_caviar -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_capitaine_royal_au_beurre_de_karite_et_citron_caviar">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Capitaine incisé et farci d&apos;un beurre d&apos;herbes (karité, ail confit, herbes, soumbala, zeste de citron), réfrigéré 2h, cuit enveloppé de feuilles de bananier sur braises ou au four (200°C, 25 min/kg), flambé à table au dolo, servi avec sauce beurre blanc au karité.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">180</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Capitaine Royal au Beurre de Karité et Citron Caviar</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_caramel_de_lait_au_miel_sauvage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_caramel_de_lait_au_miel_sauvage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lait et miel cuits 20-25 minutes jusqu&apos;à consistance de caramel, additionnés de beurre de karité et sel, moulés et découpés en carrés une fois refroidis.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Caramel de Lait au Miel Sauvage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_carpaccio_de_poisson_fume_au_vinaigre_de_tamarin -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_carpaccio_de_poisson_fume_au_vinaigre_de_tamarin">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Filet de poisson fumé tranché finement (2-3 mm), mariné 5 min dans le vinaigre de tamarin, dressé en rosace sur assiette froide, arrosé d&apos;huile d&apos;arachide, garni de mangue verte en brunoise, micro-herbes, fleur de sel et zeste de citron.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Carpaccio de Poisson Fumé au Vinaigre de Tamarin</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_chips_de_banane_plantain_epicees -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_chips_de_banane_plantain_epicees">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Peler et trancher les plantains. Assaisonner de piment, sel, poivre. Frire 2-5 min selon épaisseur.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Chips de Banane Plantain Épicées</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_churros_de_farine_de_mil_au_sucre_cannelle -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_churros_de_farine_de_mil_au_sucre_cannelle">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Verser l&apos;eau bouillante sur le beurre de karité, mélanger. Ajouter farines et sel, mélanger vigoureusement jusqu&apos;à pâte lisse. Pocher des bâtonnets de 10 cm directement dans l&apos;huile chaude, frire 3 min en retournant. Rouler encore chauds dans le mélange sucre-cannelle.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Churros de Farine de Mil au Sucre Cannelle</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_compote_de_mangue_au_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_compote_de_mangue_au_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangues en cubes cuites 15 minutes avec sucre, gingembre et citron, cannelle ajoutée en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Compote de Mangue au Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_confiture_de_mangue_maison -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_confiture_de_mangue_maison">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangues macérées 30 minutes avec sucre, citron, zeste et gingembre, puis cuites 30-35 minutes en écumant, mises en pots stérilisés chauds.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Confiture de Mangue Maison</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_aux_fruits_d_aubergine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_aux_fruits_d_aubergine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les fruits frais d&apos;aubergine. Mouiller la farine de mil et cuire à la vapeur l&apos;ensemble : fruits frais d&apos;aubergine, gritz de mil et farine mouillée. Peut se consommer seul ou assaisonné avec de l&apos;huile et du sel. Teneur en matière sèche : 18,5 g/100 g.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous aux fruits d&apos;aubergine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_ceremoniel_de_deuil_et_condoleances -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_ceremoniel_de_deuil_et_condoleances">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule de mil cuite à la vapeur en plusieurs bains de 25 minutes, servie avec une sauce à la viande riche et nourrissante, préparée collectivement par les femmes du quartier.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous Cérémoniel de Deuil et Condoléances</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_fonio -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_fonio">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fonio étuvé trois fois, mélangé à la poudre de gombo</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de fonio</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_fonio_a_la_sauce_patte_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_fonio_a_la_sauce_patte_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Couscous de fonio cuit en plusieurs passages au couscoussier, servi avec une sauce à la pâte d&apos;arachide, viande, poudre de crevette, chou, aubergine locale et patate douce. Contact: Restaurant Daraxi, Mme Somda Monique.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de fonio à la sauce patte d&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_fonio_au_haricot -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_fonio_au_haricot">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bouillie de haricot mélangée au fonio en filet, cuite à feu doux, servie chaude avec de l&apos;huile ou une sauce tomate. Contact: Mme Millogo Claudine, Tél 76 31 34 60.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de fonio au haricot</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_haricot_sauce_yassa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_haricot_sauce_yassa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricot moulu en couscous et monté à la vapeur en plusieurs passages; sauce yassa à base d&apos;oignons découpés et d&apos;épices à la moutarde mijotée avec le poisson frit et servie sur le couscous.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">120</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de haricot sauce yassa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_au_lait -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_au_lait">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule de mil étuvée puis mêlée à du lait sucré</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de mil au lait</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_au_lait_fermente -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_au_lait_fermente">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule de mil humidifiée et roulée à la main, cuite deux fois à la vapeur au-dessus d&apos;une marmite d&apos;eau bouillante avec un roulage intermédiaire à l&apos;huile de karité. Servi tiède, nappé de lait fermenté frais et sucré, parsemé d&apos;arachides.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Mil au Lait Fermenté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_aux_legumes_du_jardin -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_aux_legumes_du_jardin">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule cuite à la vapeur 20 min et égrenée, sauce légumes (oignon, soumbala, tomates puis légumes coupés) mijotée 15 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Mil aux Légumes du Jardin</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_de_mariage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_de_mariage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cuisson du bouillon de viande (mouton puis poulet, tomates, soumbala, piments), cuisson vapeur du couscous en 3 passages avec égrainage entre chaque, ajout des légumes dans le bouillon durant le 2e passage, assemblage final</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Mil de Mariage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_doux_pour_tout_petits -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_doux_pour_tout_petits">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule humidifiée cuite à la vapeur 20 min puis égrenée et remise 10 min avec beurre de karité; sauce de légumes (carottes, courgette, tomate) mijotée 15 min sans piment.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Mil Doux pour Tout-Petits</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_traditionnel -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_mil_traditionnel">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Humidification du couscous, premier passage vapeur 20 min, égrainage et humidification, deuxième passage 15 min, troisième et dernier passage 10 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Mil Traditionnel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_petit_mil_au_choux -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_petit_mil_au_choux">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de choux bouillies 50 minutes et essorées; farine de mil aspergée d&apos;eau, tamisée et passée à la vapeur en plusieurs étapes; servi avec les feuilles et du poisson frit. Peut se manger avec huile, sel ou sauce tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">115</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de petit mil au choux</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_pois_de_terre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_pois_de_terre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Couscous à base de farine de pois de terre humidifiée à la potasse, mélangée à la farine de maïs, granulée au tamis et cuite à la vapeur en trois passages de 45 minutes. Contact: Restaurant PFNL-Environnement, Mme Kiemde dit Alima Disco.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">135</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de pois de terre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_sorgho_leger -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_sorgho_leger">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule de sorgho humidifiée, égrainée puis cuite à la vapeur en deux passages successifs (15 min puis 12 min) au-dessus du bouillon, avec égrainage entre les deux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Sorgho Léger</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_sorgho_sauce_viande -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_couscous_de_sorgho_sauce_viande">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Semoule de sorgho roulée et cuite deux fois à la vapeur. Viande mijotée longuement avec tomate, soumbala, carotte jusqu&apos;à réduction, servie en puits au centre du couscous.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Couscous de Sorgho Sauce Viande</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_creme_brulee_au_lait_de_karite_et_vanille_de_banfora -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_creme_brulee_au_lait_de_karite_et_vanille_de_banfora">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Beurre de karité infusé à la vanille 20 min à 80°C, versé sur jaunes et sucre battus, cuit au bain-marie 45 min, réfrigéré 4h puis caramélisé au sucre roux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">65</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crème Brûlée au Lait de Karité et Vanille de Banfora</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_creme_de_karite_sucree_de_fete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_creme_de_karite_sucree_de_fete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fouettage du beurre de karité ramolli avec sucre/miel, ajout vanille-muscade-cannelle, fouettage 3 min supplémentaires, mise au frais 30 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">38</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crème de Karité Sucrée de Fête</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_creme_de_mangue_et_lait_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_creme_de_mangue_et_lait_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chair de mangue, lait de coco, sucre, citron et sel mixés 2 minutes jusqu&apos;à crème lisse, versée en ramequins et réfrigérée 2 heures.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crème de Mangue et Lait de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_crepe_de_niebe_farci_au_poulet -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_crepe_de_niebe_farci_au_poulet">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Crêpe à base de farine de haricot farcie de chair de poulet sauté avec papaye verte, oignon, tomate et poivron, arrosée d&apos;une sauce à base d&apos;os de poulet pilés. Contact: Restaurant Oxygène, Monsieur Turbiche Nare.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crêpe de niébé farci au poulet</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_crepes_de_mil_epaisses -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_crepes_de_mil_epaisses">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte épaisse de farine de mil, oeufs, lait, sucre, sel et levure cuite en crêpes épaisses (8 mm) 3-4 minutes de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crêpes de Mil Épaisses</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_crepes_de_riz_a_la_confiture_de_papaye -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_crepes_de_riz_a_la_confiture_de_papaye">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine, sucre et sel mélangés avec les œufs et le lait en pâte, reposée 1 heure. Pâte étalée en fine couche à la poêle graissée, cuite 2 minutes de chaque face, tartinée de confiture de papaye après refroidissement.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">64</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crêpes de riz à la confiture de papaye</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_crepes_de_voandzou -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_crepes_de_voandzou">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de voandzou additionnée d&apos;œufs, de gombo et d&apos;ail, cuite en crêpes à la poêle ; se mange sucrée ou salée. Contact: Mme Dah/Sankara Martine, Tél 74 60 94 58.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crêpes de voandzou</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_croquettes_d_igname -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_croquettes_d_igname">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Igname bouilli à l&apos;eau simple puis râpé, mélangé aux œufs battus en neige, à la poudre d&apos;igname, au persil, à l&apos;oignon et à l&apos;ail hachés. Pâte façonnée en boules et frite. Se sert simplement ou avec une sauce tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Croquettes d&apos;igname</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_croquettes_de_soja -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_croquettes_de_soja">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tofu découpé en petits dés ou triangles, saupoudré de sel et de poivre, frit jusqu&apos;à couleur dorée. Peut se conserver longtemps.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Croquettes de soja</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_crudites_et_houmous_de_niebe_maison -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_crudites_et_houmous_de_niebe_maison">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Niébé cuit mixé avec pâte d&apos;arachide, citron, ail, cumin et huile jusqu&apos;à texture crémeuse, servi avec crudités en bâtonnets.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Crudités et Houmous de Niébé Maison</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_degue_de_patate_douce_a_chaire_orange -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_degue_de_patate_douce_a_chaire_orange">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Grumeaux de poudre de patate douce à chair orange tamisés, cuits à la vapeur, mélangés à un yaourt maison (lait de vache fermenté), sucrés et servis frais avec des rondelles de banane. Contact: Mme Traore Korotoumou, Tél 20 95 44 24.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Dègue de patate douce à chaire orange</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_degue_de_petit_mil_au_pain_de_singe_et_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_degue_de_petit_mil_au_pain_de_singe_et_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Grumeaux de mil cuits, mélangés à la poudre de pain de singe diluée et filtrée, ainsi qu&apos;à l&apos;arachide pilée, sucrés. Contact: Traore Clarisse, Tél 72 24 00 24.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Dègue de petit mil au pain de singe et arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_dejeuner_de_mariage_vegetarien -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_dejeuner_de_mariage_vegetarien">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Menu entièrement végétal composé de légumineuses, céréales, légumes et fruits du terroir burkinabè, servi en abondance.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Déjeuner de Mariage Végétarien</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_djandjala_lobiri_ou_goara_birifor -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_djandjala_lobiri_ou_goara_birifor">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignons, tomates, poivrons et courge coupés en dés; soumbala et poisson pilés. Feuilles de moringa, d&apos;amarante, de courge et de berenga ajoutées successivement dans la marmite, cuites, égouttées, puis mélangées aux légumes revenus au beurre de karité, mijotées 15 à 20 minutes. Servi accompagné du tô.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">22</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Djandjala (lobiri) ou Goara (birifor)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_dolo_clair_biere_de_mil_legere -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_dolo_clair_biere_de_mil_legere">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Malt de mil broyé, empâté dans l&apos;eau tiède, filtré, fermenté 24 heures, rebouilli puis filtré trois fois pour obtenir un dôlo clair et léger.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Dôlo Clair (Bière de Mil Légère)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_dolo_de_fete_vieux_biere_ceremonie_premium -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_dolo_de_fete_vieux_biere_ceremonie_premium">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mil germé 3 jours, brassé en infusion 3h puis bouilli 2h, fermenté 48 heures avec levure naturelle de la fournée précédente, servi dans des calebasses avec libation aux ancêtres.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Dolo de Fête Vieux (Bière Cérémonie Premium)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_donuts_africains_au_bissap -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_donuts_africains_au_bissap">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Dissoudre la levure dans un peu de jus de bissap tiède sucré. Mélanger farine, sucre, sel, ajouter levure, oeuf et jus de bissap, pétrir 8 min (pâte rose-rouge). Laisser lever 1h. Étaler à 1 cm, découper des ronds troués, laisser reposer 15 min, frire 2 min de chaque côté. Glacer le dessus des donuts chauds avec le mélange sucre glace-bissap.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Donuts Africains au Bissap</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_doublissi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_doublissi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de haricot battue avec œufs, potasse et sel, cuite en crêpes épaisses (façon pancake) à la poêle, servie avec huile et sel. Contact: Mme Kere Sabine, Tél 70 07 56 20.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Doublissi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_dounkoum_dagara -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_dounkoum_dagara">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de dounkoum lavées et bouillies pendant 6 heures puis essorées, ajoutées aux légumes (oignon, tomate, poivron) revenus dans le beurre de karité et mijotées 5 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">365</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Dounkoum (dagara)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_eau_de_baobab_boisson_au_pain_de_singe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_eau_de_baobab_boisson_au_pain_de_singe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pulpe de baobab dissoute et malaxée dans l&apos;eau froide, filtrée, sucrée et salée légèrement.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Eau de Baobab (Boisson au Pain de Singe)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_entrecote_de_zebu_burkinabe_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_entrecote_de_zebu_burkinabe_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Entrecôtes tempérées 1h, saisies 5 min à feu maximum au beurre de karité moussant, retournées une fois avec ail et thym, arrosées en continu 2-3 min, reposées 7 min enveloppées avant découpe et assaisonnement final au sel. Note : le livre nomme le poivre utilisé « poivre long de Penja », lieu situé au Cameroun, non au Burkina Faso.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Entrecôte de Zébu Burkinabé au Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_festin_de_la_nouvelle_annee_mossi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_festin_de_la_nouvelle_annee_mossi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chaque femme de la famille prépare son plat signature pour une table collective réunie à minuit, le tô de mil de la grand-mère étant servi en premier.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Festin de la Nouvelle Année Mossi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_filet_de_poulet_fermier_au_miel_et_epices_rares -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_filet_de_poulet_fermier_au_miel_et_epices_rares">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Filets de poulet fermier marinés 12h (miel, citron, ail confit, gingembre, épices), saisis 4 min/face dans l&apos;huile de karité, glacés au miel 2 min, reposés 5 min puis tranchés en biais.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">12</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Filet de Poulet Fermier au Miel et Épices Rares</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_financiers_a_la_poudre_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_financiers_a_la_poudre_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chauffer le beurre de karité dans une casserole jusqu&apos;à légère coloration et arôme de noisette. Mélanger poudre d&apos;arachide, sucre, farine et sel ; ajouter les blancs d&apos;oeuf non montés, mélanger. Ajouter le beurre de karité noisette encore chaud, mélanger jusqu&apos;à pâte lisse. Verser dans des moules huilés, cuire en marmite couverte à feu doux 15 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Financiers à la Poudre d&apos;Arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foie_de_boeuf_saute_aux_oignons_abats_economiques -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foie_de_boeuf_saute_aux_oignons_abats_economiques">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Foie tranché, membranes retirées, mariné 10 min au jus de citron et sel, saisi 2 min par face à l&apos;huile très chaude, oignons fondus dans le même jus puis foie remis pour finition.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foie de Boeuf Sauté aux Oignons (Abats Économiques)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_fondant_de_banane_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_fondant_de_banane_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oeufs et sucre battus, banane écrasée et beurre de karité incorporés, puis farine, levure, sel et vanille mélangés ; cuit à la vapeur (35 min) ou à la poêle couverte (25 min).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Fondant de Banane au Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foni_gnonkon_ou_gnonkon_de_fonio -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foni_gnonkon_ou_gnonkon_de_fonio">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fonio cuit à la vapeur en deux passages, mélangé à des feuilles de haricot pilées potassées et de la poudre d&apos;arachide, façonné en boules cuites à la vapeur, servi avec huile ou sauce tomate. Contact: Restaurant Bobodia, Mme Toe/Malgoubri Alima.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">80</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foni gnonkon ou gnonkon de fonio</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_fonio_au_gras -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_fonio_au_gras">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fonio précuit cuit dans un bouillon de viande aux oignons, tomates, poivrons, ail et persil. Contact: Restaurant Fasorisongo, Mlle Savadogo Oumou Koulsoum.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Fonio au gras</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_fonio_djouka_a_la_sauce_tomate -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_fonio_djouka_a_la_sauce_tomate">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fonio monté à la vapeur en plusieurs passages avec poudre d&apos;arachide; sauce tomate préparée avec boulettes de viande hachée mêlée à la pâte d&apos;arachide et aux épices, mijotée 15 à 20 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Fonio djouka à la sauce tomate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foufou_au_manioc -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foufou_au_manioc">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boulettes de pâte de manioc servies avec sauce viande-arachide-gombo</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">120</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foufou (au manioc)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foufou_banane_plantain -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foufou_banane_plantain">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bananes plantain bouillies puis pilées en pâte, boules servies avec sauce poisson-tomate-aubergine</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foufou (banane plantain)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foutou_d_igname -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foutou_d_igname">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Igname cuit à l&apos;eau simple, pilé au mortier jusqu&apos;à pâte lisse et collante. Sauce préparée avec gombo et aubergine locale cuits, écrasés, filtrés puis mijotée avec oignon, tomate, poivron dans l&apos;huile de palme pendant 10 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foutou d&apos;igname</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foutou_d_igname_des_communautes_du_sud_ouest -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foutou_d_igname_des_communautes_du_sud_ouest">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Épluchage de l&apos;igname, cuisson 25 à 30 min, pilonnage du foutou 15 à 20 min jusqu&apos;à masse lisse et élastique</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foutou d&apos;Igname des Communautés du Sud-Ouest</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_foutou_d_igname_sauce_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_foutou_d_igname_sauce_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Igname très cuite pilée longuement au mortier jusqu&apos;à pâte élastique et collante. Sauce arachide mijotée avec viande, tomate, soumbala et piment jusqu&apos;à consistance crémeuse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Foutou d&apos;Igname Sauce Arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_frites_de_plantain_doux -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_frites_de_plantain_doux">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Épluchage et découpe du plantain mûr en tranches obliques, friture par fournées 3 min puis 2 min jusqu&apos;à dorure caramélisée, égouttage</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Frites de Plantain Doux</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_frites_de_pomme_de_terre_aloco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_frites_de_pomme_de_terre_aloco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pomme de terre découpée en lamelles et frite, banane plantain découpée en rondelles et frite séparément. Peut se consommer accompagné d&apos;une sauce tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Frites de pomme de terre aloco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_frites_locales_de_pomme_de_terre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_frites_locales_de_pomme_de_terre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pommes de terre pelées, coupées en frites, trempées 30 min à l&apos;eau froide puis séchées. Première friture à basse température (5-6 min), deuxième friture à haute température (2-3 min) pour la dorure, puis salées immédiatement.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Frites Locales de Pomme de Terre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_friture_de_feuilles_sechees_d_aubergine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_friture_de_feuilles_sechees_d_aubergine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les oignons finement. Tremper les feuilles séchées d&apos;aubergine dans l&apos;eau potassée 15 min. Rincer les feuilles 2 fois. Porter l&apos;eau à ébullition et y ajouter les feuilles séchées d&apos;aubergine, laisser au feu 30 min. Retirer les feuilles de l&apos;eau, bien les malaxer en mélangeant les oignons et le sel. Frire le tout à l&apos;huile 15 min. Se consomme seul, ou avec du tô ou du riz. Teneur en matière sèche : 26,6 g/100 g du plat.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Friture de feuilles séchées d&apos;aubergine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_fufu_de_manioc_des_communautes_dioula_de_bobo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_fufu_de_manioc_des_communautes_dioula_de_bobo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Épluchage du manioc, cuisson 25 min, pilonnage technique du fufu 15-20 min jusqu&apos;à masse lisse et élastique, test de qualité</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Fufu de Manioc des Communautés Dioula de Bobo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_fura -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_fura">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés et épierrés puis séchés, puis finement broyés. La farine fine obtenue est malaxée avec un peu d&apos;eau pour donner une pâte. La pâte peut être portée à la vapeur pour cuisson ou façonnée en grosses boules et ensuite cuites par immersion. La pâte ou les boules cuites sont pilées au mortier pilon pour donner une pâte molle, qui est le Fura, consommé seul ou délayé dans l&apos;eau, le lait ou le yaourt.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Fura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_farine_de_ble_beurrees -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_farine_de_ble_beurrees">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine, sel, bicarbonate et eau tiède façonnée en boules, aplaties en disques et cuites à la poêle 3-4 min de chaque côté, puis badigeonnées de beurre de karité fondu.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Farine de Blé Beurrées</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_farine_de_mais_pain_du_pauvre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_farine_de_mais_pain_du_pauvre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine et sel mélangés avec eau chaude jusqu&apos;à pâte souple, façonnée en galettes de 1 cm, cuites à sec 4-5 min par face.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Farine de Maïs (Pain du Pauvre)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_fonio_a_la_banane -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_fonio_a_la_banane">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte fonio/banane levée puis frite en galettes</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de fonio à la banane</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_fonio_soufflees -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_fonio_soufflees">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Séparer les blancs des jaunes, battre les blancs en neige ferme, réserver au frais. Mélanger farine de fonio, jaunes, lait fermenté, sucre et sel jusqu&apos;à pâte lisse. Incorporer délicatement les blancs en 3 fois. Cuire à la poêle légèrement graissée sur feu très doux à couvert 4 min, retourner délicatement, cuire encore 3 min. Arroser de miel ou de confiture de mangue.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Fonio Soufflées</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de maïs fermentée 6 à 10 h, mélangée à la banane plantain écrasée et au sucre, frite en galettes à la poêle. Contact: Association Delwende, Mme Ramde Rakiéta.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de maïs</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mais_colorees_activite_enfants -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mais_colorees_activite_enfants">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de base séparée en 3 portions colorées naturellement (curcuma, betterave, épinards), cuites séparément à la poêle avec participation des enfants.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Maïs Colorées (Activité Enfants)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mil_et_legumineuses_repas_complet -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mil_et_legumineuses_repas_complet">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farines de mil et de niébé mélangées avec oeufs, oignon, persil, gingembre, sel et piment, eau ajoutée jusqu&apos;à pâte épaisse ; cuisson en galettes de 1 cm à la poêle huilée, 4 min par face.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Mil et Légumineuses (Repas Complet)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mil_grillees_degue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mil_grillees_degue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mélanger farine de mil, sel, sucre, bicarbonate. Ajouter le lait fermenté puis l&apos;eau tiède pour obtenir une pâte épaisse. Laisser reposer 1h (optionnel). Cuire sur plaque chaude 3 min puis 2-3 min de l&apos;autre côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">6</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Mil Grillées (Dégué)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mil_levees_pain_plat_du_matin -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_mil_levees_pain_plat_du_matin">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte levée de farine de mil façonnée en boules, aplatie en galettes de 1,5 cm, cuites 6 à 8 minutes de chaque côté à couvert sur poêle sèche.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Mil Levées (Pain Plat du Matin)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_sorgho_sucrees_au_sesame -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_de_sorgho_sucrees_au_sesame">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Griller le sésame. Mélanger farine de sorgho, sésame, sucre, sel, beurre de karité et eau. Façonner en galettes fines. Cuire à sec 4 min de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">8</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes de Sorgho Sucrées au Sésame</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_fourrees_a_la_confiture_de_mangue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_fourrees_a_la_confiture_de_mangue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mélanger farine, sucre, sel ; incorporer le beurre de karité du bout des doigts jusqu&apos;à texture sablée. Ajouter l&apos;oeuf et un peu d&apos;eau froide, rassembler en boule, réfrigérer 20 min. Découper des disques de 8 cm, garnir de confiture, couvrir d&apos;un autre disque, pincer les bords. Cuire en marmite-four à feu doux 20 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes Fourrées à la Confiture de Mangue</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_moelleuses_banane_pour_enfants -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_moelleuses_banane_pour_enfants">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bananes écrasées mélangées à farine, oeuf, cannelle et sel, cuites en petites galettes de 5 cm à la poêle huilée, 3 min par face.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes Moelleuses Banane pour Enfants</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_touareg_au_sel_de_taoudeni -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_galettes_touareg_au_sel_de_taoudeni">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de la pâte de désert (pétrissage 5 min, repos 15 min), façonnage en galettes rondes de 8 cm, cuisson dans les braises 8 à 10 min en retournant à mi-cuisson</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Galettes Touareg au Sel de Taoudeni</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gapal -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gapal">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Yaourt maison (lait en poudre reconstitué et fermenté) fouetté avec de la pâte de petit mil pilé, sucré. Contact: Restaurant Grâce divine, Mme Ouedraogo Fatimata.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gapal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_d_anniversaire_burkinabe_au_sorgho -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_d_anniversaire_burkinabe_au_sorgho">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de sorgho et blé battue avec oeufs, sucre et beurre karité, cuite en marmite couverte 50 minutes, démoulée, lustrée au miel et décorée de fruits tropicaux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau d&apos;Anniversaire Burkinabé au Sorgho</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_bapteme_traditionnel_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_bapteme_traditionnel_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de sorgho, maïs et niébé battue avec oeufs, sucre et beurre karité, cuite en marmite couverte 45 minutes, démoulée et lustrée au miel avec sésame.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau de Baptême Traditionnel Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_mil_au_miel_pour_celebration -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_mil_au_miel_pour_celebration">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mélange des ingrédients secs et humides, cuisson au four 175°C 35-40 min (ou à la vapeur 30 min), glaçage au miel chaud</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau de Mil au Miel pour Célébration</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_mil_et_arachide_gateau_sans_four -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_mil_et_arachide_gateau_sans_four">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de mil, poudre d&apos;arachide, oeufs, sucre, sel, beurre de karité et levure versée dans un moule posé dans une marmite avec eau, cuite à la vapeur 40 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau de Mil et Arachide (Gâteau Sans Four)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_pain_de_singe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_pain_de_singe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte riz/pulpe de baobab caramélisée au four</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau de pain de singe</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_sesame_et_miel -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_de_sesame_et_miel">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Sésame torréfié 8 minutes, enrobé de miel caramélisé chaud, étalé en couche de 1 cm, refroidi puis découpé en tablettes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau de Sésame et Miel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_fondant_au_cacao_et_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gateau_fondant_au_cacao_et_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fouetter oeufs, jaunes et sucre jusqu&apos;à blanchiment. Ajouter le beurre de karité fondu et le cacao, mélanger. Incorporer la farine et le sel délicatement. Verser dans des tasses ou moules huilés, cuire en marmite-bain-marie couverte à feu doux 12 min (centre légèrement tremblotant). Démouler immédiatement en retournant les tasses.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gâteau Fondant au Cacao et Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gbel_gbel -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gbel_gbel">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de haricot mélangée à l&apos;eau et battue au moins 15 minutes pour une pâte légère, frite au beurre de karité en petites galettes plates blanchâtres, une minute sur chaque face. Se mange accompagné de la salade dounkoum.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">17</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gbel-gbel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gigot_de_mouton_farci_aux_epices -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gigot_de_mouton_farci_aux_epices">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage du gigot, préparation de la farce d&apos;herbes et d&apos;épices, technique de la farce (incisions garnies d&apos;ail et de farce), rôtissage à la braise 1h30 à 2h en retournant toutes les 10 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">90</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gigot de Mouton Farci aux Épices</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gnon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gnon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés puis essorés. Ils sont broyés de sorte à obtenir une semoule moyenne. Les feuilles fraîches de niébé sont lavées, essorées et pilées. La semoule est mélangée aux feuilles pilées et l&apos;ensemble est malaxé avec un peu d&apos;eau potassée. La pâte obtenue est modelée en petites boules qui sont cuites par cuisson à la vapeur. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gnon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gnon_de_fonio_aux_feuilles_de_haricot -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gnon_de_fonio_aux_feuilles_de_haricot">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boules de pâte fonio + feuilles de haricot pilées, cuites vapeur ; « le fonio ne fait jamais honte à la cuisinière »</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gnon de fonio (aux feuilles de haricot)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gnoncon_de_riz -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gnoncon_de_riz">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de haricot pilées, riz lavé et reposé puis pilé et tamisé; grains mélangés aux feuilles pilées et légumes râpés en pâte, façonnée en boules sans trop presser, cuites 40 à 45 minutes à la vapeur. Se sert avec de l&apos;huile ou une sauce tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">70</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gnoncon de riz</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gonre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gonre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont triées, puis lavées et trempées pendant 4 heures. Elles sont ensuite écrasées finement de façon humide (pâte de niébé). Le mil est lavé, séché puis broyé finement. La farine obtenue est subdivisée en 2 parts, 3/4 et 1/4. La petite part (1/4) est mélangée à la pâte humide de niébé. Le tout est malaxé en ajoutant peu à peu de l&apos;eau potassée. La pâte finale doit être molle de sorte à faire des boules. Les boules sont cuites à la vapeur. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gonré</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gonre_surprise -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gonre_surprise">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricot décortiqué et feuilles moulus finement, potassés, mis dans de petits pots avec un quart d&apos;œuf bouilli inséré dans chaque pot, cuits à la vapeur 30 minutes. Se consomme avec sel et huile ou sauce tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gonré surprise</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_grand_mafe_de_b_uf_aux_truffes_africaines -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_grand_mafe_de_b_uf_aux_truffes_africaines">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boeuf saisi par petites quantités puis réservé, oignons, ail confit, tomates et soumbala mijotés 20 min dans le même jus, pâte d&apos;arachide délayée incorporée, viande remise avec champignons réhydratés, mijoté 2h à frémissement doux, truffes/champignons noirs ajoutés en fin de cuisson, sauce montée au beurre de karité froid.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">150</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Grand Mafé de Bœuf aux Truffes Africaines</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_grand_plat_de_riz_aux_7_legumes_de_fete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_grand_plat_de_riz_aux_7_legumes_de_fete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz jollof rouge préparé selon la technique classique, chacun des 7 légumes cuit séparément pour préserver couleur et saveur, dressé en cercle symbolique autour du riz.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Grand Plat de Riz aux 7 Légumes de Fête</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_grande_salade_burkinabee_du_marche_salade_complete_de_fete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_grande_salade_burkinabee_du_marche_salade_complete_de_fete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chaque ingrédient préparé séparément (cuit, grillé), disposé en secteurs distincts dans le plus grand plat de la maison, arrosé de vinaigrette au service.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Grande Salade Burkinabée du Marché (Salade Complète de Fête)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_gratin_de_legumes_a_la_burkinabee_noel_chretien -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_gratin_de_legumes_a_la_burkinabee_noel_chretien">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Patate douce, manioc et courgette tranchés en couches, nappés de sauce oeufs-lait-karité, parsemés de wagashi râpé, cuits à couvert 50 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Gratin de Légumes à la Burkinabée (Noël Chrétien)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_guelboam -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_guelboam">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boulettes de farine de mil cuites dans une soupe de bikalga, calices d&apos;oseille séchée, poisson fumé et soumbala. Contact: Restaurant Les Merveilles de la Savane, Mme Sankara/Nabaloum Safiatou.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Guelboam</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricot_au_gras -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricot_au_gras">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricot mijoté dans une sauce tomate au poisson sec et piment, garni d&apos;œufs durs. Contact: Mme Awetoua Sétou.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricot au gras</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricot_au_mais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricot_au_mais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Maïs cuit à l&apos;eau bouillante 1 heure; haricot bouilli 30 minutes puis potassé et cuit 25 minutes; sauce de viande hachée revenue avec oignons, poivron et tomates, mijotée avec ail et persil. Le haricot et le maïs sont servis accompagnés de la sauce.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">140</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricot au maïs</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricot_aux_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricot_aux_arachides">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricot cuit à l&apos;eau bouillante avec potasse jusqu&apos;à point de cuisson, puis poudre d&apos;arachide ajoutée sans mélanger et cuisson 10 à 15 minutes à feu doux. Peut se consommer avec une sauce tomate, poisson frit ou viande hachée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricot aux arachides</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_niebe_bouillis_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_niebe_bouillis_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tremper les haricots niébé 6h. Cuire 40-50 min. Assaisonner avec sel, cube, ail, oignon, piments, cuire 10 min de plus. Ajouter le beurre de karité en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricots Niébé Bouillis au Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_niebe_cuits_a_la_perfection -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_niebe_cuits_a_la_perfection">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Trempage des haricots 8h minimum, cuisson sans sel 50 à 60 min en écumant, assaisonnement final (sel, cube) 10 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricots Niébé Cuits à la Perfection</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_niebe_epices_au_riz_riz_et_haricots -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_niebe_epices_au_riz_riz_et_haricots">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Sauce de base (oignon, ail, tomates, soumbala, piment) revenue 10 min, niébé pré-cuit et riz lavé ajoutés avec eau (1,5x volume), cuits 15-18 min jusqu&apos;à absorption complète.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricots Niébé Épicés au Riz (Riz et Haricots)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_verts_a_l_huile_d_arachide_legume_economique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_haricots_verts_a_l_huile_d_arachide_legume_economique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricots équeutés et blanchis 3 min, rafraîchis à l&apos;eau froide, sautés à feu vif avec oignon et ail 4 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Haricots Verts à l&apos;Huile d&apos;Arachide (Légume Économique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_homard_du_lac_sauce_bisque_au_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_homard_du_lac_sauce_bisque_au_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Langoustes coupées en deux, carapaces réservées pour la bisque (colorées au four, revenues avec oignon, tomate, soumbala, flambées au dolo, mijotées 30 min, mixées, filtrées, additionnées de crème de coco) ; demi-langoustes cuites chair en bas dans le beurre de karité mousseux 3 min par face.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Homard du Lac Sauce Bisque au Soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_homard_grille_sauce_vierge_a_la_tomate_confite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_homard_grille_sauce_vierge_a_la_tomate_confite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Crustacés badigeonnés de beurre karité, grillés 3 min par face sur braise chaude, servis avec sauce vierge froide aux tomates confites et mangue.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Homard Grillé Sauce Vierge à la Tomate Confite</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_bouillie_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_bouillie_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de l&apos;igname (épluchage, coupe), cuisson à l&apos;eau salée 20 à 25 min, égouttage et assaisonnement au beurre de karité fondu</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Igname Bouillie au Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_braisee_simple_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_braisee_simple_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Igname pelée et tranchée, badigeonnée de beurre de karité, braisée sur braises (8 min/face) ou à la poêle (6 min/face), assaisonnée de sel et piment doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Igname Braisée Simple au Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_pilee_sauce_graine_de_palme -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_pilee_sauce_graine_de_palme">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Igname bouillie puis pilée longuement au mortier jusqu&apos;à obtenir une pâte lisse et élastique formée en boules. Jus de palme extrait des graines fraîches (ou concentré) mijoté avec viande, oignon, tomate, soumbala et piment jusqu&apos;à réduction rouge-orangée brillante.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Igname Pilée Sauce Graine de Palme</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_rotie -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_igname_rotie">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Igname rôtie puis chair pilée au lait/beurre, farcie dans la pelure</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Igname rôtie</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ignames_a_la_tomate -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ignames_a_la_tomate">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Ignames mijotées en sauce tomate-oignon-piment</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ignames à la tomate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_infusion_de_racines_de_kinkeliba_tisane_medicinale -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_infusion_de_racines_de_kinkeliba_tisane_medicinale">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles ou tiges de kinkeliba infusées 15 à 20 minutes dans l&apos;eau bouillante, filtrées puis sucrées.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Infusion de Racines de Kinkeliba (Tisane Médicinale)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_itubani -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_itubani">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de haricot pilé, ail et oignon, potassée et au beurre de karité, enveloppée dans des feuilles de kola (ou de maïs) et cuite à la vapeur ; beignets servis avec sel et huile. Contact: Mme Sabine Kandja, Tél 79 04 00 97.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Itubani</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_d_ananas_frais_au_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_d_ananas_frais_au_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Ananas et gingembre mixés avec eau et sucre, filtrés pour un jus clair et parfumé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus d&apos;Ananas Frais au Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_citron_vert_et_gingembre_tonique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_citron_vert_et_gingembre_tonique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Gingembre râpé pressé dans un tissu pour en extraire le jus, mélangé au jus de citron vert, au miel et à l&apos;eau fraîche.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Citron Vert et Gingembre Tonique</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_ditakh_a_la_menthe_et_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_ditakh_a_la_menthe_et_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Menthe et gingembre mixés avec eau, filtrés pour obtenir un concentré vert, dilué avec eau, sucre et citron vert, puis réfrigéré.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Ditakh à la Menthe et Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_ditakh_fruit_sauvage_du_burkina -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_ditakh_fruit_sauvage_du_burkina">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fruits sauvages mixés avec eau, filtrés pour extraire le jus, puis assaisonnés de sucre ou miel et de citron.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Ditakh (Fruit Sauvage du Burkina)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_gingembre_pimente -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_gingembre_pimente">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Gingembre et piments mixés avec eau, filtrés pour extraire un concentré, dilué avec eau, citron vert et sucre ou miel, puis réfrigéré 30 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Gingembre Pimenté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_goyave_fraiche -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_goyave_fraiche">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Goyaves non pelées mixées avec eau, sucre et citron 2 minutes, puis filtrées impérativement pour retirer les graines.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Goyave Fraîche</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_grenadille_fruit_de_la_passion -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_grenadille_fruit_de_la_passion">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pulpe des grenadilles pressée à travers une passoire avec de l&apos;eau pour extraire le jus, puis sucrée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Grenadille (Fruit de la Passion)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_mangue_fraiche -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_mangue_fraiche">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangues pelées et mixées avec eau, sucre, sel et citron vert jusqu&apos;à purée lisse, servie immédiatement avec glaçons.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Mangue Fraîche</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_maracuja_grenadille_et_mangue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_maracuja_grenadille_et_mangue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangue mixée séparément, pulpe de grenadille passée au tamis, les deux jus assemblés et sucrés.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Maracuja (Grenadille) et Mangue</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_melon_frais_au_basilic -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_melon_frais_au_basilic">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Melon en cubes mixé avec basilic, sucre et citron 1 minute, puis filtré.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Melon Frais au Basilic</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_papaye_gingembre_curcuma -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_papaye_gingembre_curcuma">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Papaye, gingembre, curcuma, miel, citron, eau et poivre noir mixés 1 minute pour une boisson dorée intense.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Papaye-Gingembre-Curcuma</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_pasteque_a_la_menthe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_pasteque_a_la_menthe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pastèque en cubes mixée avec menthe fraîche, citron vert et sucre si besoin, 30 secondes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Pastèque à la Menthe</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_tomate_fraiche_epicee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_de_tomate_fraiche_epicee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tomates, gingembre, piment, céleri, sel, sucre et citron mixés 1 minute puis filtrés.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus de Tomate Fraîche Épicée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_vert_de_moringa_et_concombre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_jus_vert_de_moringa_et_concombre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Moringa, concombre, citron, miel, sel et eau mixés 2 minutes puis filtrés pour un jus vert clair.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Jus Vert de Moringa et Concombre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kafukduga_ou_baniguila -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kafukduga_ou_baniguila">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de sorgho sont décortiqués, lavés et épierrés puis trempés pendant 3 heures. Ils sont ensuite essorés. De l&apos;eau est portée à ébullition et les grains de sorgho sont ajoutés. Le tout est laissé à cuisson jusqu&apos;au ramollissement des grains. L&apos;ensemble est mélangé à l&apos;aide d&apos;une spatule jusqu&apos;à obtenir une pâte ferme. Consommé chaud avec de l&apos;huile et du sel ou avec une sauce de pâte d&apos;arachide.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kafukduga ou Baniguila</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kalbeinga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kalbeinga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bouillie de farine de haricot cuite avec poudre de poisson sec en eau potassée, servie accompagnée de beurre de karité. Contact: Restaurant Slow Food, Mme Sankara/Nabaloum Safiatou.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kalbeinga</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kalbenga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kalbenga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont lavées puis épierrées avant d&apos;être grossièrement écrasées. La semoule obtenue est tamisée. Les résidus sont à nouveau vannés pour éliminer les enveloppes et la farine fine. Ces résidus sont mélangés avec la farine fine de niébé obtenue après tamisage. De l&apos;eau est portée à ébullition et le mélange est ajouté dans l&apos;eau bouillante en remuant à l&apos;aide d&apos;une louche jusqu&apos;à obtenir une bouillie. Ajouter de l&apos;eau potassée de sorte à bien ressentir le goût de la potasse ; laisser cuire pendant quelques minutes. Le Kalbenga se présente sous la forme d&apos;une bouillie épaisse. Consommé en ajoutant une boule de beurre de karité ou de l&apos;huile végétale.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kalbenga</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kalombayaare -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kalombayaare">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de petit mil écrasé mélangée à des feuilles de haricot pilées, oignon, ail et potasse, cuite à la vapeur puis servie avec huile et sel. Contact: Mme Thiombiano Soiguilparé, Tél 79 04 00 97.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kalombayaaré</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kalyanga_vine_en_francais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kalyanga_vine_en_francais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Kalyanga séché cuit longuement à l&apos;eau bouillante (env. 6h), rincé, recuit avec soumbala, puis mijoté avec oignons, tomates, poivrons et ail au moins 7 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">407</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kalyanga (Vine en français)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kanzaga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kanzaga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de djambouala et de moringa bouillies au moins 1 heure; feuilles de kanzaga bouillies séparément puis ajoutées; poudre d&apos;arachide et riz concassé mouillé incorporés, laissés 15 minutes puis mijotés 10 minutes à feu doux. Se sert avec du beurre de karité.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">70</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kanzaga</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kemogo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kemogo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont décortiqués, vannés puis lavés et épierrés. Ils sont ensuite broyés finement. La farine fine obtenue est malaxée avec l&apos;eau de Lamboidga (Boscia Senegalensis, obtenue par broyage des jeunes branches puis macération une nuit et filtration) jusqu&apos;à obtenir une pâte ferme. Cette pâte est modelée en boules qui sont cuites à la vapeur. Les boules cuites sont pilées pour obtenir une pâte cuite molle, modelée en grosses boules saupoudrées de farine de mil et laissées à fermentation pendant une nuit. Le kemogo a un goût sucré et est consommé seul ou délayé dans l&apos;eau, le yaourt.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kemogo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kidamai -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kidamai">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz cuit jusqu&apos;à émiettement, mélangé à la farine de maïs jusqu&apos;à obtention d&apos;une pâte consistante, cuite 5 minutes à feu doux et façonnée en boules moyennes. Se mange avec une sauce tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kidamaï</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kidamai_boil_boila_ou_guelbom -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kidamai_boil_boila_ou_guelbom">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés, épierrés puis moulus finement. La farine obtenue est humidifiée et malaxée puis modelée en petites boules. Ces boules sont cuites par immersion dans de l&apos;eau bouillante ou dans une soupe. Consommé avec une sauce tomate ou de l&apos;huile, du sel. Peut également être préparé au gras.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kidamaï (Boil-boila ou Guelbom)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kiengdo_au_pigri -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kiengdo_au_pigri">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de balanites séchées trempées puis longuement bouillies (8h), surmontées de boules de pigri (pâte de mil, arachide, haricot et tourteau de coton moulus), cuisson finale 25 min. L&apos;eau de trempage peut être réutilisée comme eau de cuisson pour conserver les éléments nutritifs. Contact: Mme Bationo Rose, Tél 71 66 39 61.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kiengdo au pigri</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kooko_bouillie_speciale_des_bissa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kooko_bouillie_speciale_des_bissa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Réhydratation des feuilles de haricot séchées, broyage du sésame grillé, cuisson de la bouillie de base 15 min, incorporation des éléments Bissa (sésame, feuilles, lait fermenté, sucre)</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kôoko — Bouillie Spéciale des Bissa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_koro_korodoro_ou_to_bobo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_koro_korodoro_ou_to_bobo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de sorgho blanc accompagné d&apos;une sauce de feuilles de cléome bouillies enrichie de poudre d&apos;arachide. Contact: Restaurant Le Prestige 2, Mme Foro G. Léontine.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Koro-korodoro ou To Bôbô</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kouign_de_sesame_gateau_breton_africanise -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kouign_de_sesame_gateau_breton_africanise">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparer une pâte levée avec farine, levure, sucre, sel et eau ; laisser lever 1h. Étaler en rectangle, étaler le beurre de karité ramolli, saupoudrer de sucre et sésame, plier en 3, répéter l&apos;opération. Mettre en moule, laisser lever 30 min, cuire en marmite couverte à feu doux 35 min jusqu&apos;à dorure et caramélisation du sucre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kouign de Sésame (Gâteau Breton Africanisé)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_kounzou_soupe_epaisse_des_dagara -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_kounzou_soupe_epaisse_des_dagara">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation des feuilles sauvages et des haricots, pâte de maïs, base aromatique 5 min, construction du kounzou (pâte de maïs + haricots 10 min), finition aux feuilles et au poisson 10 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Kounzou — Soupe Épaisse des Dagara</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_koura_koura -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_koura_koura">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Arachides grillées environ 10 minutes, débarrassées de leur pellicule, salées et moulues en pâte. Pâte dégraissée sur le feu, façonnée à trois doigts puis frite jusqu&apos;à coloration dorée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Koura koura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_l_igname_d_arbolle_au_ragout -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_l_igname_d_arbolle_au_ragout">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyer la viande et laver les ingrédients. Faire chauffer l&apos;huile et faire revenir la viande, ajouter les ingrédients et un litre d&apos;eau, cuire à feu doux 10 à 15 minutes. Éplucher l&apos;igname, couper en morceaux, bien laver, ajouter au bouillon et laisser cuire 15 minutes. Servir. (&quot;Ya noogo!&quot; = c&apos;est bon ! en langue Moorè)</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : L&apos;igname d&apos;Arbollé au ragoût</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_la_recette_n_400_marmite_de_l_empire_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_la_recette_n_400_marmite_de_l_empire_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Recette symbolique clôturant le recueil, réunissant en une marmite les ingrédients et techniques emblématiques du terroir burkinabè, préparée pour 40 personnes lors d&apos;une grande célébration.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : La Recette N°400 — Marmite de l&apos;Empire Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_lait_de_karite_boisson_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_lait_de_karite_boisson_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Beurre de karité émulsionné avec de l&apos;eau très chaude fouettée vigoureusement, puis sucré et épicé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Lait de Karité (Boisson au Beurre de Karité)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_gnon_de_fonio_aux_feuilles_de_haricot -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_gnon_de_fonio_aux_feuilles_de_haricot">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver les feuilles de haricots à grande eau, égoutter, piler ou malaxer, ajouter la potasse. Ajouter le fonio étuvé, la poudre d&apos;arachide, le sel, les oignons émincés et l&apos;ail écrasé. Mélanger, laisser reposer, rajouter un peu d&apos;eau. Préparer le couscoussier, dès ébullition faire des boules, les disposer dans le couscoussier, fermer hermétiquement et laisser cuire à point. Servir avec de l&apos;huile d&apos;arachide, le beurre de karité ou une sauce tomate. Proverbe : &quot;le fonio ne fait jamais honte à la cuisinière&quot; ; il ne s&apos;accompagne jamais de mil.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le gnon de fonio aux feuilles de haricot</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_gonre_a_la_viande -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_gonre_a_la_viande">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Enlever le son du niébé en le pilant au mortier avec un peu d&apos;eau, étaler à l&apos;air libre ou au soleil une heure, vanner, laver, plonger dans l&apos;eau 15 minutes, laver plusieurs fois pour retirer l&apos;odeur, l&apos;extrémité noire et les cailloux. Ajouter les fanes d&apos;oignon, l&apos;ail, le persil, mixer, malaxer la pâte en ajoutant petit à petit de l&apos;eau. Ajouter le yaourt, asperger d&apos;huile et cuire 15 minutes à la vapeur. Servir avec l&apos;huile ou la viande hachée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le gonré à la viande</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_koura_koura -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_koura_koura">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Biscuit et également condiment à base d&apos;arachide. Décortiquer les gousses d&apos;arachide sèches, les griller dans une marmite pour faciliter le décollement de la peau, retirer la peau et vanner sur une natte. Écraser les graines pour obtenir une pâte, ajouter de l&apos;eau chaude et mélanger jusqu&apos;à obtenir une pâte homogène qui fait remonter l&apos;huile. Recueillir l&apos;huile pour cuire des anneaux de pâte d&apos;arachide. Le biscuit se mange tel quel ; les enfants le portent en bracelets à cause de leur forme amusante.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le koura-koura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_pampara -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_pampara">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mettre la farine dans une terrine, ajouter l&apos;eau petit à petit pour obtenir une consistance un peu plus épaisse qu&apos;une pâte à crêpe. Ajouter éventuellement la poudre de gombo ou de baobab. Verser dans une poêle sur le feu, retourner pour griller l&apos;autre face. Lorsque les deux faces sont dorées, découper, ajouter huile et sel ou une sauce à base d&apos;oignon et de viande hachée. Servir chaud.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le Pampara</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_riz_yala_yala_au_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_riz_yala_yala_au_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver tous les ingrédients. Préparer le bouillon avec les ingrédients et 1,5 litre d&apos;eau. À ébullition, mettre le poisson fumé, les légumes et le soumbala en grumeaux sans piler, laisser cuire à feu moyen. Quand les légumes sont cuits, les retirer et mettre le riz lavé. Cuire à feu doux 20 à 30 minutes pour que le riz soit cuit sans être pâteux. Servir le riz en mettant les légumes dessus.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le riz yala yala au soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_to_de_riz_rouge_a_la_sauce_sesame_et_au_poisson_fume -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_to_de_riz_rouge_a_la_sauce_sesame_et_au_poisson_fume">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de riz rouge : mettre l&apos;eau à chauffer, à ébullition laver le riz et le cuire, malaxer avec la spatule pour obtenir une pâte homogène, couvrir puis mettre dans des petits pots huilés. Sauce : torréfier le sésame et le moudre au mortier, faire revenir les oignons et la pâte de sésame dans l&apos;eau bouillante, ajouter le concentré de tomate, le sel et le poisson fumé, laisser mijoter environ une heure.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">1</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le tô de riz rouge à la sauce sésame et au poisson fumé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_le_to_de_sorgho -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_le_to_de_sorgho">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Piler les grains de sorgho décortiqués, vannés, lavés et séchés. Faire bouillir 1 litre d&apos;eau. Mélanger 1/3 de la farine de sorgho à 0,5 litre d&apos;eau pour obtenir une crème, l&apos;ajouter à l&apos;eau bouillante en remuant jusqu&apos;à obtenir une bouillie légère et homogène. Ajouter le reste de la farine et cuire 20 min jusqu&apos;à ce que la pâte se détache de la marmite. Proverbe mossi : il est interdit de manger le tô sans sauce (&quot;sagbo ka wim yè, kissa min&quot;).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Le tô de sorgho</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_legumes_sautes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_legumes_sautes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes (aubergine, carottes, petits pois, poivrons, choux) nettoyés, découpés et cuits séparément à la vapeur, puis mélangés au beurre fondu et au soumbala, salés, et accompagnés d&apos;une sauce au poisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Légumes sautés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_les_beignets_de_lentilles_de_terre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_les_beignets_de_lentilles_de_terre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de lentilles sont écrasées pour obtenir une farine. On ajoute de l&apos;eau pour en faire une pâte qui sera frite sous forme de petites boules dans du beurre de karité pour obtenir des beignets.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Les beignets de lentilles de terre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_les_boulettes_de_petit_mil_n_yeri_boalboalla -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_les_boulettes_de_petit_mil_n_yeri_boalboalla">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyer la viande et laver les ingrédients. Faire revenir la viande dans l&apos;huile, ajouter les ingrédients et un litre d&apos;eau, cuire à feu doux 10 à 15 minutes. Verser la farine de petit mil dans un récipient avec 10 à 15 cuillerées d&apos;eau, ajouter une pincée de sel, malaxer et former des boulettes. Verser les boulettes dans le bouillon et laisser mijoter 15 minutes. Servir avec la viande et un peu de bouillon (l&apos;eau de cuisson ne doit pas s&apos;évaporer complètement).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Les boulettes de petit mil N&apos;yeri (Boalboalla)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_macedoine_de_legumes_mayonnaise -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_macedoine_de_legumes_mayonnaise">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes coupés en dés réguliers cuits ensemble environ 10 minutes avec un bouquet garni, refroidis, liés à la mayonnaise et dressés avec salade, oeufs durs et tomates.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Macédoine de Légumes Mayonnaise</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mafe_economique_au_b_uf_sauce_arachide_viande -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mafe_economique_au_b_uf_sauce_arachide_viande">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boeuf saisi puis retiré, oignons, tomates, soumbala et ail revenus dans le même jus, viande remise et cuite 45 min à couvert, pâte d&apos;arachide délayée incorporée avec manioc et patate douce, cuisson 30 min supplémentaires.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">90</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mafé Économique au Bœuf (Sauce Arachide Viande)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_magret_de_canard_sauvage_au_miel_et_poivre_long -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_magret_de_canard_sauvage_au_miel_et_poivre_long">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Peau quadrillée, cuisson côté peau 12-15 min en poêle froide, côté chair 3 min, glaçage au miel 30s, sauce déglacée au tamarin et soumbala montée au beurre karité.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Magret de Canard Sauvage au Miel et Poivre Long</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mais_aux_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mais_aux_arachides">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Maïs bouilli 2 heures jusqu&apos;à éclatement des grains, eau égouttée, poudre d&apos;arachide ajoutée et cuisson 30 minutes à feu doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">150</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Maïs aux arachides</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_malgnoore -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_malgnoore">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont décortiquées, vannées puis finement écrasées. Avec de petites quantités d&apos;eau, la farine est malaxée jusqu&apos;à obtenir une pâte molle. La pâte est modelée en petites boules. De l&apos;eau est introduite dans une casserole puis portée à ébullition. Une fois à ébullition, introduire les boules de niébé et laisser cuire par immersion. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Malgnooré</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_malo_to_ni_benenan -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_malo_to_ni_benenan">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de riz malaxé jusqu&apos;à consistance lisse, servi en boules avec une sauce à base de pâte de sésame, poisson sec et poisson frit, relevée au soumbala. Contact: MC Donald, Monsieur Souleymane Sorgho.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Malo tô ni bènènan</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_malor -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_malor">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande revenue avec légumes coupés, mijotée puis bouillie 20 minutes. Farine de haricot battue en pâte légère, façonnée en petites boules plongées dans la sauce bouillante et cuites 30 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">53</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Malor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mandazi_beignets_leves_triangulaires -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mandazi_beignets_leves_triangulaires">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte levée à la cardamome et noix de coco étalée à 1 cm, découpée en triangles, reposée 15 minutes puis frite 3 minutes de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mandazi (Beignets Levés Triangulaires)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_manegmnore -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_manegmnore">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de haricot battue avec de l&apos;eau en pâte consistante, façonnée en petites boules, cuites à l&apos;eau bouillante 15 minutes. Se consomme avec une petite sauce tomate au poisson ou viande, du sel et de l&apos;huile.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Manegmnoré</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_manioc_bouilli_simplement -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_manioc_bouilli_simplement">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Épluchage du manioc, cuisson à l&apos;eau bouillante 20 à 25 min, égouttage et assaisonnement au beurre de karité ou à l&apos;huile de palme rouge</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Manioc Bouilli Simplement</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_massa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_massa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil ou de sorgho sont lavés, épierrés puis séchés, broyés et la farine tamisée, divisée en une petite part (1/4) et une grande part (3/4). La petite part est délayée dans l&apos;eau pour obtenir du lait de farine, ajouté à l&apos;eau bouillante et laissé cuire un peu, formant une bouillie refroidie. La grande part de farine est ajoutée dans la bouillie refroidie en malaxant, formant une pâte très épaisse laissée à fermenter pendant 12 heures. Dès que la pâte présente des bulles (signe de fermentation), elle est fouettée à la spatule en ajoutant un peu d&apos;eau jusqu&apos;à obtenir une pâte semi liquide. La pâte est cuite en galettes dans une poêle chauffée légèrement huilée. Consommée seule ou accompagnée de lait ou de bouillie.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Massa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_menu_degustation_complet_empire_burkinabe_repas_gastronomique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_menu_degustation_complet_empire_burkinabe_repas_gastronomique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Menu en 6 services (amuse-bouche, entrée froide, soupe, plat principal, fromage africain, dessert) servi sur 4 heures.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">240</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Menu Dégustation Complet Empire Burkinabé (Repas Gastronomique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mets_de_termites_grillees_tradition_des_zones_boisees -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mets_de_termites_grillees_tradition_des_zones_boisees">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage des termites (tri par flottaison, retrait des ailes), grillage à sec 5 à 8 min, finition à l&apos;huile de karité</descriptionRecette>
        <rdfs:label xml:lang="fr">Recette : Mets de Termites Grillées — Tradition des Zones Boisées</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mil_arrose_au_beurre_de_karite_de_moisson -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mil_arrose_au_beurre_de_karite_de_moisson">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tri et lavage du mil nouveau, cuisson du mil entier 30 min, fonte du beurre de karité, assaisonnement final versé sur le mil cuit</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mil Arrosé au Beurre de Karité de Moisson</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_millet_braise_au_lait -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_millet_braise_au_lait">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Grains de millet secs braisés à sec dans une poêle jusqu&apos;à coloration dorée et léger éclatement, puis enrobés d&apos;huile de karité. Servi tiède avec lait fermenté, miel ou sucre et arachides pilées.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Millet Braisé au Lait</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mini_brochettes_de_poulet_pour_fete_d_anniversaire -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mini_brochettes_de_poulet_pour_fete_d_anniversaire">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cubes de poulet marinés 30 min dans sauce tomate, miel, gingembre et soumbala, enfilés sur brochettes (3-4 cubes), cuits au four (200°C, 15 min) ou à la poêle (6 min par face).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mini-Brochettes de Poulet pour Fête d&apos;Anniversaire</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_moelleux_au_chocolat_et_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_moelleux_au_chocolat_et_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chocolat et beurre karité fondus ensemble à 50°C, incorporés aux oeufs et sucre battus puis à la farine, cuits en ramequins 11 minutes exactement pour un coeur coulant.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">11</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Moelleux au Chocolat et Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mousse_de_papaye_a_la_noix_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mousse_de_papaye_a_la_noix_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Crème de coco réfrigérée fouettée en chantilly, purée de papaye sucrée incorporée délicatement, versée en coupes et réfrigérée 1 heure.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mousse de Papaye à la Noix de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mouton_de_la_tabaski_plat_de_fete_islamique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mouton_de_la_tabaski_plat_de_fete_islamique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mouton entier mariné toute la nuit (ail, gingembre, piment, soumbala, cumin), rôti sur braises 3 à 4 heures, badigeonné de beurre karité toutes les 20 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">210</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mouton de la Tabaski (Plat de Fête Islamique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mouton_entier_roti_a_la_braise_tabaski -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mouton_entier_roti_a_la_braise_tabaski">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage et préparation du mouton (citron, frottage), pilage ail-gingembre-épices en pâte, marinade appliquée sous la peau et à l&apos;intérieur (3h min, idéalement une nuit), montage sur broche, rôtissage à la braise 2h30 à 3h en tournant toutes les 10-15 min et badigeonnant d&apos;huile</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">150</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mouton Entier Rôti à la Braise (Tabaski)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_muabou_de_mais_a_la_sauce_potassee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_muabou_de_mais_a_la_sauce_potassee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Muabou (tô) de maïs fermenté, moulu et cuit en boules, servi avec une sauce potassée à base de feuilles de haricot, gombo, viande, soumbala et levure locale (rabilé). Contact: Mme Tiombiano Marceline, Tél 61 34 41 51.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Muabou de maïs à la sauce potassée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_muabou_de_petit_mil_a_la_sauce_feuille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_muabou_de_petit_mil_a_la_sauce_feuille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Muabou (tô) de petit mil fermenté 3 jours, moulu et cuit en boules, accompagné d&apos;une sauce de feuilles d&apos;aubergine locale et d&apos;amarante au poisson et à la viande. Contact: Mme Tiombiano Marceline, Tél 61 34 41 51.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Muabou de petit mil à la sauce feuille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mugdugu -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mugdugu">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés et épierrés puis séchés. Ils sont ensuite torréfiés puis finement écrasés. Les graines d&apos;arachide sont triées puis torréfiées jusqu&apos;à obtenir une coloration brune. Les grains de mil et d&apos;arachide torréfiés (1 kg de mil pour 0,75 kg d&apos;arachides), le sucre, le sel et les épices sont mélangés puis broyés pour donner une farine collante de couleur brune, modelée en petites boules.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mugdugu</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mui_mui -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mui_mui">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de pois de terre délayée avec eau et potasse en pâte liquide, versée dans des sachets plastiques et cuite à l&apos;eau bouillante 30 minutes. Se consomme avec une petite sauce tomate au poisson ou à la viande, du sel et de l&apos;huile.</descriptionRecette>
        <descriptionRecette xml:lang="fr">Pâte fine de haricot décortiqué mélangée à la potasse et au beurre de karité, cuite en sachets à la vapeur, servie avec sel, huile ou sauce tomate. Contact: Mme Sabine Kandja, Tél 79 04 00 97.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mui-mui</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_mung_bean_au_gras -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_mung_bean_au_gras">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mung bean mijoté dans un bouillon de bœuf assaisonné (poivre, sel, oignon, carotte, ail, vinaigre) et servi avec filet de bœuf. Contact: Mr André Bayala, Tél 78 23 76 88.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Mung bean au gras</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_nectar_de_mangue_sauvage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_nectar_de_mangue_sauvage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangues pelées et mixées avec eau, filtrées si nécessaire, ajustées en sucre et citron, puis réfrigérées.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Nectar de Mangue Sauvage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_noag_lad_beogo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_noag_lad_beogo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Couscous de maïs et de riz montés plusieurs fois à la vapeur en alternance avec aspersion d&apos;eau; mil et sorgho bouillis puis passés à la vapeur; poulet cuit à l&apos;eau avec soumbala; le tout dressé et garni de concombre, carotte et poivron.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Noag lad béogo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_nono_frais_lait_fermente_peul -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_nono_frais_lait_fermente_peul">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lait porté à ébullition puis refroidi à tiède, ensemencé avec du yaourt ou du nono existant, laissé fermenter 8 à 12 heures puis brassé pour une consistance homogène.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Nono Frais (Lait Fermenté Peul)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_omelet_riz_omelette_sur_riz -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_omelet_riz_omelette_sur_riz">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oeufs battus versés sur oignon et tomate revenus dans l&apos;huile, cuits à feu moyen jusqu&apos;à prise, pliés, posés sur le riz chaud.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Omelet Riz (Omelette sur Riz)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_omelette_burkinabee_au_piment -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_omelette_burkinabee_au_piment">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Battre les œufs avec cube, sel, poivre. Ajouter les légumes. Cuire dans l&apos;huile chaude 3 min sans remuer puis retourner et cuire 2 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Omelette Burkinabée au Piment</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_d_arachide_sans_four -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_d_arachide_sans_four">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Activer la levure dans l&apos;eau tiède sucrée 10 min. Mélanger farine, poudre d&apos;arachide et sel. Pétrir avec la levure et l&apos;huile 10 min en ajoutant l&apos;eau tiède progressivement. Laisser lever 1h30. Verser la pâte dans un moule huilé, cuire à la vapeur dans une marmite couverte hermétiquement 40 min. Démouler tiède.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pain d&apos;Arachide sans Four</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_de_mil_artisanal -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_de_mil_artisanal">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de farine de mil et de blé pétrie avec levure activée, sel, sucre et huile, levée 1h30, façonnée puis levée 45 min de plus, cuite au four à 200°C ou en cocotte 35 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pain de Mil Artisanal</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_de_singe_pain_au_fruit_de_baobab -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_de_singe_pain_au_fruit_de_baobab">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Dissoudre la pulpe de baobab dans 100 ml d&apos;eau tiède, filtrer pour retirer les fibres. Mélanger farine, levure, sel ; ajouter oeufs, miel, beurre de karité fondu et le jus de pulpe de baobab jusqu&apos;à pâte homogène, légèrement acide. Verser dans un moule huilé, cuire à la vapeur 35 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pain de Singe (Pain au Fruit de Baobab)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_perdu_a_la_mangue_caramelisee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pain_perdu_a_la_mangue_caramelisee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tranches de pain trempées dans l&apos;appareil oeuf-lait-vanille, dorées à la poêle, puis surmontées de tranches de mangue caramélisées au sucre et gingembre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pain Perdu à la Mangue Caramélisée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pancakes_de_banane_et_avoine_pour_dimanche -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pancakes_de_banane_et_avoine_pour_dimanche">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bananes écrasées mélangées avec flocons, farine, oeufs battus, lait, levure, sel et cannelle, cuits en pancakes à la poêle jusqu&apos;à apparition de bulles, 2 min par face.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pancakes de Banane et Avoine pour Dimanche</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_patate_douce_rotie_sur_braise -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_patate_douce_rotie_sur_braise">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lavage des patates douces entières, cuisson dans les braises chaudes 40 à 50 min (ou au four 200°C 45-50 min), repos 5 min et découpe</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Patate Douce Rôtie sur Braise</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_patates_douces_bouillies_au_sucre_de_canne -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_patates_douces_bouillies_au_sucre_de_canne">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éplucher et couper les patates douces. Cuire à l&apos;eau salée et sucrée 20-25 min. Servir avec lait fermenté, miel ou noix de coco.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Patates Douces Bouillies au Sucre de Canne</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pate_de_fete_aux_arachides_et_sesame_tiguadegue_ceremoniel -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pate_de_fete_aux_arachides_et_sesame_tiguadegue_ceremoniel">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Arachides pilées collectivement au mortier en chantant jusqu&apos;à obtenir une pâte, sésame torréfié incorporé, sucre roux, miel et beurre karité ajoutés, moulée en formes symboliques.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pâte de Fête aux Arachides et Sésame (Tiguadègue Cérémoniel)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pate_de_mais_bobo_fing_specialite_bobo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pate_de_mais_bobo_fing_specialite_bobo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Torréfaction du maïs si besoin (10 min), préparation de la pâte, cuisson de la bouillie de base 5 min, incorporation de la farine torréfiée sèche en pilonnant 15 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pâte de Maïs Bobo-Fing — Spécialité Bobo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pate_de_mil_to_variante_generale -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pate_de_mil_to_variante_generale">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine délayée puis cuite en pâte homogène ; plat d&apos;origine bambara selon le document</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pâte de mil / Tô (variante générale)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pates_de_ble_a_la_sauce_tomate_locale -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pates_de_ble_a_la_sauce_tomate_locale">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon caramélisé au beurre de karité 15 min, tomates écrasées ajoutées et cuites 15 min avec ail, soumbala, piment et sel; pâtes cuites à l&apos;eau bouillante salée et mélangées à la sauce.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pâtes de Blé à la Sauce Tomate Locale</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_piga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_piga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Petites boules de pâte de farine de mil et arachide, potassée, cuites à la vapeur ; peuvent contenir un œuf au centre. Contact: Mme Beremwoudgou, Tél 79 94 82 30.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Piga</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pigga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pigga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil (1 kg) sont lavés puis séchés et moulus grossièrement en semoule moyenne. Les graines de coton (200 g) sont décortiquées et vannées avant d&apos;être écrasées en farine fine (en cas d&apos;utilisation de graines d&apos;arachides, elles sont dépelliculées et broyées finement). La semoule de mil est mélangée à la farine de graines de coton ou d&apos;arachides, le mélange malaxé en ajoutant de l&apos;eau potassée pour obtenir une pâte friable, mise à cuisson à la vapeur pendant quelques minutes. Consommé avec un peu d&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pigga</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pintade_rotie_aux_epices_du_terroir -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pintade_rotie_aux_epices_du_terroir">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage de la pintade, marinade aux épices du terroir 3h min ou toute la nuit, rôtissage à la braise 50-60 min (en tournant toutes les 10 min) ou au four 180°C pendant 1h</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pintade Rôtie aux Épices du Terroir</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pintade_royale_farcie_aux_dattes_et_amandes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pintade_royale_farcie_aux_dattes_et_amandes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farce (oignon, dattes, amandes sautés au karité, couscous de mil, herbes, miel, sel, poivre) préparée et farcie dans la pintade bridée, badigeonnée de beurre de karité et rôtie 20 min/500g en beurrant toutes les 20 min, repos 15 min avant découpe.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">100</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pintade Royale Farcie aux Dattes et Amandes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_plat_de_babenda_aux_feuilles_d_amarante_d_oseille_et_de_cleome -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_plat_de_babenda_aux_feuilles_d_amarante_d_oseille_et_de_cleome">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les feuilles d&apos;amarante, d&apos;oseille et de cleome. Laver le riz et le tremper 15 min. Porter l&apos;eau à ébullition, mettre les feuilles d&apos;amarante. Laisser cuire 37 min puis ajouter les feuilles de cleome. Après 30 min de cuisson mettre les feuilles d&apos;oseille. 27 min après ajouter le riz puis la potasse. Laisser cuire 10 min puis mettre la poudre d&apos;arachide. Laisser cuire 15 min. Le plat peut se consommer seul, avec une sauce tomate ou accompagné de tô ou de riz. Teneur en matière sèche : 16,9 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">119</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Plat de babenda aux feuilles d&apos;amarante, d&apos;oseille et de cleome</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_plat_de_babenda_aux_feuilles_d_amarante_et_d_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_plat_de_babenda_aux_feuilles_d_amarante_et_d_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les tigelles des vieilles feuilles d&apos;amarante et d&apos;oseille, laver séparément. Piler les arachides crues, laver le riz. Porter l&apos;eau à ébullition, ajouter les feuilles d&apos;amarante. Après 15 min de cuisson mettre les feuilles d&apos;oseille. Laisser cuire 8 min puis ajouter le riz. Attendre 15 min de cuisson puis ajouter la poudre d&apos;arachide, bien mélanger et laisser cuire 15 min. Se consomme seul ou accompagné de tô ou de riz. Teneur en matière sèche : 23,5 g/100 g de produit, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">53</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Plat de babenda aux feuilles d&apos;amarante et d&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_plateau_degustation_burkinabe_5_specialites_regionales -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_plateau_degustation_burkinabe_5_specialites_regionales">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cinq mini-plats représentant chacun une région, disposés en compartiments sur un plateau, accompagnés de bissap.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Plateau Dégustation Burkinabé (5 Spécialités Régionales)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poaloanga_saute -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poaloanga_saute">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles séchées de poaloanga bouillies 2 heures à l&apos;eau simple, essorées, puis mijotées avec oignons, tomates, poivrons revenus dans l&apos;huile pendant au moins 7 minutes. Peut être réalisé sans tomate pour garder les feuilles plus vertes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">137</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poaloanga sauté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pog_rogdo_benre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pog_rogdo_benre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil décortiqués sont lavés, épierrés et essorés, puis séchés et grossièrement broyés pour obtenir une semoule moyenne, tamisée pour séparer la farine fine de la semoule. La semoule est légèrement cuite dans l&apos;eau, tandis que la farine fine est délayée dans un peu d&apos;eau et la solution ajoutée à la préparation ; l&apos;ensemble est cuit quelques minutes. La bouillie ne doit pas être trop cuite. Consommée en ajoutant du beurre de karité ou de l&apos;huile végétale, du sucre, du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pog-rogdo-benré</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poisson_frit_en_sauce_tomate_express -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poisson_frit_en_sauce_tomate_express">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mariner le poisson 20 min avec ail, gingembre, piment, sel. Frire 10 min. Préparer une sauce tomate express avec oignon, tomates, piments, soumbala, cube 9 min. Napper le poisson frit de sauce, mijoter 2 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">21</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poisson Frit en Sauce Tomate Express</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_porridge_du_matin_pour_ecoliers -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_porridge_du_matin_pour_ecoliers">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine délayée dans l&apos;eau froide, cuite 10 min en remuant, lait ajouté et remué 3 min, poudre d&apos;arachide, miel, vanille et cannelle incorporés, servi avec rondelle de banane.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Porridge du Matin pour Écoliers</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_porridge_sante_de_sorgho_aux_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_porridge_sante_de_sorgho_aux_arachides">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Délayer la farine de sorgho dans 1 verre d&apos;eau froide jusqu&apos;à pâte lisse sans grumeaux. Porter 3 verres d&apos;eau à ébullition, verser la pâte de sorgho en remuant, cuire 15 min en remuant constamment jusqu&apos;à porridge épais et lisse. Hors du feu, ajouter la poudre d&apos;arachide, le lait fermenté, le miel, la cannelle et le gingembre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Porridge Santé de Sorgho aux Arachides</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_potage_de_feuilles_de_manioc_sauce_feuilles_economique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_potage_de_feuilles_de_manioc_sauce_feuilles_economique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles jeunes pilonnées ou hachées, cuites 30 min minimum en changeant l&apos;eau une fois pour éliminer le cyanure naturel, puis égouttées et mijotées 15 min avec oignon, soumbala et poisson séché.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Potage de Feuilles de Manioc (Sauce Feuilles Économique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_potage_de_haricots_niebe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_potage_de_haricots_niebe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricots niébé trempés puis cuits longuement, assemblés avec une base aromatique (oignon, ail, tomate, soumbala, huile de palme) et poisson fumé jusqu&apos;à potage épais.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Potage de Haricots Niébé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_a_l_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_a_l_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet et légumes cuits en autocuiseur, liés à la pâte d&apos;arachide</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet à l&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_bandji -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_bandji">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet bouilli dans du bandji (vin de palme) jusqu&apos;à réduction, puis mijoté avec oignon, tomate, poivron, ail, persil, laurier et poivre. Contact: Restaurant Muyu, Mme Poda Claire.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet au bandji</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_bissap -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_bissap">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet mijoté progressivement dans du jus de bissap avec légumes (oignon, tomate, poivron, carotte) et pâte de tomate. Contact: Restaurant Lanaya, Mme Ouaga Alimatou.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet au bissap</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_rabile -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_rabile">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet découpé et revenu dans l&apos;huile. Rabilé (levure locale) trempé dans l&apos;eau puis tamisé, liquide versé sur le poulet et cuit 45 minutes. Légumes et épices ajoutés, mijoté 15 minutes. Accompagnement: frites de pomme de terre, aloco ou pain.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet au rabilé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_soumbala_de_bapteme -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_au_soumbala_de_bapteme">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Dorure du poulet par fournées, préparation de la sauce soumbala (oignon, ail-gingembre, tomates, soumbala, piments, cubes, 12 min), cuisson finale du poulet dans la sauce 25 min puis ajout du gombo 15 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet au Soumbala de Baptême</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_bicyclette -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_bicyclette">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet aplati sur la poitrine et badigeonné de vinaigrette, braisé jusqu&apos;à couleur dorée (40 à 45 minutes), puis découpé et servi barbouillé de la salade d&apos;oignon, poivron et tomate assaisonnée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">43</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet bicyclette</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_bicyclette_braise_poulet_du_village_pour_20_personnes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_bicyclette_braise_poulet_du_village_pour_20_personnes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet de village mariné 3h, saisi en fournées, braisé 2 heures à couvert dans une sauce tomate-soumbala.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">120</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet Bicyclette Braisé (Poulet du Village pour 20 Personnes)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_braise_au_four_a_charbon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_braise_au_four_a_charbon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyer et inciser le poulet. Mariner avec la pâte d&apos;épices au moins 2h. Braiser lentement sur charbon 45 min à 1h en retournant toutes les 10 min et badigeonnant de marinade.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet Braisé au Four à Charbon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_poulet_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet braisé jusqu&apos;à cuisson, soumbala écrasé aspergé sur le poulet en fin de cuisson, salé au goût. Peut s&apos;accompagner de frites de pomme de terre et d&apos;aloco.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Poulet soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_pudding_de_manioc_a_la_vanille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_pudding_de_manioc_a_la_vanille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Manioc râpé cuit 20 minutes avec lait, lait de coco, sucre, vanille et sel en remuant constamment, puis versé en ramequins et réfrigéré 2 heures.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Pudding de Manioc à la Vanille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_puree_de_haricots_rouges_pour_enfants -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_puree_de_haricots_rouges_pour_enfants">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricots cuits 1h dans l&apos;eau non salée jusqu&apos;à tendreté, mélangés à une sauce douce oignon-tomate, mixés longuement jusqu&apos;à purée lisse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">70</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Purée de Haricots Rouges pour Enfants</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_puree_de_niebe_au_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_puree_de_niebe_au_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Base aromatique à l&apos;oignon et au soumbala revenus à l&apos;huile, ajout des haricots niébé cuits et de leur eau de cuisson, mijotage puis écrasage partiel pour une texture rustique.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Purée de Niébé au Soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_puree_de_patate_douce_et_lait_7_8_mois -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_puree_de_patate_douce_et_lait_7_8_mois">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cubes de patate douce cuits à la vapeur 15 min puis mixés avec le lait jusqu&apos;à purée lisse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Purée de Patate Douce et Lait (7-8 Mois)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_d_igname -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_d_igname">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Morceaux d&apos;igname mijotés environ 30 minutes avec du poulet dans une sauce tomate aux légumes (carotte, poivron, oignon). Contact: Restaurant Lanaya, Mme Ouaga Alimatou.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ragoût d&apos;igname</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_de_crapaud_b_uf_des_gourounsi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_de_crapaud_b_uf_des_gourounsi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage des grenouilles, cuisson préliminaire (dorure 2 min de chaque côté), base et ragoût (oignon, ail, gingembre, tomates, soumbala, piments 8 min), finition délicate 10 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">24</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ragoût de Crapaud-Bœuf des Gourounsi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_de_legumes_doux_pour_toute_la_famille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_de_legumes_doux_pour_toute_la_famille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon et ail revenus, tomates ajoutées, légumes durs (carotte, patate) puis bouillon, cuits 10 min, courgette et haricots verts ajoutés, cuisson 8 min de plus. Servi sur riz blanc, piment à part pour adultes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ragoût de Légumes Doux pour Toute la Famille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_de_pomme_de_terre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_ragout_de_pomme_de_terre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Ragoût de pomme de terre et carotte mijoté avec viande, tomate, poivron, soumbala et épices. Contact: Restaurant Faso-Rissogo, Mme Savadogo Binta.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Ragout de Pomme de terre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_repas_complet_bebe_mil_legumes_poisson_12_mois -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_repas_complet_bebe_mil_legumes_poisson_12_mois">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Petit tô de mil très lisse, arrosé de sauce légumes, garni de poisson émietté et fini à l&apos;huile de karité crue.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Repas Complet Bébé Mil-Légumes-Poisson (12 Mois)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_risotto_de_fonio_aux_champignons_sauvages -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_risotto_de_fonio_aux_champignons_sauvages">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Champignons hachés et sautés jusqu&apos;à évaporation de l&apos;eau ; échalotes et ail suées au beurre de karité, fonio nacré 2 min, déglacé au dolo, bouillon ajouté louche par louche en remuant 18-20 min ; monté hors du feu au beurre de karité froid et au fromage wagashi.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Risotto de Fonio aux Champignons Sauvages</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_gras_de_fete_riz_wendo_de_ceremonie -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_gras_de_fete_riz_wendo_de_ceremonie">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyer les viandes au citron, laver le riz. Dorer le mouton puis le poulet. Construire la base sauce avec oignons, ail-gingembre, tomates, soumbala, piments, cubes 15 min. Cuire les viandes dans la sauce 20 min avec l&apos;eau. Ajouter le riz, carottes, poivron, cuire à couvert 20 min. Laisser reposer 10 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">65</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz au Gras de Fête (Riz Wêndo de Cérémonie)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_lait_a_la_cannelle_et_noix_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_lait_a_la_cannelle_et_noix_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz cuit 35-40 minutes dans le lait, lait de coco, sucre, sel et cannelle jusqu&apos;à texture épaisse et crémeuse, puis vanillé, réfrigéré et décoré de noix de coco.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz au Lait à la Cannelle et Noix de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_lait_vanille_pour_petits -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_lait_vanille_pour_petits">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz rincé cuit dans le lait à feu doux 35 min en remuant régulièrement, sucre, vanille et cannelle ajoutés en fin de cuisson, repos 5 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz au Lait Vanille pour Petits</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_poulet_entier_de_noces -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_poulet_entier_de_noces">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage et marinade des poulets entiers 2h min, dorure des poulets, préparation de la sauce/riz, cuisson riz+poulets 20 min à couvert, finition de prestige</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">160</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz au Poulet Entier de Noces</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_safran_africain_curcuma -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_safran_africain_curcuma">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lavage du riz, base aromatique au curcuma (oignon, ail, curcuma), cuisson du riz coloré 18 min puis repos 5 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">23</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz au Safran Africain (Curcuma)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_au_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz cuit dans un bouillon de viande relevé au soumbala, avec aubergine locale, chou, laurier et piment. Contact: Mme Somda Monique, Tél 70 32 63 35.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz au soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_aux_haricots_niebe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_aux_haricots_niebe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricots niébé trempés puis précuits, cuits ensemble avec le riz. Sauce d&apos;accompagnement à base de tomate, oignon, soumbala et poisson séché ou viande bouillie servie à part ou par-dessus.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz aux Haricots Niébé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_blanc_sauce_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_blanc_sauce_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz blanc cuit à l&apos;eau salée. Sauce à base d&apos;oignon revenu, tomate et soumbala pilé, mijotée avec le poisson (frais ou fumé) jusqu&apos;à réduction.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Blanc Sauce Soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_blanc_vapeur_parfait -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_blanc_vapeur_parfait">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lavage du riz, cuisson par absorption (méthode burkinabè) à couvert sur feu minimal 18 min sans ouvrir, repos 5 min puis égrenage à la fourchette</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Blanc Vapeur Parfait</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_cantonnais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_cantonnais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz étuvé cuit dans un bouillon de viande épicé, mélangé à petits pois, maïs, haricot vert, carotte, betterave et saucisson. Contact: Restaurant La Fraternité, Mme Gnoumou Angèle.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz cantonnais</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_complet_au_curcuma_et_legumes_verts -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_complet_au_curcuma_et_legumes_verts">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz complet trempé 2h, revenu avec oignon, ail et curcuma, cuit à l&apos;eau chaude 40-45 min, légumes verts ajoutés 10 min avant la fin avec poivre noir.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Complet au Curcuma et Légumes Verts</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_djolof_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_djolof_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Sauce tomate épicée mijotée avec oignon, ail, gingembre et épices, puis riz lavé cuit dedans à couvert 20 minutes avec montée du feu en fin de cuisson pour obtenir un fond légèrement caramélisé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Djolof Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_garba_riz_friture_au_thon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_garba_riz_friture_au_thon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cuire le riz blanc à l&apos;eau salée 18 min. Frire le thon émietté 5 min. Préparer la sauce tomate avec oignon, tomates, piments, soumbala, cube 13 min et y remettre le thon. Préparer une sauce fraîche tomates-oignon-piment en accompagnement.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">36</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Garba (Riz Friture au Thon)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_gluant_a_la_mangue_sauvage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_gluant_a_la_mangue_sauvage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz gluant trempé 2 heures puis cuit à couvert dans un mélange de lait de coco, eau, sucre et sel jusqu&apos;à absorption totale, servi avec des dés de mangue confits au sucre et citron vert.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Gluant à la Mangue Sauvage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_gras_a_la_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_gras_a_la_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Le poulet est doré à l&apos;huile puis retiré. La sauce base (oignon, ail-gingembre, tomate, piment) mijote, le poulet et le riz lavé y sont ajoutés avec de l&apos;eau chaude, puis le tout cuit à l&apos;étouffée à couvert jusqu&apos;à formation d&apos;une croûte dorée au fond.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Gras à la Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_jollof_de_mariage_grand_format -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_jollof_de_mariage_grand_format">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Sauce tomate montée en grande marmite avec oignons, ail, gingembre, soumbala; viande dorée ajoutée; riz lavé cuit dans la sauce 25 min; légumes ajoutés les 10 dernières minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Jollof de Mariage Grand Format</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_jollof_economique_version_budget -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_jollof_economique_version_budget">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Concentré de tomate frit à sec puis oignons, tomates fraîches et ail ajoutés et cuits 15 min ; riz lavé ajouté directement dans la sauce avec bouillon, sel, laurier, cuit à couvert 20 min ; légumes ajoutés les 5 dernières minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Jollof Économique (Version Budget)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_parfume_au_lait_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_parfume_au_lait_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation du lait de coco frais si besoin, lavage du riz, cuisson par absorption 18 min à couvert, repos 5 min et égrainage</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">23</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Parfumé au Lait de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_pilaf_aux_epices_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_pilaf_aux_epices_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande de mouton marinée aux épices (cumin, coriandre, poivre, piment) puis saisie. Riz cuit à l&apos;étouffée avec la viande et une base tomate-oignon, parfumé de raisins secs, décoré de coriandre fraîche.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Pilaf aux Épices Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz blanc cuit à l&apos;eau salée. Viande dorée puis mijotée dans une base tomate-oignon-soumbala, à laquelle la pâte d&apos;arachide diluée est incorporée en remuant sans arrêt pour éviter les grumeaux, puis cuisson lente jusqu&apos;à sauce crémeuse brun-orangé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Sauce Arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_arachide_simple_plat_national_quotidien -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_arachide_simple_plat_national_quotidien">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon, ail, tomate et soumbala revenus 10 min, pâte d&apos;arachide délayée et incorporée, eau ajoutée, mijoté 15 min jusqu&apos;à sauce brun-orange épaisse ; servi sur riz blanc.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Sauce Arachide Simple (Plat National Quotidien)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_epinard_a_la_pate_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_epinard_a_la_pate_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz cuit à l&apos;eau salée et huilée. Sauce préparée avec oignons, tomate, poivron revenus, pâte d&apos;arachide et concentré de tomate ajoutés, feuilles d&apos;épinard et gombo incorporés avec la viande, mijotée 15 à 20 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz sauce épinard à la pâte d&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_tomate_au_poulet -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_sauce_tomate_au_poulet">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet fermier mariné et doré, puis mijoté dans une sauce tomate concentrée et épicée jusqu&apos;à cuisson complète, servi sur riz blanc en dôme.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Sauce Tomate au Poulet</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_saute_aux_legumes_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_saute_aux_legumes_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes durs sautés à feu vif, puis légumes tendres, œufs battus brouillés au centre, et enfin riz froid ajouté et sauté avec les épices jusqu&apos;à léger doré.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Sauté aux Légumes Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_saute_de_reveillon_de_nouvel_an -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_saute_de_reveillon_de_nouvel_an">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cuisson des protéines (crevettes ou poulet, puis omelette), sauté des légumes 3 min, intégration du riz refroidi avec sauce soja, piment et cube</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz Sauté de Réveillon de Nouvel An</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_soumbala_a_la_tomate_farcie_aux_boulettes_de_volaille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_riz_soumbala_a_la_tomate_farcie_aux_boulettes_de_volaille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz de Bagré passé à la vapeur puis cuit dans le bouillon de poulet. Chair de poulet hachée et malaxée avec la pâte d&apos;arachide en boulettes frites. Tomates évidées et farcies de la préparation, disposées sur le riz en cuisson et cuites à feu doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Riz soumbala à la tomate farcie aux boulettes de volaille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_rouleaux_de_cannelle_au_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_rouleaux_de_cannelle_au_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Activer la levure dans le lait chaud sucré. Mélanger farine, sel, ajouter levure et beurre de karité fondu, pétrir 8 min, laisser lever 1h. Étaler la pâte en rectangle, étaler le beurre de karité ramolli, saupoudrer sucre et cannelle, rouler serré sur la longueur, couper en tranches de 3 cm. Laisser lever 30 min, cuire en marmite couverte à feu doux 25 min. Glacer avec le mélange lait fermenté-sucre glace.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Rouleaux de Cannelle au Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_saga_saga_soupe_lobi_au_sesame_sauvage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_saga_saga_soupe_lobi_au_sesame_sauvage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage de la viande, préparation des herbes saga-saga, broyage du sésame, cuisson de la viande 20 min, base et sésame 8 min, finition aux herbes lobi 15 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">43</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Saga-Saga — Soupe Lobi au Sésame Sauvage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_cesar_burkinabee_au_poulet_grille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_cesar_burkinabee_au_poulet_grille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet de village grillé sur braise, laitue mélangée à la sauce césar au soumbala, garnie de wagashi grillé, croûtons de pain de mil et sésame.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade César Burkinabée au Poulet Grillé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_complete_niebe_et_legumes_grilles -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_complete_niebe_et_legumes_grilles">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes grillés sur braise légèrement carbonisés, assemblés avec niébé, laitue et wagashi, arrosés de vinaigrette fumée au soumbala.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade Complète Niébé et Légumes Grillés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_d_avocat -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_d_avocat">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chair des avocats fendus salée et poivrée, mélangée délicatement avec les autres ingrédients.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade d&apos;Avocat</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_d_avocat_et_crevettes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_d_avocat_et_crevettes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Salade verte, crevettes cuites et décortiquées, avocat en morceaux arrosés de citron, nappés de vinaigrette citron-moutarde. Cette recette est explicitement indiquée d&apos;origine ivoirienne dans le livre, non burkinabè.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade d&apos;Avocat et Crevettes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_d_avocat_et_crevettes_au_citron -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_d_avocat_et_crevettes_au_citron">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Avocat en dés arrosé de citron, crevettes marinées au citron-gingembre, mélangé délicatement avec oignon, herbes et piment, servi dans les 15 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade d&apos;Avocat et Crevettes au Citron</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_betterave_rouge_et_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_betterave_rouge_et_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Betteraves cuites 45 min, pelées, coupées en dés, mélangées à l&apos;oignon et au gingembre, arrosées de vinaigrette.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Betterave Rouge et Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_carottes_rapees_au_miel_et_orange -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_carottes_rapees_au_miel_et_orange">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Carottes râpées grossièrement, mélangées à une vinaigrette au jus d&apos;orange, miel, cannelle et gingembre, garnies de sésame grillé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Carottes Râpées au Miel et Orange</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_chou_cremeuse_coleslaw_africain -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_chou_cremeuse_coleslaw_africain">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chou râpé fin dégorgé au sel puis essoré, mélangé à carotte et oignon, enrobé de sauce crémeuse au yaourt ou nono, réfrigéré 30 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Chou Crémeuse (Coleslaw Africain)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_chou_rouge_et_blanc -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_chou_rouge_et_blanc">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Choux émincés à la mandoline, mélangés à oignon et carottes râpées, nappés d&apos;une sauce moutarde-vinaigre-yaourt, macérés au moins 2h au réfrigérateur.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Chou Rouge et Blanc</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_choux -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_choux">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Salade froide de chou cru en lamelles, décorée de rondelles de tomate et d&apos;oignon, servie avec une vinaigrette (vinaigre, huile, sel). Contact: Mme Traore Clarisse, Tél 7224 00 24.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de choux</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_concombre_a_la_menthe_fraiche -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_concombre_a_la_menthe_fraiche">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Concombre dégorgé au sel puis rincé, mélangé à l&apos;oignon et à la sauce yaourt-menthe, servi très froid.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Concombre à la Menthe Fraîche</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_fruits_arc_en_ciel_pour_enfants -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_fruits_arc_en_ciel_pour_enfants">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fruits coupés en morceaux ou billes, disposés en bandes de couleur dans l&apos;assiette, arrosés de jus de citron et sucre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Fruits Arc-en-Ciel pour Enfants</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_fruits_exotiques -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_fruits_exotiques">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Dés de papaye, ananas et banane mélangés au jus d&apos;orange fraîchement pressé, sucrés au goût, servis frais.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Fruits Exotiques</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_fruits_tropicaux_au_citron_et_menthe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_fruits_tropicaux_au_citron_et_menthe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fruits coupés en cubes réunis dans un saladier, assaisonnés de sucre, sel, jus de citron vert et menthe ciselée, réfrigérés 30 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Fruits Tropicaux au Citron et Menthe</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_gesier_grille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_gesier_grille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Gésiers cuits 45 à 60 minutes dans l&apos;eau, égouttés puis grillés 10 à 15 minutes, coupés en morceaux et mélangés aux légumes assaisonnés.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Gésier Grillé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_haricots_verts_et_tomates_cerises -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_haricots_verts_et_tomates_cerises">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Haricots verts blanchis 4 min puis refroidis à l&apos;eau glacée, mélangés à tomates cerises, oignon et herbes, arrosés de vinaigrette moutarde.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Haricots Verts et Tomates Cerises</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_kienebdo_cleome -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_kienebdo_cleome">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de cléome bouillies 40 min, mélangées à du poisson cuit à la vapeur et désossé, revenu avec oignon et ail. Contact: Restaurant Fasorisongo, Mlle Savadogo Oumou Koulsoum.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Kienebdo (cléome)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_koumvando -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_koumvando">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles d&apos;aubergine locale bouillies 45 minutes, essorées et pressées, puis garnies d&apos;oignon, tomate, œufs bouillis et concombre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de koumvando</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_laitue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_laitue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tomates en segments, feuilles de laitue, radis et oignons verts tranchés finement, assaisonnés de vinaigrette classique.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Laitue</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_legumes_crus_a_la_vinaigrette_tamarin -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_legumes_crus_a_la_vinaigrette_tamarin">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes crus (carottes, concombre, tomate, haricots verts, oignon rouge, menthe) arrosés d&apos;une vinaigrette au tamarin (pulpe de tamarin dissoute dans l&apos;eau chaude, huile d&apos;arachide, miel, gingembre, sel, piment). Laisser mariner 15 minutes avant de servir.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Légumes Crus à la Vinaigrette Tamarin</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_macedoine_simple -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_macedoine_simple">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes coupés en dés cuits 20 minutes puis refroidis, oeufs durs cuits 10 minutes, tout mélangé avec mayonnaise, sel et poivre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Macédoine Simple</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_mais_et_haricots_rouges -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_mais_et_haricots_rouges">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Maïs égrené et haricots rouges mélangés aux poivrons, oignon et coriandre, arrosés de vinaigrette.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Maïs et Haricots Rouges</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_mangue_verte_epicee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_mangue_verte_epicee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangue verte, carotte et oignon en julienne, mélangés à la vinaigrette pimentée, garnis de cacahuètes grillées au service.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Mangue Verte Épicée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_niebe_proteine_aux_herbes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_niebe_proteine_aux_herbes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Niébé trempé 8h et cuit 45 min (tendre mais ferme), mélangé à oignon, tomate, concombre et herbes, arrosé d&apos;une vinaigrette (huile d&apos;arachide, jus de citron, ail pilée, sel, piment, miel).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Niébé Protéiné aux Herbes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_papaye_verte_et_crevettes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_papaye_verte_et_crevettes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Papaye verte râpée mélangée à oignon, herbes et crevettes marinées au citron, arrosée de vinaigrette et garnie de cajou grillé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Papaye Verte et Crevettes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_pommes_de_terre_a_l_africaine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_pommes_de_terre_a_l_africaine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pommes de terre cuites entières, pelées chaudes, arrosées de vinaigrette au tamarin, garnies d&apos;oeufs durs, crevettes séchées, oignon et herbes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Pommes de Terre à l&apos;Africaine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_riz_a_la_mangue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_riz_a_la_mangue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz cuit 15 à 18 minutes dans 1,2 litre d&apos;eau salée, refroidi, mélangé à la mangue et l&apos;oignon en dés, assaisonné d&apos;huile, citron et sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">18</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Riz à la Mangue</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_riz_complet_aux_herbes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_riz_complet_aux_herbes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Riz complet cuit et refroidi, mélangé généreusement à légumes en dés et herbes, arrosé de vinaigrette, reposé 30 min à 1h.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Riz Complet aux Herbes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_soumbala_au_moringa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_soumbala_au_moringa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Salade de graines de néré transformées en soumbala maison et de feuilles de moringa bouillies, mélangées à tomate et poivron en dés, assaisonnée au jus de citron et à l&apos;huile. Contact: Restaurant Oxygène, Turbiche Nare.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de soumbala au moringa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_tomate -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_de_tomate">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tomates mondées et coupées en rondelles disposées en chevauchant, oignons émincés dessus, assaisonnées et arrosées d&apos;huile d&apos;olive et de vinaigre, réfrigérées 30 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade de Tomate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_gastronomique_de_fonio_et_legumes_grilles -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_gastronomique_de_fonio_et_legumes_grilles">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes grillés sur braise, fonio cuit al dente, vinaigrette au tamarin émulsionnée, dressage avec wagashi émietté, graines et micro-pousses.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade Gastronomique de Fonio et Légumes Grillés</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_grecque_burkinabee_au_wagashi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_grecque_burkinabee_au_wagashi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes en gros morceaux disposés avec wagashi et mangue verte, arrosés de vinaigrette et garnis de basilic.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade Grecque Burkinabée au Wagashi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_marocaine_revisitee_aux_epices_saheliennes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_marocaine_revisitee_aux_epices_saheliennes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poivrons grillés à la flamme et pelés, coupés en dés avec tomates, oignon et concombre, assaisonnés de vinaigrette au ras-el-hanout sahélien et harissa.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade Marocaine Revisitée aux Épices Sahéliennes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_tiede_de_lentilles_aux_epices -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_tiede_de_lentilles_aux_epices">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lentilles cuites 20 min, mélangées tièdes à une vinaigrette au cumin torréfié, avec légumes et herbes fraîches.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade Tiède de Lentilles aux Épices</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_tomates_oignons_classique_burkinabee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_salade_tomates_oignons_classique_burkinabee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tomates et oignon coupés, arrosés de vinaigrette huile-citron, reposés 10 minutes avant service.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Salade Tomates-Oignons Classique Burkinabée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_samsa -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_samsa">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont triées, lavées et épierrées. Elles sont trempées pendant une heure puis broyées pour donner une pâte consistante. La pâte obtenue est malaxée avec de la potasse jusqu&apos;à obtenir une pâte souple. De l&apos;huile est mise à chauffer dans une poêle. Dès que l&apos;huile est chaude, introduire de petites boules de la pâte dans l&apos;huile pour la friture. Consommé seul ou assaisonné de piment.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Samsa</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sandwichs_omelette_viande_de_rue -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sandwichs_omelette_viande_de_rue">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cuire la viande émincée avec l&apos;oignon 5 min. Cuire l&apos;omelette battue avec œufs, oignon, piment 3 min. Assembler dans le pain avec sauce piment, moutarde, viande, omelette et tomate.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sandwichs Omelette-Viande de Rue</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_d_amarante -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_d_amarante">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et blanchir les feuilles d&apos;amarante puis les piler. Laver et découper oignons, tomates, poivron, persil, ail. Faire revenir dans l&apos;huile les oignons, poivrons, tomates, persil et ail. Ajouter la pâte de tomate. Après 5 min ajouter l&apos;eau, le sel et le poisson. Laisser cuire 10 min puis ajouter les feuilles d&apos;amarante pilées. Laisser cuire 15 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 23,23 g/100 g de sauce, pH : 5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles d&apos;amarante</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_d_amarante_aux_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_d_amarante_aux_arachides">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver, découper et piler séparément les oignons, feuilles d&apos;oignon et feuilles d&apos;amarante ; piler séparément les arachides crues, le poisson sec et l&apos;ail. Mettre les oignons découpés dans la marmite et remuer à chaud. Ajouter la pâte d&apos;arachide et la pâte de tomate, frire à sec 5 min. Ajouter l&apos;eau, les feuilles d&apos;oignon et d&apos;amarante, cuire 20 min puis mettre le poisson sec, l&apos;huile de palme, le bouillon cube, l&apos;ail et le piment entier, attendre 10 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 23,58 g/100 g de sauce, pH : 6,3.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles d&apos;amarante aux arachides</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_d_amarante_aux_courgettes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_d_amarante_aux_courgettes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver les feuilles d&apos;amarante, les feuilles d&apos;oseille, les aubergines locales et les courgettes ; piler le soumbala et les arachides séparément. Blanchir les feuilles d&apos;amarante et les courgettes. Après 20 min de cuisson, ajouter la poudre d&apos;arachide et les feuilles d&apos;oseille. Ajouter le soumbala et saler. Laisser mijoter 45 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 20,36 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">65</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles d&apos;amarante aux courgettes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_de_morelle_a_la_poudre_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_de_morelle_a_la_poudre_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les feuilles de morelle. Blanchir les feuilles dans l&apos;eau et les égoutter. Laver et découper finement les oignons, tomates et poivrons. Faire revenir dans l&apos;huile les oignons, poivrons, puis ajouter les tomates fraîches, la tomate pâte et les épices (ail, persil). Après 5 min de cuisson mettre le poisson fumé, le bouillon cube et les feuilles de morelle. Mettre la poudre d&apos;arachide, saler à volonté. Laisser mijoter 15 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 19,6 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles de morelle à la poudre d&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_d_aubergine_africaine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_d_aubergine_africaine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les tigelles des feuilles, laver 3 fois et découper finement. Frire le poisson frais. Découper les oignons, poivrons, tomates. Piler le soumbala, le poisson sec, l&apos;arachide. Mettre l&apos;eau à ébullition et y plonger les feuilles fraîches d&apos;aubergine lavées, les retirer après 30 min et essorer (NB : des feuilles d&apos;oignon, d&apos;amarante ou du gombo frais peuvent être ajoutés). Faire revenir dans l&apos;huile les oignons, tomates, poivrons pendant 2 min avant d&apos;ajouter l&apos;eau. Laisser cuire jusqu&apos;à ébullition puis ajouter le soumbala et le poisson sec pilés. Après 9 min, ajouter les feuilles fraîches d&apos;aubergine, le poisson frit, l&apos;arachide et le sel. Laisser au feu 25 min. Se consomme avec du tô. Teneur en matière sèche : 16,5 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">36</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches d&apos;aubergine Africaine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_d_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_d_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Faire bouillir les feuilles fraîches d&apos;oseille 20 min. Laver et découper finement les oignons, poivrons, tomates fraîches. Piler séparément le soumbala et les arachides crues. Faire revenir dans l&apos;huile la viande, les oignons, poivrons et tomates. Ajouter à la friture après 10 min la pâte de tomate. Ajouter l&apos;eau et laisser cuire 8 min. Mettre la poudre de soumbala, les feuilles d&apos;oseille et la poudre d&apos;arachide. Laisser au feu 30 min puis mettre la potasse, le bouillon cube et saler à volonté. Se consomme avec du tô. Teneur en matière sèche : 19,96 g/100 g MS, pH : 5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">48</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches d&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_a_l_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_a_l_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les tigelles et laver les feuilles de corète et d&apos;oseille. Laver et découper finement les oignons et tomates. Frire le poisson, piler le soumbala et la levure. Faire revenir dans l&apos;huile les oignons et tomates 6 min. Ajouter l&apos;eau, le soumbala, la levure. Laisser cuire 20 min. Ajouter les feuilles de corète. Laisser cuire 45 min. Ajouter les feuilles d&apos;oseille, 17 min après mettre le poisson frit, le bouillon cube et le sel. Laisser mijoter 20 min à feu doux. Se consomme avec du tô. Teneur en matière sèche : 14,5 g/100 g de sauce, pH : 5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">108</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de corète à l&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_a_la_pate_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_a_la_pate_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les feuilles fraîches de corète. Faire bouillir les feuilles 9 min et rincer. Laver et découper la viande, les oignons, les tomates fraîches. Piler le soumbala. Faire revenir dans l&apos;huile la viande, les oignons, les tomates fraîches. Après 6 min ajouter la pâte de tomate. Frire 8 min et mettre la pâte d&apos;arachide et les feuilles de corète cuites. Après 10 min ajouter l&apos;eau et laisser cuire 3 min. Mettre le soumbala pilé et la potasse. Après 19 min de cuisson mettre le bouillon cube, saler et laisser mijoter 20 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 17,9 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">66</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de corète à la pâte d&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_aux_aubergines_fraiches -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_aux_aubergines_fraiches">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les oignons, tomates fraîches, feuilles d&apos;oignon, gombo frais. Laver les aubergines fraîches locales. Piler le soumbala. Frire le poisson frais. Faire revenir dans l&apos;huile les oignons, feuilles d&apos;oignon, tomates fraîches. Frire 4 min et ajouter la pâte de tomate, le gombo frais. Après 3 min mettre le soumbala pilé, les aubergines fraîches. Ajouter l&apos;eau, les feuilles de corète, la potasse. Mettre le sel et le bouillon cube. Laisser cuire 11 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 18,84 g/100 g de sauce, pH : 7,6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">18</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de corète aux aubergines fraiches</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_aux_feuilles_d_oignon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_aux_feuilles_d_oignon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les tigelles des feuilles de corète, laver scrupuleusement. Frire le poisson frais. Piler le soumbala. Laver et découper séparément les oignons, tomates et feuilles d&apos;oignon. Faire revenir dans l&apos;huile les oignons, poivrons et tomates 7 min au feu. Ajouter l&apos;eau, la poudre de soumbala, les feuilles d&apos;oignon puis laisser bouillir 20 min. Ajouter les feuilles de corète et 9 min après mettre le poisson frit, le bouillon cube, le poivre. Laisser mijoter 5 min à feu doux. Se consomme avec du tô. Teneur en matière sèche : 17,9 g/100 g de sauce, pH : 7.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">41</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de corète aux feuilles d&apos;oignon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_aux_pistaches -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_corete_aux_pistaches">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les feuilles de corète. Piler séparément le soumbala et les pistaches. Cuire le poisson frais dans l&apos;eau 5 min. Porter à ébullition le soumbala et la potasse 8 min. Ajouter les feuilles de corète. Laisser cuire 8 min et écraser les feuilles à l&apos;aide d&apos;un fouet. Après 5 min, ajouter la poudre de pistache, le poisson cuit, le soumbala pilé, le sel, le bouillon cube et l&apos;huile de palme. Laisser cuire 12 min. Se consomme avec du tô, du riz ou de l&apos;akassa. Teneur en matière sèche : 20,42 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">38</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de corète aux pistaches</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_gombo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_gombo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les feuilles de gombo et les feuilles d&apos;oignon. Piler séparément le gombo sec et le soumbala. Faire cuire dans l&apos;eau le niébé et la potasse. Après 45 min ajouter les feuilles de gombo. Cuire 5 min puis ajouter les feuilles d&apos;oignon, le soumbala, la levure, le poisson sec, le piment et le sel. Laisser mijoter 27 min. NB : le gombo sec, les feuilles d&apos;oignon, le niébé et la levure de dolo sont facultatifs. Se consomme avec du tô ou du riz. Teneur en matière sèche : 16,62 g/100 g de sauce, pH : 7,1.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">77</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de gombo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les tigelles des feuilles de morelle, laver soigneusement et découper les feuilles. Découper et laver les oignons et tomates fraîches. Piler le poivre noir, puis ensemble le persil et l&apos;ail. Frire le poisson frais et le désosser. Frire dans l&apos;huile les oignons et les tomates. Ajouter le poivre noir puis les feuilles fraîches de morelle à la friture. Frire 5 min puis mettre le poisson et saler à volonté. Ajouter les épices (ail, persil) et l&apos;huile de palme. Laisser cuire 15 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 25,6 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de morelle</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle_a_la_pate_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle_a_la_pate_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper séparément la viande, les feuilles de morelle, le gombo frais, les oignons, les tomates. Piler séparément le poivre noir, le persil, l&apos;ail, le soumbala. Remuer à sec la viande, puis mettre les oignons, la tomate et l&apos;eau. Après 10 min de cuisson mettre les feuilles de morelle. Laisser cuire 30 min et ajouter le gombo frais et la potasse. Après 16 min de cuisson mettre la pâte d&apos;arachide, les épices, le soumbala et le bouillon cube. Après 30 min, ajouter du beurre de karité et laisser mijoter 4 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 18,5 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">90</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de morelle à la pâte d&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle_au_gombo_frais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle_au_gombo_frais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les feuilles de morelle et le gombo frais, piler le gombo frais. Laver et découper les tomates, oignons, poivrons. Frire le poisson frais, piler le soumbala. Faire revenir dans l&apos;huile les oignons, tomates, poivrons. Après 10 min ajouter le gombo frais. Après 8 min ajouter les feuilles de morelle. Frire 20 min puis mettre l&apos;eau, le poisson frais, le sel. Après 13 min de cuisson ajouter le soumbala et laisser mijoter 20 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 14,8 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">71</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de morelle au gombo frais</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle_aux_feuilles_de_cleome -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_fraiches_de_morelle_aux_feuilles_de_cleome">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver séparément et soigneusement les feuilles de morelle, d&apos;oseille, de cleome et les feuilles d&apos;oignon, découper séparément. Frire le poisson. Mettre à cuire dans l&apos;eau les feuilles de morelle et de cleome ensemble. Après 30 min de cuisson ajouter les feuilles d&apos;oseille, attendre 15 min. Faire revenir dans l&apos;huile les oignons, feuilles d&apos;oignon et tomates. Après 10 min ajouter l&apos;eau et les feuilles déjà cuites. Mettre le poisson, le piment, le sel et le bouillon cube. Laisser cuire 20 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 25,6 g/100 g de sauce, pH : 5,3.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">75</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles fraîches de morelle aux feuilles de cleome</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_aubergine_a_l_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_aubergine_a_l_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éliminer les nervures des feuilles séchées d&apos;aubergine. Faire bouillir les feuilles, retirer de l&apos;eau et égoutter. Découper les oignons et tomates fraîches finement. Piler le soumbala, le poisson séché, les arachides crues. Faire revenir dans l&apos;huile les oignons, tomates fraîches et la pâte de tomate 2 min, ajouter 0,83 L d&apos;eau. Mettre le poisson sec et la poudre de soumbala, laisser au feu 27 min. Ajouter le poisson frais et les feuilles séchées d&apos;aubergine essorées. Après 12 min ajouter la poudre d&apos;arachide et le piment, laisser cuire 8 min. Se consomme avec du tô. Teneur en matière sèche : 19,9 g/100 g de sauce brute, pH : 6,5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">49</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées d&apos;aubergine à l&apos;arachide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_aubergine_au_gombo_sec -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_aubergine_au_gombo_sec">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Découper les oignons et la tomate fraîche finement. Piler le gombo sec et le poisson sec. Faire revenir dans l&apos;huile les oignons, la tomate, 5 min. Ajouter 0,8 L d&apos;eau et laisser au feu 15 min. Ajouter la poudre de poisson séché et les feuilles séchées d&apos;aubergine. Après 8 min mettre la poudre de gombo séché, le poisson fumé, la potasse et le sel. Laisser au feu doux 22 min avant de servir. Se consomme avec du tô. Teneur en matière sèche : 20 g/100 g de sauce brute, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées d&apos;aubergine au gombo sec</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_aubergine_aux_koumba -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_aubergine_aux_koumba">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mettre les feuilles d&apos;aubergine dans une eau à ébullition 30 min puis les retirer et essorer. Découper les oignons et tomates fraîches finement. Piler le soumbala et les arachides crues. Frire le poisson frais. Faire revenir dans l&apos;huile les oignons, l&apos;ail, les tomates fraîches et la pâte de tomate. Après 10 min de friture ajouter l&apos;eau. Après 5 min ajouter le soumbala, les aubergines locales, la levure, le piment, le sel. Les feuilles séchées d&apos;aubergine sont ajoutées au bouillon après 14 min. L&apos;arachide, le poisson frit et la potasse sont ajoutés à la sauce laissée au feu 22 min. Se consomme avec du tô. Teneur en matière sèche : 18,3 g/100 g de sauce brute, pH : 7.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">51</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées d&apos;aubergine aux koumba</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_d_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tremper les feuilles séchées d&apos;oseille au moins une heure dans l&apos;eau. Faire bouillir 58 min, puis rincer et égoutter les feuilles cuites. Frire le poisson frais. Laver et découper les oignons, poivrons et tomates. Piler le soumbala et les arachides crues. Faire revenir dans l&apos;huile les oignons, le poivron et les tomates découpées. Ajouter l&apos;eau, la poudre de soumbala. Laisser cuire 7 min puis ajouter les feuilles cuites et la poudre d&apos;arachide. Après 8 min de cuisson mettre le poisson, le sel et le bouillon cube. Laisser au feu 7 min. Se consomme avec du tô. Teneur en matière sèche : 25,8 g/100 g MS, pH : 5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">22</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées d&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les oignons, tomates fraîches, feuilles d&apos;oignon. Piler le soumbala et le poisson sec. Faire revenir dans l&apos;huile les feuilles d&apos;oignon, tomates fraîches. Après 10 min mettre l&apos;eau, le poisson sec, le soumbala. Cuire 10 min ajouter le bouillon cube. Après 2 min mettre les feuilles de corète et la potasse. Cuire 10 min et ajouter le poisson frais. Après 7 min de cuisson saler et laisser mijoter 17 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 17,08 g/100 g de sauce, pH : 7.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">56</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées de corète</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_au_gombo_frais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_au_gombo_frais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Écraser à la main les feuilles de corète et les mouiller légèrement en ajoutant de la potasse. Laver et découper les oignons, tomates et gombo frais. Piler le soumbala. Faire revenir dans l&apos;huile les oignons, tomates. Après 5 min ajouter la pâte de tomate à la friture. Ajouter l&apos;eau, l&apos;ail, le gombo frais, le poisson fumé, le bouillon cube et la poudre de soumbala. Laisser cuire 15 min. Se consomme avec du tô ou du riz blanc. Teneur en matière sèche : 16,63 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées de corète au gombo frais</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_aux_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_aux_arachides">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper séparément les oignons et tomates fraîches. Faire bouillir les feuilles séchées de corète et les écraser après cuisson. Faire revenir dans l&apos;huile la viande, les oignons, les tomates et la pâte de tomate. Ajouter le persil et l&apos;ail. Après 9 min de friture mettre l&apos;eau, les feuilles de corète cuites et la potasse. Laisser cuire 14 min et mettre la poudre d&apos;arachide. Après 4 min saler et laisser mijoter 22 min avant de servir. Se consomme avec du tô ou du riz. Teneur en matière sèche : 21,6 g/100 g de sauce, pH : 7.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">49</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées de corète aux arachides</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_aux_feuilles_d_oignon -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_aux_feuilles_d_oignon">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Faire bouillir le bikalga 10 min. Éliminer les tigettes des feuilles séchées de corète. Laver et découper les tomates fraîches, oignons, poivrons, feuilles d&apos;oignon. Frire le poisson et le désosser. Dissoudre la levure dans une petite quantité d&apos;eau. Faire revenir dans l&apos;huile les oignons, tomates fraîches et poivrons 9 min. Saupoudrer le curry. Après 5 min de friture ajouter le poisson désossé et un peu de jus de bikalga, laisser bouillir 7 min. Mettre les feuilles d&apos;oignon et le konré. Cuire 6 min puis ajouter la potasse et les feuilles de corète. Après 4 min ajouter la levure dissoute, saler et laisser mijoter 26 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 16,63 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">57</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées de corète aux feuilles d&apos;oignon</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_aux_feuilles_d_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_feuilles_sechees_de_corete_aux_feuilles_d_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les oignons, tomates fraîches, feuilles d&apos;oseille. Piler le persil et l&apos;ail, piler le soumbala. Faire revenir dans l&apos;huile les oignons et tomates fraîches. Frire 10 min et ajouter la pâte de tomate et le persil pilé. Après 2 min ajouter l&apos;eau et laisser cuire 10 min. Mettre le soumbala pilé. Après 6 min ajouter la potasse et les feuilles de corète. Cuire 12 min. Mettre les feuilles d&apos;oseille, attendre 12 min avant d&apos;ajouter le poisson fumé et le bouillon cube. Laisser mijoter 14 min. Se consomme avec du tô ou du riz. Teneur en matière sèche : 18,16 g/100 g de sauce, pH : 7.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">64</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de feuilles séchées de corète aux feuilles d&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_fleurs_entieres_d_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_fleurs_entieres_d_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et bouillir les fleurs d&apos;oseille. Après 15 min les faire sortir et rincer. Laver et découper les oignons et tomates. Au feu, mettre dans une casserole une petite quantité d&apos;eau, de la pâte d&apos;arachide, des tomates et des oignons. Laisser cuire 8 min puis ajouter de l&apos;eau et les fleurs d&apos;oseille. Mettre le poisson, le bouillon cube et saler à volonté. Laisser mijoter 20 min. Se consomme avec du tô. Teneur en matière sèche : 22,7 g/100 g de sauce, pH : 4.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">28</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de fleurs entières d&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_fruits_de_gombo_frais -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_fruits_de_gombo_frais">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper séparément la viande, les oignons, les tomates fraîches et les fruits de gombo frais (si poisson frais, le faire frire ; le poisson sec peut remplacer la viande ou le poisson frais). Frire la viande. Après 7 min ajouter les oignons, tomates, poivrons. Frire 10 min et ajouter la pâte de tomate. Après 6 min mettre les fruits de gombo frais. Frire 9 min puis ajouter l&apos;eau, le soumbala et le bouillon cube. Mettre la potasse, le sel et laisser mijoter 27 min. NB : la levure de dolo (env. 25 g, dissoute dans l&apos;eau) peut être ajoutée juste avant le gombo ; l&apos;exsudat de graines de palme peut aussi être ajouté ; l&apos;huile végétale peut être remplacée par du beurre de karité. Se consomme avec du tô ou du riz. Teneur en matière sèche : 15,7 g/100 g de sauce, pH : 5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">59</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de fruits de gombo frais</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_fruits_frais_d_aubergine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_fruits_frais_d_aubergine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les aubergines locales, les oignons et les tomates fraîches. Cuire les aubergines dans l&apos;eau, enlever la peau et écraser pour obtenir une purée. Piler les arachides crues. Faire revenir dans l&apos;huile les oignons, tomates fraîches. Après 5 min ajouter l&apos;eau, le poisson sec et la purée d&apos;aubergine. Cuire 4 min et ajouter les arachides pilées et le poisson frais. Après 2 min ajouter l&apos;ail, le persil, le bouillon cube et le sel. Ajouter la potasse et laisser cuire 25 min. Se consomme avec du tô ou du riz blanc. Teneur en matière sèche : 20,28 g/100 g de sauce, pH : 5,9.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">36</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de fruits frais d&apos;aubergine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_gombo_frais_aux_feuilles_sechees_d_aubergine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_gombo_frais_aux_feuilles_sechees_d_aubergine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tremper les feuilles d&apos;aubergine dans l&apos;eau bouillante 30 min, rincer à l&apos;eau potable et égoutter. Découper finement le gombo. Frire le poisson frais à l&apos;huile. Laver et découper finement les oignons et tomates. Piler le soumbala et le poivre. Faire revenir dans l&apos;huile les oignons et tomates 4 min, ajouter 2,5 L d&apos;eau, le soumbala et le poivre pilés. Laisser au feu 23 min. Ajouter les feuilles séchées d&apos;aubergine. Après 18 min ajouter le gombo frais. Après 37 min ajouter le poisson frit et le sel. Laisser mijoter à feu doux 24 min. Se consomme avec du tô. Teneur en matière sèche : 19 g/100 g de sauce, pH : 6.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">106</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de gombo frais aux feuilles séchées d&apos;aubergine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_gombo_sec -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_gombo_sec">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper séparément les oignons et tomates fraîches. Piler séparément le gombo sec et le soumbala. Faire revenir dans l&apos;huile les oignons, tomates fraîches. Après 4 min ajouter la pâte de tomate. Frire 7 min puis mettre la poudre de soumbala et le poisson sec. Après 3 min de friture ajouter l&apos;eau et le poisson frais. Laisser cuire 4 min puis mettre la potasse et le bouillon cube. Après 17 min de cuisson ajouter le gombo, le piment et le sel. Laisser cuire 12 min. Se consomme avec du tô. Teneur en matière sèche : 18,12 g/100 g de sauce, pH : 6,2.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">47</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de gombo sec</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_gombo_sec_aux_aubergines_locales -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_gombo_sec_aux_aubergines_locales">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Laver et découper les oignons, feuilles d&apos;oignon, poivrons, tomates fraîches. Piler le soumbala, les oignons séchés, le poisson sec et les feuilles de laurier. Frire dans l&apos;huile les oignons, tomates fraîches, poivrons, l&apos;ail et le persil. Après 3 min ajouter le sel et les feuilles de laurier pilées, le bouillon cube, le poivre noir et un peu d&apos;eau (250 g). Laisser cuire 5 min et ajouter les oignons séchés, le poisson sec et le soumbala avec un peu d&apos;eau (500 g). Ajouter les fruits d&apos;aubergine locale, l&apos;eau et le poisson fumé. Cuire 49 min puis mettre la poudre de gombo sec. Ajouter la potasse et laisser mijoter 10 min. Se consomme avec du tô ou du riz blanc. Teneur en matière sèche : 14,8 g/100 g de sauce, pH : 7.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">67</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de gombo sec aux aubergines locales</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_petales_de_fleurs_sechees_d_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_de_petales_de_fleurs_sechees_d_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Enlever les pétales des fleurs séchées d&apos;oseille. Les laver et tremper au moins une heure dans l&apos;eau. Rincer et égoutter. Laver et découper finement les oignons, tomates fraîches. Piler le soumbala et la poudre d&apos;arachide. Faire revenir dans l&apos;huile les oignons, poivrons et tomates. Ajouter l&apos;eau puis le soumbala. Laisser cuire 15 min, mettre les fleurs et la poudre d&apos;arachide. Laisser cuire 15 min et ajouter le poisson, le bouillon cube, saler. Se consomme avec du tô. Teneur en matière sèche : 15,6 g/100 g de sauce, pH : 5.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce de pétales de fleurs séchées d&apos;oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_djodjo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_djodjo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Aubergine, feuilles de courge puis feuilles d&apos;oseille cuites successivement à 10 minutes d&apos;intervalle, poudre d&apos;arachide ajoutée, puis oignon et beurre de karité incorporés et mijotés 12 minutes. Peut se consommer simplement ou avec du tô.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">47</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce djodjo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_gombo_de_funerailles -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_gombo_de_funerailles">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Cuisson de la viande (bœuf+kilishi) 20 min, grande base aromatique (oignons, tomates, soumbala, piments 15 min), assemblage de la grande sauce avec gombo, poisson fumé, viande et bouillon 25 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce Gombo de Funérailles</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_karite_pur_des_femmes_du_plateau_central -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sauce_karite_pur_des_femmes_du_plateau_central">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fonte douce du beurre de karité, aromatisation minimale (soumbala, piment séché, sel), infusion à feu très doux 5 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sauce Karité Pur des Femmes du Plateau Central</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_semoule_de_mais_epaisse_akasse -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_semoule_de_mais_epaisse_akasse">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fermentation de la semoule de maïs 6h ou toute une nuit, cuisson de l&apos;akassé 15 à 20 min en remuant vigoureusement</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Semoule de Maïs Épaisse (Akassé)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_semoule_sucree_au_lait_bouillie_sucree -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_semoule_sucree_au_lait_bouillie_sucree">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparer une pâte fluide de farine avec de l&apos;eau. Verser en filet dans l&apos;eau bouillante en remuant 15 min. Ajouter sucre et sel. Servir avec lait concentré ou fermenté et arachides.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Semoule Sucrée au Lait (Bouillie Sucrée)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sinse_dagara_et_birifor_samsa_en_more -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sinse_dagara_et_birifor_samsa_en_more">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de haricot battue avec de l&apos;eau au moins 10 minutes, oignon et ail râpés et persil haché ajoutés. Pâte diluée dans le beurre de karité fondu et frite par petites quantités, 2 minutes de chaque côté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">14</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sinsè (dagara et birifor) (samsa en moré)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_siri_galettes_de_mil_fermente_des_lyela -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_siri_galettes_de_mil_fermente_des_lyela">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fermentation spéciale de la pâte 72h (mil, citron, feuilles de tamarinier), ajustement de la consistance, cuisson des galettes 4 min puis 3 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">7</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Siri — Galettes de Mil Fermenté des Lyéla</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_ananas_bissap_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_ananas_bissap_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Ananas, gingembre, sucre et citron mixés, puis bissap concentré versé dessus pour créer un dégradé de couleurs.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Ananas-Bissap-Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_banane_cacao_lait -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_banane_cacao_lait">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Banane, cacao, lait, sucre et cannelle mixés 1 minute jusqu&apos;à smoothie épais et chocolaté.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Banane-Cacao-Lait</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_banane_lait_fermente -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_banane_lait_fermente">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Bananes, lait fermenté, miel, cannelle et gingembre mixés 1 minute jusqu&apos;à smoothie épais et crémeux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Banane-Lait Fermenté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_mangue_avocat -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_mangue_avocat">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Avocat, mangue, eau, miel, jus de citron et sel mixés 1 minute jusqu&apos;à smoothie épais et crémeux vert-orangé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Mangue-Avocat</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_mangue_bissap -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_mangue_bissap">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangue mixée avec eau et gingembre, versée en fond de verre, puis bissap concentré versé délicatement dessus pour un effet bicolore.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Mangue-Bissap</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_mangue_noix_de_coco -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_mangue_noix_de_coco">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mangue, banane, lait de coco, miel et cannelle mixés 1 minute jusqu&apos;à smoothie épais orange-crème.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Mangue-Noix de Coco</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_papaye_citron_vert -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_papaye_citron_vert">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Papaye épépinée et coupée en cubes mixée avec jus de citron vert, miel, gingembre et eau jusqu&apos;à consistance lisse et onctueuse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Papaye-Citron Vert</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_vert_epinard_citron_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_smoothie_vert_epinard_citron_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Épinards mixés avec eau, puis banane, gingembre, citron et miel ajoutés et mixés à nouveau jusqu&apos;à smoothie lisse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Smoothie Vert Épinard-Citron-Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soja_frit -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soja_frit">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tofu découpé en cubes et frit légèrement dans l&apos;huile chaude. Peut se manger avec une sauce tomate pimentée ou de la mayonnaise.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soja frit</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sokossoko -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sokossoko">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande/rognon saisis puis mijotés avec oignon et tomate</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">60</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sokossoko</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sorbet_de_bissap_maison -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sorbet_de_bissap_maison">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Infusion de bissap concentrée sucrée puis congelée 4 heures avec raclage à la fourchette toutes les 45 minutes pour une texture granuleuse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sorbet de Bissap Maison</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sorgho_decortique_bouilli_degue_de_base -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sorgho_decortique_bouilli_degue_de_base">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Lavage du sorgho, trempage 2h, cuisson longue 45 à 55 min en remuant toutes les 10 min, assaisonnement final</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sorgho Décortiqué Bouilli (Dégué de Base)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soum_piga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soum_piga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Boulettes de pâte de farine de mil et de graines de coton cuites sur du pois de terre bouilli, servi avec une sauce tomate et du piment. Contact: Restaurant Soum piga, Mme Ouedraogo Mariam.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soum Piga</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_anti_inflammatoire_au_curcuma_et_gingembre -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_anti_inflammatoire_au_curcuma_et_gingembre">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Éplucher et couper carottes et oignon en morceaux, émincer l&apos;ail. Chauffer l&apos;huile de karité, faire revenir oignon et ail 5 min. Ajouter le gingembre râpé et le curcuma, faire revenir 2 min. Ajouter les carottes et le bouillon, porter à ébullition, cuire 20 min jusqu&apos;à légumes tendres. Ajouter le poivre noir. Mixer partiellement pour une soupe veloutée ou laisser en morceaux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe Anti-Inflammatoire au Curcuma et Gingembre</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_aux_feuilles_de_baobab_sauce_lalo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_aux_feuilles_de_baobab_sauce_lalo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon et ail revenus avec soumbala et piment dans l&apos;huile 8 min ; eau et viande/poisson ajoutés et portés à ébullition, cuits 15 min ; poudre de feuilles de baobab délayée dans l&apos;eau froide incorporée, cuisson 10 min de plus jusqu&apos;à texture visqueuse. Servi sur tô de mil ou riz blanc.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">33</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe aux Feuilles de Baobab (Sauce Lalo)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_d_arachide_epicee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_d_arachide_epicee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande saisie, base tomate-oignon-soumbala mijotée, pâte d&apos;arachide diluée incorporée en remuant, cuisson lente jusqu&apos;à soupe crémeuse brun-orangée, garnie d&apos;arachides grillées.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe d&apos;Arachide Épicée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_d_igname_sauvage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_d_igname_sauvage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Peler et couper l&apos;igname, tremper si sauvage. Nettoyer la viande au citron. Dorer la viande, faire revenir oignon, ajouter tomates, ail, soumbala, piment, cube, mijoter 8 min. Ajouter l&apos;eau et l&apos;igname égouttée, cuire 25 min. Mijoter encore 5 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">38</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe d&apos;Igname Sauvage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_cacahuete_et_legumes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_cacahuete_et_legumes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Diluer la pâte d&apos;arachide dans l&apos;eau tiède. Préparer et couper les légumes. Faire revenir oignon, ail, tomates, piment et cube 6 min. Verser la pâte d&apos;arachide diluée et l&apos;eau, porter à ébullition, ajouter carottes et patate douce, cuire 15 min. Ajouter haricots verts et poisson/poulet, cuire 8 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">29</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Cacahuète et Légumes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_chenilles_aux_beignets_de_pistache -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_chenilles_aux_beignets_de_pistache">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Soupe de chenilles de karité bouillies mijotées avec oignon, tomate et soumbala, accompagnée de beignets de pâte de pistache frits. Contact: Mme Some Gina, Tél 70 02 05 08.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de chenilles aux beignets de pistache</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_courge_aux_arachides -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_courge_aux_arachides">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparer la courge en dés et griller/piler les arachides. Faire revenir oignon, tomates, soumbala, piment, cube 6 min. Cuire la courge dans l&apos;eau 20 min. Écraser la moitié de la courge, ajouter les arachides pilées, mijoter 8 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">34</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Courge aux Arachides</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_feuilles_de_baobab -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_feuilles_de_baobab">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Feuilles de baobab séchées réhydratées puis mijotées avec viande, poisson fumé, tomate, oignon et soumbala jusqu&apos;à soupe légèrement visqueuse.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Feuilles de Baobab</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_gombo_a_la_viande_sechee -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_gombo_a_la_viande_sechee">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Base aromatique tomate-oignon-soumbala mijotée, kilishi ajouté pour se réhydrater et libérer ses épices, puis gombo haché cuit jusqu&apos;à liaison et poisson fumé incorporé en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Gombo à la Viande Séchée</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_gombo_au_poisson_fume -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_gombo_au_poisson_fume">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Base aromatique tomate-oignon-soumbala mijotée, gombo haché ajouté et cuit jusqu&apos;à liaison, puis poisson fumé et viande séchée incorporés en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Gombo au Poisson Fumé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_legumes_verts_du_terroir -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_legumes_verts_du_terroir">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande dorée puis mijotée en base tomate-oignon-soumbala. Haricots verts ajoutés en premier (plus longs à cuire), puis feuilles de moringa et épinards ajoutés en dernier pour une cuisson courte.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Légumes Verts du Terroir</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_lentilles_au_soumbala_fer_et_proteines -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_lentilles_au_soumbala_fer_et_proteines">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Rincer les lentilles (pas de trempage nécessaire pour les lentilles corail). Faire revenir oignon, ail, tomates, soumbala, piment et cumin dans l&apos;huile de karité 10 min. Ajouter les lentilles rincées, couvrir d&apos;eau (2 fois le volume de lentilles), cuire 25 à 30 min jusqu&apos;à lentilles fondantes. Ajouter le jus de citron hors du feu pour préserver la vitamine C. Servir avec du riz blanc ou du tô.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Lentilles au Soumbala (Fer et Protéines)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_aux_graines_de_nere -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_aux_graines_de_nere">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Faire bouillir et décortiquer les graines de néré. Diluer la farine de mil. Faire revenir oignon, tomates, piment, cube 6 min. Ajouter graines de néré et l&apos;eau, cuire 15 min. Verser la pâte de mil en filet, ajouter le poisson fumé, cuire 10 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">31</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Mil aux Graines de Néré</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_et_legumineuses_repas_complet_budget_zero -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_et_legumineuses_repas_complet_budget_zero">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Mil, niébé trempé, oignon et soumbala cuits ensemble à l&apos;eau froide 45 min jusqu&apos;à tendreté, feuilles de légumes hachées ajoutées 10 min avant la fin avec beurre de karité.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">55</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Mil et Légumineuses (Repas Complet Budget Zéro)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_fermente -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_fermente">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de mil fermentée 48h diluée dans l&apos;eau fraîche, assaisonnée en salé ou sucré, servie fraîche ou légèrement réchauffée avec lait fermenté et arachides.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Mil Fermenté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_grille_des_nomades_peul -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_mil_grille_des_nomades_peul">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Torréfaction de la farine si besoin (8 min), préparation express de la soupe (eau chaude, sucre, sel), finition au lait fermenté</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">10</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Mil Grillé des Nomades Peul</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_moringa_aux_epices -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_moringa_aux_epices">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Viande ou poisson fumé mijoté dans une base tomate-oignon-soumbala, feuilles de moringa ajoutées en toute fin de cuisson (5 minutes) pour préserver leurs vitamines.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Moringa aux Épices</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_nere_fermente_du_centre_nord -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_nere_fermente_du_centre_nord">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation des graines fermentées (cuisson 1h, fermentation 3-5j, pilonnage), base aromatique 8 min, cuisson de la soupe au néré 20 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">28</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Néré Fermenté du Centre-Nord</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_pates_maison_pour_ecoliers -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_pates_maison_pour_ecoliers">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon et ail revenus, tomate et carotte ajoutées, bouillon versé, pâtes cuites dedans, courgette ajoutée 3 min avant la fin.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Pâtes Maison pour Écoliers</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_pattes_de_b_uf -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_pattes_de_b_uf">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pattes de bœuf nettoyées et bouillies au moins 6 heures, puis cuites 20 minutes avec oignons, tomates et soumbala écrasé. Se sert avec du pain.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">380</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de pattes de bœuf</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_poisson_a_la_burkinabe -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_poisson_a_la_burkinabe">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poisson saisi à l&apos;huile puis retiré. Base aromatique tomate-oignon-gingembre-soumbala mijotée, poisson remis à cuire doucement, parfumé de céleri et ciboulette en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Poisson à la Burkinabé</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_poulet_fermier_au_citron -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_poulet_fermier_au_citron">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Poulet fermier mariné puis doré, mijoté 35 minutes dans une base tomate-oignon-piment jusqu&apos;à tendreté, parfumé au jus de citron et fines herbes en fin de cuisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Poulet Fermier au Citron</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_recolte_aux_sept_legumes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_recolte_aux_sept_legumes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Base aromatique (oignon, tomates, soumbala, piments 10 min), cuisson ordonnée des sept légumes ajoutés successivement (patate douce+carottes 15 min, courge 10 min, haricots niébé+verts 8 min, gombo 5 min, viande+poisson, moringa 3 min en dernier)</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Récolte aux Sept Légumes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_restes_de_legumes_anti_gaspillage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_restes_de_legumes_anti_gaspillage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon revenu, restes de légumes ajoutés et couverts d&apos;eau, sel et épices ajoutés, cuit 20 min, restes de sauce de la veille incorporés et cuisson 10 min de plus.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Restes de Légumes (Anti-Gaspillage)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_sesame_au_poisson -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_de_sesame_au_poisson">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Griller les graines de sésame à sec puis les piler en pâte. Rincer et émietter le poisson fumé. Faire revenir oignon, tomates, soumbala, piment, cube 8 min. Incorporer la pâte de sésame et l&apos;eau, porter à ébullition. Ajouter le poisson fumé, cuire 15 min à feu doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">23</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe de Sésame au Poisson</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_detox_aux_7_legumes_du_maraichage -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_detox_aux_7_legumes_du_maraichage">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Légumes lavés et coupés, revenus avec oignon et ail, ajoutés progressivement selon dureté (carottes en premier), couverts de bouillon et assaisonnés, cuits 20 min, épinards ajoutés les 2 dernières minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe Detox aux 7 Légumes du Maraîchage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_douce_de_courge_pour_enfants_2_5_ans -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_douce_de_courge_pour_enfants_2_5_ans">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Oignon revenu au beurre de karité, courge et patate douce ajoutées et cuites 20 min, mixées avec lait jusqu&apos;à texture veloutée, assaisonnées de cannelle et gingembre.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe Douce de Courge pour Enfants (2-5 Ans)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_froide_de_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_froide_de_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Piler le soumbala en poudre fine si en bloc. Dissoudre le soumbala dans l&apos;eau froide. Ajouter tomates, oignon, piment, ciboulette et huile de karité. Laisser reposer 5 minutes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">5</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe Froide de Soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_kankankan_soupe_des_rues -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_kankankan_soupe_des_rues">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyer viande et abats au citron. Blanchir 5 min et jeter l&apos;eau. Cuire avec oignons, ail, gingembre, tomates, soumbala, piment, cube, sel 45 min. Ajouter céleri et ciboulette 5 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe Kankankan (Soupe des Rues)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_rigodon_au_poisson_frais_specialite_des_pecheurs_riverains -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_soupe_rigodon_au_poisson_frais_specialite_des_pecheurs_riverains">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Nettoyage express du poisson frais, préparation rapide des aromates, cuisson directe des poissons entiers dans le bouillon 15 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">15</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Soupe Rigodon au Poisson Frais — Spécialité des Pêcheurs Riverains</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_spaghetti_sauce_avocat -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_spaghetti_sauce_avocat">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Spaghettis cuits al dente 6 à 8 minutes; sauce à l&apos;avocat mixée avec ail, oignons verts, citron et huile d&apos;olive, allongée d&apos;eau de cuisson, mélangée aux pâtes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">8</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Spaghetti Sauce Avocat</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_sucrerie_liquide_d_arachide_lait_d_arachide -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_sucrerie_liquide_d_arachide_lait_d_arachide">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Arachides trempées, mixées avec eau, filtrées au tissu fin pour extraire un lait blanc, dilué, sucré et réfrigéré.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Sucrerie Liquide d&apos;Arachide (Lait d&apos;Arachide)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_supreme_de_pintade_au_champagne_de_dolo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_supreme_de_pintade_au_champagne_de_dolo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Suprêmes de pintade cuits côté peau 7-8 min puis côté chair 3 min, reposés 6 min. Sauce déglacée au dolo vieux réduite de 2/3, montée au beurre de karité froid.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Suprême de Pintade au Champagne de Dolo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_taboule_africain_au_fonio_et_herbes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_taboule_africain_au_fonio_et_herbes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Fonio vapeur égrené, mélangé à une forte proportion d&apos;herbes hachées et légumes en dés, arrosé de vinaigrette et réfrigéré 30 min.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Taboulé Africain au Fonio et Herbes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_tajine_de_chevreau_aux_pruneaux_et_amandes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_tajine_de_chevreau_aux_pruneaux_et_amandes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Chevreau doré au beurre karité, mijoté 1h30 à couvert avec oignons, ail, ras-el-hanout et safran, puis 30 min découvert avec pruneaux, amandes et miel pour napper.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">120</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tajine de Chevreau aux Pruneaux et Amandes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_tamarin_frais_jus_de_tamarin -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_tamarin_frais_jus_de_tamarin">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pulpe de tamarin extraite des gousses, malaxée dans l&apos;eau tiède, filtrée puis diluée, sucrée et salée légèrement avant réfrigération.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tamarin Frais (Jus de Tamarin)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_tartare_de_capitaine_marine_aux_agrumes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_tartare_de_capitaine_marine_aux_agrumes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Capitaine froid découpé en dés de 5mm, mariné 3 minutes dans citron et mandarine, assaisonné (huile, échalote, soumbala, fleur de sel, cayenne), dressé au cercle avec avocat.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tartare de Capitaine Mariné aux Agrumes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_tarte_aux_fruits_tropicaux -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_tarte_aux_fruits_tropicaux">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparer une pâte sablée avec farine, sucre, beurre de karité, jaune d&apos;oeuf et eau ; réfrigérer 30 min. Foncer un moule, cuire à blanc (avec des haricots) en marmite couverte 20 min puis 5 min à nu. Préparer une crème pâtissière (lait, jaunes, sucre, fécule, vanille) et laisser refroidir. Étaler la crème froide sur le fond froid, disposer les fruits tropicaux en rosace.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tarte aux Fruits Tropicaux</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_tarte_rustique_tomate_oignon_sans_four -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_tarte_rustique_tomate_oignon_sans_four">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte (farine, sel, beurre de karité, eau) abaissée en rond, garnie d&apos;une compotée d&apos;oignons et tomates, repliée et cuite en poêle couverte 8 min par face à feu doux.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tarte Rustique Tomate-Oignon Sans Four</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_the_a_la_menthe_touareg_3_services -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_the_a_la_menthe_touareg_3_services">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Trois infusions successives de thé vert et menthe avec doses de sucre croissantes, chaque service versé de haut pour créer la mousse ; la cérémonie dure 45 minutes à 1 heure.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Thé à la Menthe Touareg (3 Services)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_the_vert_au_miel_et_cannelle -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_the_vert_au_miel_et_cannelle">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Thé vert et cannelle infusés 3 minutes dans l&apos;eau bouillante, filtrés puis sucrés au miel une fois tièdes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Thé Vert au Miel et Cannelle</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_thiakry_boisson_au_couscous_de_mil_et_yaourt -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_thiakry_boisson_au_couscous_de_mil_et_yaourt">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Couscous de mil fin cuit à la vapeur, refroidi et égrainé, mélangé au yaourt et au lait fermenté avec sucre, vanille et muscade, puis réfrigéré et garni de raisins secs.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Thiakry (Boisson au Couscous de Mil et Yaourt)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_thieboudieune_burkinabe_riz_au_poisson_de_celebration -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_thieboudieune_burkinabe_riz_au_poisson_de_celebration">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Capitaines farcis d&apos;herbes, ail, piment et soumbala, cuits 20 min dans un bouillon de légumes, riz cuit 20 min dans ce même bouillon concentré de poisson, dressage avec poissons et légumes.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">40</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Thiéboudieune Burkinabé (Riz au Poisson de Célébration)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_a_la_sauce_verte -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_a_la_sauce_verte">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de tô préparée avec la farine de maïs, l&apos;eau et le jus de citron, battue jusqu&apos;à consistance homogène. Sauce verte à base de viande, gombo, feuilles de boulvaka, oignon, tomate et soumbala mijotée et servie avec le tô.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">33</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô à la sauce verte</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_blanc_de_mil_pour_ceremonie_ancestrale_tradition_mossi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_blanc_de_mil_pour_ceremonie_ancestrale_tradition_mossi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Sélection et préparation de la farine blanche, pâte de base, cuisson avec révérence, travail du tô blanc 20 min</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">20</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô Blanc de Mil pour Cérémonie Ancestrale — Tradition Mossi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fete_aux_multiples_sauces -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fete_aux_multiples_sauces">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de la bouillie de base, première cuisson (bouillie), incorporation progressive de la farine sèche en pilonnant 15-20 min, test de qualité (dôme lisse, brillant, cassant net)</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Fête aux Multiples Sauces</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fonio_a_la_sauce_oseille -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fonio_a_la_sauce_oseille">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de fonio servi avec une sauce d&apos;oseille séchée mijotée avec du poulet, tomate, oignon, ail et soumbala. Contact: Exprès Service, Mme Dembele Alimata Christine.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de fonio à la sauce oseille</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fonio_leger_des_ceremonies -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fonio_leger_des_ceremonies">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de fonio diluée versée en filet dans l&apos;eau bouillante salée, cuite 3 minutes, puis incorporation de farine sèche restante en pilonnant jusqu&apos;à texture lisse et élastique (10 minutes).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Fonio Léger des Cérémonies</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fonio_sauce_legumes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_fonio_sauce_legumes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de fonio versée dans l&apos;eau bouillante et remuée jusqu&apos;à pâte lisse et légère. Sauce légumes (carotte, haricots verts, tomate, soumbala, poisson fumé) mijotée séparément.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Fonio Sauce Légumes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mais_en_sauce_feuilles_de_baobab -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mais_en_sauce_feuilles_de_baobab">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de maïs préparé comme le tô de mil (pâte versée dans l&apos;eau bouillante, remuée jusqu&apos;à fermeté). Feuilles de baobab réhydratées puis mijotées avec viande, poisson fumé, soumbala et oignon jusqu&apos;à sauce légèrement gluante.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Maïs en Sauce Feuilles de Baobab</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mil_a_la_sauce_gombo_repas_quotidien_classique -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mil_a_la_sauce_gombo_repas_quotidien_classique">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô préparé en délayant la farine de mil dans l&apos;eau froide puis cuisson 20 min en remuant jusqu&apos;à pâte épaisse ; sauce gombo préparée avec oignon, tomates, soumbala, poisson/viande et gombo, cuite 15 min. Servi à la main, accompagné de dolo traditionnel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">35</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Mil à la Sauce Gombo (Repas Quotidien Classique)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mil_a_la_sauce_kari -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mil_a_la_sauce_kari">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de farine de mil entier servi avec une sauce épaisse à base de zamné (lentille locale), poisson séché, poudre de feuilles de baobab séchées, bikalga et soumbala. Contact: Restaurant Lifaza de Gourcy, Mme Sawadogo Fatimath.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de mil à la sauce kari</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mil_en_sauce_gombo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_mil_en_sauce_gombo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de mil versée en filet dans l&apos;eau bouillante et remuée sans arrêt jusqu&apos;à former une boule ferme (tô). Sauce: viande bouillie puis mijotée avec oignon, tomate, gombo, poisson fumé et soumbala jusqu&apos;à liaison. Le tô est formé en boules et trempé dans la sauce gombo chaude.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Mil en Sauce Gombo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_niebe_sauce_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_niebe_sauce_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de niébé (faite maison au besoin) cuite en pâte remuée comme un tô classique, plus souple et crème. Sauce soumbala mijotée avec viande, tomate et oignon.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Niébé Sauce Soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_patate_a_la_sauce_tomate -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_patate_a_la_sauce_tomate">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de patate douce cuite à la vapeur et pilée, servi avec une sauce tomate à la viande, ail et persil. Contact: Mme Tassembedo, Tél 70 73 50 79.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de patate à la sauce tomate</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_sorgho_rouge_des_communautes_rurales_du_sahel -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_sorgho_rouge_des_communautes_rurales_du_sahel">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de la pâte, cuisson de la bouillie rouge 5 min, travail du tô de sorgho rouge en pilonnant 20 min (plus vigoureux que le mil blanc)</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">25</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Sorgho Rouge des Communautés Rurales du Sahel</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_sorgho_rouge_sauce_graine_de_coton -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_sorgho_rouge_sauce_graine_de_coton">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Farine de sorgho délayée, filtrée et décantée au repos minimum 6 heures avant cuisson de la pâte de tô. Sauce préparée avec bikalga bouilli, viande et légumes revenus, jus de bikalga, poudre de graines de coton, soumbala, ail et persil, mijotée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">405</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de sorgho rouge sauce graine de coton</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_sorgho_rouge_sauce_oignons -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_de_sorgho_rouge_sauce_oignons">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô de sorgho rouge préparé par cuisson-remuage classique. Oignons longuement caramélisés à l&apos;huile de karité puis mijotés avec tomate, soumbala, piment et poisson fumé.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô de Sorgho Rouge Sauce Oignons</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_gourounsi_a_la_sauce_voor -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_gourounsi_a_la_sauce_voor">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tô à base de farine de maïs battu en pâte homogène, accompagné d&apos;une sauce Voor mêlant plusieurs feuilles (amarante, cléome, aubergine locale, épinards), du gombo et de la viande ou du poisson. Contact: Mme Bamouni née Bayala Valentine, Tél 70 22 59 00.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : To gourounsi à la sauce Voor</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_to_sagbo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_to_sagbo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de sorgho sont trempés pendant 12 h puis lavés, épierrés et égouttés (le mil n&apos;est pas trempé). Les grains sont finement broyés et la farine obtenue tamisée puis divisée en 2 parts : une grande part (3/4) et une petite part (1/4), délayée dans l&apos;eau pour obtenir du lait de farine. Les pétales d&apos;oseille (Hisbiscus sabdariffa) sont trempés dans l&apos;eau chaude pendant 2 heures puis filtrés ; le filtrat est porté à ébullition et le lait de farine y est ajouté, laissé cuire quelques minutes. La grande part de farine est ajoutée peu à peu en malaxant à la spatule pour obtenir une pâte cuite souple, servie en boules à la louche. Consommé accompagné de sauce (feuilles d&apos;oseille, de corète, d&apos;amarante, d&apos;épinards, gombo) ou délayé dans l&apos;eau, le lait ou le yaourt.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Tô (Sagbo)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_toubani -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_toubani">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont décortiquées puis vannées. Elles sont ensuite finement écrasées pour obtenir une farine. Avec l&apos;eau potassée la farine est humidifiée et malaxée de sorte à avoir une pâte légèrement ferme. Cette pâte est fourrée dans des enveloppes de maïs et le tout est plongé dans de l&apos;eau portée à ébullition. Après quelques minutes, vérifier le degré de cuisson en ouvrant les enveloppes. Le Toubani est prêt lorsqu&apos;il ne colle pas à l&apos;enveloppe de maïs et se détache facilement. Consommé avec de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Toubani</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_truffes_au_chocolat_et_beurre_de_karite -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_truffes_au_chocolat_et_beurre_de_karite">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Ganache de chocolat, crème de coco et miel chauffés, beurre karité incorporé, réfrigérée 3h, façonnée en boules de 15g et roulée dans divers enrobages (cacao, moringa, sésame, gingembre).</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">180</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Truffes au Chocolat et Beurre de Karité</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_veloute_de_courge_au_beurre_de_karite_truffe_africaine -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_veloute_de_courge_au_beurre_de_karite_truffe_africaine">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Courge rôtie avec oignon et ail dans le beurre karité, mixée avec bouillon chaud, passée au tamis, émulsionnée avec crème de coco et beurre karité froid, garnie de truffe et graines caramélisées.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Velouté de Courge au Beurre de Karité Truffe Africaine</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_waasum_sauce_sechee_des_samo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_waasum_sauce_sechee_des_samo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation ultra-fine de tous les ingrédients, cuisson initiale et réduction (20+30 min), séchage au soleil en galettes 2 jours, reconstitution à l&apos;eau chaude</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">50</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Waasum — Sauce Séchée des Samo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_wesla -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_wesla">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil ou de sorgho sont lavés, épierrés puis séchés avant d&apos;être moulus en semoule moyenne. La cuisson peut être faite à la vapeur (semoule malaxée avec un peu d&apos;eau, donnant une pâte friable cuite à l&apos;aide d&apos;un couscoussier) ou par immersion (semoule directement introduite dans une petite quantité d&apos;eau bouillante et laissée cuire quelques minutes). A l&apos;aide d&apos;une spatule la semoule cuite est malaxée. Consommé avec de l&apos;huile, du sel ou du lait, yaourt.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Wesla</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zabi -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zabi">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les graines de niébé sont décortiquées, vannées puis moulues finement. La farine obtenue est tamisée. Les résidus issus du tamisage sont roulés avec un peu d&apos;eau pour faire des grumeaux. La farine fine est ajoutée peu à peu au roulage avec des ajouts d&apos;eau jusqu&apos;à terminer la farine. Des petits grumeaux fermes et consistants sont obtenus à la fin. Ces grumeaux sont mis à sécher. Le Zabi peut être conservé pendant longtemps et consommé peu à peu, au gras ou avec une sauce généralement une sauce de pâte d&apos;arachide.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zabi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zamne_ne_piigri -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zamne_ne_piigri">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Zamnè bouilli, essoré, mélangé à la potasse et monté à la vapeur 30 minutes (Zamnè); farine de petit mil mélangée à la poudre d&apos;arachide, à l&apos;eau, à la potasse, façonnée en boules (Piigri) montées à la vapeur 45 minutes. Se consomme avec de la viande ou du poisson frit, de l&apos;huile et du sel.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">75</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zamnè nè piigri</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zamne_saute -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zamne_saute">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Zamné (lentille locale) bouilli 30 min puis sauté avec viande hachée et oignons revenus à l&apos;huile. Contact: Mme Bationo Rose, Tél 71 66 39 61.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">45</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zamné sauté</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zanguina_boulettes_de_mil_frites_des_bwaba -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zanguina_boulettes_de_mil_frites_des_bwaba">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Préparation de la pâte Bwaba (sucrée-salée-pimentée-soumbala), façonnage des boulettes, friture par fournées de 4-5 pendant 5-6 min</descriptionRecette>
        <rdfs:label xml:lang="fr">Recette : Zanguina — Boulettes de Mil Frites des Bwaba</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zin_biis_riibo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zin_biis_riibo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Salade composée (crudités) de haricot vert blanchi, pomme de terre bouillie, concombre, tomate, poivron et œufs durs, disposés en rosace et accompagnés d&apos;une sauce mayonnaise à l&apos;ail et au persil. Contact: Restaurant Ri-Noodo, Mme Ouedraogo Rasmata.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zin-biis riibo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zinbiiss_samsa_ou_beignet_de_legumes -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zinbiiss_samsa_ou_beignet_de_legumes">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Beignets de légumes (pomme de terre, carotte, courgette, oignon) en boulettes panées à la farine de blé et à l&apos;œuf, frites à l&apos;huile. Contact: Restaurant Grâce divine, Mme Ouedraogo Fatimata.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zinbiiss samsa ou beignet de légumes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zom_koom_sucre_boisson_de_mil_fermente -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zom_koom_sucre_boisson_de_mil_fermente">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Pâte de mil fermentée 4-6 heures, cuite en bouillie légère, puis diluée avec farine crue, sucre et sel, tamisée et réfrigérée.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zom-koom Sucré (Boisson de Mil Fermenté)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zoom_bindga_hara -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zoom_bindga_hara">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Tamarin trempé 2 heures et filtré. Mil bouilli jusqu&apos;à éclatement des grains, essoré, écrasé avec la menthe et délayé dans le jus de tamarin sucré. Se sucre et se sert frais.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">120</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zoom bindga (hara)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zoom_koom -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zoom_koom">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés, épierrés et trempés environ 12 à 16 heures puis finement moulus au mortier pilon ou au moulin ; des épices (gingembre, clou de girofle, anis) peuvent être ajoutées pendant la mouture. La farine humide obtenue est malaxée avec de l&apos;eau puis filtrée à l&apos;aide d&apos;un filtre fin (tamis ou tissu) pour éliminer les résidus. La solution obtenue est le Zoom-koom (eau de farine). De l&apos;eau de tamarin, du sucre ou du miel sont ajoutés à volonté. Consommé sous forme de boisson.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zoom-koom</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#recette_zoom_parga -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#recette_zoom_parga">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Recette"/>
        <descriptionRecette xml:lang="fr">Les grains de mil sont lavés puis épierrés avant d&apos;être séchés. Le sésame est trié pour éliminer les mauvaises graines, puis torréfié. Les grains de mil sont broyés à la pierre en ajoutant peu à peu le sésame, pour obtenir une semoule moyenne. La semoule est malaxée avec un peu de beurre de karité pour la rendre souple ; du sucre peut être ajouté à volonté. L&apos;eau de tamarin est ajoutée à la semoule obtenue. Consommé en buvant le surnageant et en mangeant le dépôt de semoule.</descriptionRecette>
        <dureeRecette rdf:datatype="http://www.w3.org/2001/XMLSchema#int">30</dureeRecette>
        <rdfs:label xml:lang="fr">Recette : Zoom-parga</rdfs:label>
    </owl:NamedIndividual>
    


