        <skos:altLabel xml:lang="fr">Tama</skos:altLabel>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#instr_n_goni -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#instr_n_goni">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Instrument"/>
        <aPourMedia rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#media_n_goni"/>
        <appartientAFamilleInstrumentale rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#familleinstr_cordophone"/>
        <estAssocieARythme rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#rythme_djongo"/>
        <estJouePar rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#ethnie_mandingue_dioula"/>
        <estJouePar rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#ethnie_senoufo"/>
        <estLocaliseDans rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#loc_bobo_dioulasso"/>
