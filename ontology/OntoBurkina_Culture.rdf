                    <rdf:Description rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#Plat"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#Localite"/>
        <rdfs:comment xml:lang="fr">Localite d&apos;origine du plat.</rdfs:comment>
        <rdfs:comment xml:lang="fr">Localite d&apos;origine du plat. Cardinalite : 0..*. Portee egalement par BoissonTraditionnelle, afin qu&apos;une boisson traditionnelle puisse etre documentee independamment d&apos;un plat particulier.</rdfs:comment>
        <rdfs:label xml:lang="fr">estOriginaireDe</rdfs:label>
    </owl:ObjectProperty>
    


