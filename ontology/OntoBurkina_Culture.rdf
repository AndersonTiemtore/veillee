        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Exposition des grains lavés à l&apos;air/au soleil avant la mouture</descriptionTechnique>
        <descriptionTechnique xml:lang="fr">Séchage au soleil du poisson, des feuilles (oseille, baobab) ou des céréales avant conservation ou usage</descriptionTechnique>
        <nomTechnique xml:lang="fr">Séchage</nomTechnique>
        <rdfs:label xml:lang="fr">séchage</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_a_l_air_des_grains -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_a_l_air_des_grains">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Séchage à l&apos;air des grains</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_au_soleil -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_au_soleil">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Technique de conservation des légumes (gombo) ou du poisson par séchage naturel au soleil</descriptionTechnique>
        <nomTechnique xml:lang="fr">Séchage au soleil</nomTechnique>
        <rdfs:label xml:lang="fr">Séchage au soleil</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_au_soleil_conservation -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_au_soleil_conservation">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Séchage au soleil (conservation)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_des_aliments_au_soleil_sahelien -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_des_aliments_au_soleil_sahelien">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Sécher fruits, légumes, viandes, poissons et condiments au soleil intense du Sahel sur nattes surélevées ; technique de conservation la plus ancienne.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Séchage des Aliments au Soleil Sahélien</nomTechnique>
        <rdfs:label xml:lang="fr">Séchage des Aliments au Soleil Sahélien</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_et_conservation_de_sauce_waasum -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_et_conservation_de_sauce_waasum">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Cuisson jusqu&apos;à réduction extrême, étalage en couche fine et séchage au soleil pendant 2 jours pour former des galettes conservables plusieurs semaines, puis reconstitution à l&apos;eau chaude</descriptionTechnique>
        <nomTechnique xml:lang="fr">Séchage et conservation de sauce (Waasum)</nomTechnique>
        <rdfs:label xml:lang="fr">Séchage et conservation de sauce (Waasum)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_et_conservation_du_gombo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_et_conservation_du_gombo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Découper et sécher le gombo au soleil puis le broyer en poudre, épaississant courant des sauces burkinabées.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Séchage et Conservation du Gombo</nomTechnique>
        <rdfs:label xml:lang="fr">Séchage et Conservation du Gombo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_et_poudrage_des_legumes_feuilles -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_et_poudrage_des_legumes_feuilles">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Sécher à l&apos;ombre (jamais au soleil) puis broyer en poudre les feuilles de moringa, manioc, oseille africaine ou baobab pour concentrer les nutriments.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Séchage et Poudrage des Légumes Feuilles</nomTechnique>
        <rdfs:label xml:lang="fr">Séchage et Poudrage des Légumes Feuilles</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_mil -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sechage_mil">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Séchage (mil)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_selection_et_purification_de_la_farine_test_papier_noir -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_selection_et_purification_de_la_farine_test_papier_noir">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">Sélection et purification de la farine (test papier noir</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_stockage_des_tubercules_et_racines -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_stockage_des_tubercules_et_racines">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Sélectionner, sécher légèrement puis stocker igname, manioc et patate douce dans un endroit frais, sombre et ventilé, sur cagettes couvertes de sable sec ou de cendres.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Stockage des Tubercules et Racines</nomTechnique>
        <rdfs:label xml:lang="fr">Stockage des Tubercules et Racines</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_sucrage_au_miel_a_chaud_sans_bouillir -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_sucrage_au_miel_a_chaud_sans_bouillir">
