        <rdfs:label xml:lang="fr">Pilonnage du soumbala au mortier</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_pilonnage_du_to_et_finitions_piler_le_to_chaud -->

