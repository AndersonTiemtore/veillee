    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">SiteTouristique(?s) ^ estAccessibleEnSaisonSeche(?s, true) ^ Saison(?sa) ^ estSaisonSeche(?sa, true) ^ estEnCours(?sa, true) -&gt; estAccessible(?s, true)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
