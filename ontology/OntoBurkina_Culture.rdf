    </rdf:Description>
    <rdf:Description>
        <rdfs:comment xml:lang="fr">Plat(?p) ^ estOriginaireDe(?p, ?l) ^ Localite(?l) ^ aPourIngredient(?p, ?i) ^ estCultiveDans(?i, ?l) -&gt; aPourIngredientLocal(?p, ?i)</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#Imp"/>
        <swrl:body rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
