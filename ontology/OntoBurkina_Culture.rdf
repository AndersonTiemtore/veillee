    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_du_dolo -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_du_dolo">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Faire germer le mil (maltage), brasser en infusion puis faire fermenter avec une levure naturelle issue d&apos;une fournée précédente, pendant 24 à 48 heures.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation du dolo</nomTechnique>
        <rdfs:label xml:lang="fr">Fermentation du dolo</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_du_soumbala -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_du_soumbala">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Les graines marron du néré subissent un long processus de fermentation pour produire le soumbala.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation du soumbala</nomTechnique>
        <rdfs:label xml:lang="fr">Fermentation du soumbala</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_en_saumure -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_en_saumure">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Faire fermenter un légume (tomates vertes) dans l&apos;eau salée pendant environ 48 heures pour développer de l&apos;acidité</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation en saumure</nomTechnique>
        <rdfs:label xml:lang="fr">Fermentation en saumure</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_longue_48h -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_longue_48h">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <rdfs:label xml:lang="fr">fermentation longue (48h)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_naturelle_des_cereales -->

    <owl:NamedIndividual rdf:about="http://www.ibam-ujkz.bf/ontologies/culture#techc_fermentation_naturelle_des_cereales">
        <rdf:type rdf:resource="http://www.ibam-ujkz.bf/ontologies/culture#TechniqueCulinaire"/>
        <descriptionTechnique xml:lang="fr">Laisser tremper et fermenter le mil ou le sorgho environ 48 heures à température ambiante pour obtenir une pâte acidulée utilisée en bouillie ou soupe (ben-saalga).</descriptionTechnique>
        <descriptionTechnique xml:lang="fr">Tremper puis laisser fermenter naturellement le mil, le sorgho ou le maïs dans l&apos;eau (24 à 72h) pour améliorer digestibilité et arômes avant la cuisson des bouillies.</descriptionTechnique>
        <nomTechnique xml:lang="fr">Fermentation naturelle des céréales</nomTechnique>
        <rdfs:label xml:lang="fr">Fermentation naturelle des céréales</rdfs:label>
    </owl:NamedIndividual>
    


