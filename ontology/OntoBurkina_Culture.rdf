        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Nom de l&apos;activite.</rdfs:comment>
        <rdfs:label xml:lang="fr">nomActivite</rdfs:label>
