# rule: contes_ancrage
# stratum: 1
# A story anchored on a site takes place in the site's locality.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?r onto:seDerouleDans ?l . ?r a onto:RecitAncreSurSite }
WHERE { ?r onto:estAncreSur ?s . ?s onto:estSitueDans ?l }
