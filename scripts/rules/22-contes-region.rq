# rule: contes_region
# stratum: 1
# A story is told in the regions of its zone.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?r onto:estRaconteDansRegion ?z }
WHERE { ?r onto:seDerouleDansZone ?z . ?z a onto:Region }
