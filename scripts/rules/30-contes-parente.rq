# rule: contes_parente
# stratum: 1
# Joking-kinship story: involves two "parent" ethnic groups.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?r a onto:RecitDeParentePlaisanterie }
WHERE { ?r onto:provientDeEthnie ?a ; onto:impliqueEthnie ?b . ?a onto:aPourParentePlaisanterie ?b }
