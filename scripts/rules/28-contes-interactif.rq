# rule: contes_interactif
# stratum: 1
# Interactive ("Vivre" mode): a scene offers a choice.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?r a onto:RecitInteractif }
WHERE { ?r onto:aPourVersion ?v . ?v onto:aPourScene ?s . ?s onto:proposeChoix ?c }
