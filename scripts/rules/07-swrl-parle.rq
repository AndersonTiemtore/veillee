# rule: swrl_parle
# stratum: 1
# An ethnic group speaks its mother tongue.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?e onto:parle ?l }
WHERE { ?e a onto:Ethnie ; onto:aPourLangueMaternelle ?l }
