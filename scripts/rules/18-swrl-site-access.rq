# rule: swrl_siteAccess
# stratum: 1
# Site accessible during the current dry season.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?s onto:estAccessible true }
WHERE {
  ?s a onto:SiteTouristique ; onto:estAccessibleEnSaisonSeche true .
  ?sa a onto:Saison ; onto:estSaisonSeche true ; onto:estEnCours true .
}
