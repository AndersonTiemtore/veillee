# rule: swrl_activiteLieu
# stratum: 1
# Activities offered by a site are available in its locality.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?l onto:activiteDisponible ?a }
WHERE { ?s a onto:SiteTouristique ; onto:estSitueDans ?l ; onto:proposeActivite ?a }
