# rule: swrl_ingrLocal
# stratum: 1
# Ingredient grown where the dish originates.
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX onto: <http://www.ibam-ujkz.bf/ontologies/culture#>

INSERT { ?p onto:aPourIngredientLocal ?i }
WHERE {
  ?p a onto:Plat ; onto:estOriginaireDe ?l ; onto:aPourIngredient ?i .
  ?l a onto:Localite .
  ?i onto:estCultiveDans ?l .
}
